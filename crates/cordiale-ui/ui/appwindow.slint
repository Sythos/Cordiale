import { LineEdit, TextEdit, Button, VerticalBox, HorizontalBox, ProgressIndicator, CheckBox, ComboBox, ListView, Palette, ScrollView, Slider } from "std-widgets.slint";

global FontScale {
    in-out property <int> percent: 100;
}

// One joined channel under a network, in the sidebar's expandable list.
struct ChannelEntry {
    network: string,
    channel: string,
    label: string,
    mention-badge: string,
    mentions-description: string,
    unread-count: string,
    unread-description: string,
    failed: bool,
    kicked: bool,
    invited: bool,
    joined: bool,
}

// One open private-conversation window under its network.
struct QueryEntry {
    network: string,
    nick: string,
    label: string,
    mention-badge: string,
    mentions-description: string,
}

// One row of a server reply screen (WHO/WHOIS/WHOWAS/MOTD/ban list/LUSERS).
// `label` is a key translated by `reply-label`, or empty for a plain line;
// `value` is server data shown verbatim.
struct ReplyRow {
    label: string,
    value: string,
    // A mentions-summary message: clicking it opens its window.
    jump: bool,
}

// One DCC file offer Grappa holds until it is accepted or refused; `size`
// is already formatted, `offer-id` is the server's opaque id.
struct DccOfferRow {
    network: string,
    offer-id: string,
    from: string,
    filename: string,
    size: string,
}

// One user mode in the `/umode` view; `settable` modes can be flipped,
// the others are set by the server or services.
struct UmodeToggle {
    letter: string,
    settable: bool,
    active: bool,
}

// One station of the radio screen: Cicchetto's list, then the custom
// ones. `key` is `builtin:<id>` or `custom:<index>`.
struct RadioRow {
    key: string,
    title: string,
    detail: string,
    description: string,
    custom: bool,
}

// One custom station in Settings > Radio; `codec-index` follows the
// form's menu (MP3, Ogg Vorbis, FLAC).
struct CustomRadioRow {
    name: string,
    url: string,
    codec-index: int,
    codec-label: string,
}

// One archived window (`/archive`): `kind` is the wire token (channel or
// query) and `last-activity` an already formatted local time.
struct ArchiveRow {
    target: string,
    kind: string,
    last-activity: string,
}

// One watched nick in Settings > Watch Lists, with its presence token
// (online, offline or unknown).
struct NotifyRow {
    nick: string,
    presence: string,
}

// Per-file upload limits advertised by the server (sizes already
// formatted; `video-seconds` empty when not advertised).
struct UploadLimitsRow {
    host: string,
    image: string,
    video: string,
    video-seconds: string,
    document: string,
    audio: string,
}

// One channel of the directory pane (`/list`), as sent by the server;
// `joined` when that channel's window is joined, so activating the row
// opens it instead of joining again.
struct DirectoryRow {
    name: string,
    users: string,
    topic: string,
    featured: bool,
    joined: bool,
}

// One step of the identity-recovery panel, as raw wire tokens; the visible
// labels are translated by the `recover-*-label` functions below.
struct RecoverStepRow {
    step: string,
    status: string,
    reason: string,
}

// One connected network in the sidebar, with its joined channels and
// whether the channel list under it is currently shown (default: yes).
// One ignore rule (protocol v31): its identity is the pair, so two rows
// may share a mask. `text-pattern` is "" for a plain mask rule.
struct IgnoreRow {
    mask: string,
    text-pattern: string,
}

// One registered passkey in Settings > Security; dates are already
// rendered, `last-used` is "" for one never used.
struct PasskeyRow {
    id: string,
    name: string,
    added: string,
    last-used: string,
}

struct NetworkGroup {
    network: string,
    connection-label: string,
    parked: bool,
    separator-before: bool,
    expanded: bool,
    channels: [ChannelEntry],
    queries: [QueryEntry],
}

// One operator-featured channel on the home page.
struct HomeFeaturedLink {
    name: string,
    description: string,
}

// One attached network on the home page (see `home.rs`): a connected row
// jumps to its `$server` window and can be disconnected; any other state
// gets Reconnect and, for an account, Remove.
struct HomeNetworkRow {
    network: string,
    nick: string,
    state: string,
    connected: bool,
    reason: string,
    error: string,
    reconnecting: bool,
    can-remove: bool,
    can-recover: bool,
    featured: [HomeFeaturedLink],
    featured-error: string,
}

// One color/weight run within a rendered chat line — mIRC control codes
// (see `cordiale_core::formatting`) already parsed out on the Rust side.
// One line of chat; the body is styled text built from its mIRC runs, so
// several colors still wrap as one paragraph.
struct ChatLine {
    // `timestamp`/`nick` are split out from `body` on purpose: lets the
    // markup style the timestamp as muted text and wrap just the nick in
    // its own right-click context-menu area, separate from the body. Empty
    // `nick` (a system/event line has none) means no nick to show.
    timestamp: string,
    timestamp-color: color,
    nick: string,
    nick-prefix: string,
    nick-color: color,
    italic: bool,
    body: styled-text,
    // Raw wire body for Reply; never reconstruct it from styled markup.
    reply-body: string,
    // Mentions the user (own nick or a /hilight pattern), as Cicchetto
    // marks it: the mention background.
    mention: bool,
}

// One row in the admin Sessions list.
struct AdminSessionRow {
    label: string,
    alive: bool,
    session-id: string,
    // An account's session, the only kind that can be terminated.
    is-user: bool,
}

// One row in the admin Users list.
struct AdminUserRow {
    label: string,
    is-admin: bool,
    user-id: string,
}

// One row in the admin Networks list.
struct AdminNetworkRow {
    label: string,
    network-id: string,
    slug: string,
    visitor-enabled: bool,
    // Caps as typed in the editor: "" means unlimited.
    visitor-cap: string,
    user-cap: string,
    ip-cap: string,
}

// One bound (account, network) credential in Admin.
struct AdminCredentialRow {
    label: string,
    user-id: string,
    network-id: string,
    // What the editor starts from.
    nick: string,
    ident: string,
    realname: string,
    sasl-user: string,
}

// One vhost (source address) in Admin, with its two flags.
struct AdminVhostRow {
    label: string,
    vhost-id: string,
    in-pool: bool,
    generally-available: bool,
}

// One vhost grant to an account.
struct AdminGrantRow {
    label: string,
    grant-id: string,
}

// One vhost grant candidate from the admin subject search: an account
// (`kind` "user", no network) or a visitor on one network.
struct AdminSubjectRow {
    kind: string,
    subject-id: string,
    network: string,
    nick: string,
}

// One muted conversation: its label and Grappa's key for it.
struct MutedRow {
    label: string,
    key: string,
}

// One IRC server endpoint of the network being edited in Admin.
struct AdminServerRow {
    label: string,
    server-id: string,
    // What the editor starts from.
    host: string,
    port: string,
    tls: bool,
    enabled: bool,
}

// One curated channel of the network being edited.
struct AdminFeaturedRow {
    label: string,
    featured-id: string,
    enabled: bool,
}

// One per-network session of a visitor: Disconnect while a process backs
// it, Reconnect when none does.
struct AdminVisitorSessionRow {
    label: string,
    session-id: string,
    alive: bool,
}

// One row in the admin Visitors list.
struct AdminVisitorRow {
    label: string,
    visitor-id: string,
}

// One row of the admin Uploads registry (see `admin_uploads.rs`). A
// deleted row stays as audit history and has no Delete.
struct AdminUploadRow {
    id: string,
    name: string,
    slug: string,
    mime: string,
    size: string,
    subject: string,
    expires: string,
    deleted: string,
    live: bool,
}

// One custom command alias — Settings > Aliases (account-scoped).
struct AliasRow {
    command: string,
    expansion: string,
}

// One selectable outgoing address — Settings > Source Address
// (account-scoped; `selected` reflects the last fetched/saved state).
struct VhostOptionRow {
    address: string,
    label: string,
    selected: bool,
}

// One positioned node in the radial `/links` diagram — see
// `cordiale_core::links::radial_layout`, which computes `x`/`y` (already
// offset to the canvas center) in Rust; the graph window only draws them.
struct LinksGraphNode {
    server: string,
    // Plain pixel counts, not `length`: keeps the Rust-side type exactly
    // `i32`, the same int<->i32 mapping already proven by CI elsewhere in
    // this file (`status-network-count` etc.), rather than betting on an
    // unverified `length` binding. `* 1px` below is the documented
    // int-to-length conversion idiom.
    x: int,
    y: int,
}

// One reconstructed `/links` tree row, already indented and formatted in
// Rust (see `cordiale_core::links`) — Slint just displays it verbatim.
struct LinksRow {
    display: string,
}

// One member of the currently-selected channel. `prefix` is the
// highest-ranked mode marker Rust resolved for that member (`@`/`%`/`+`
// or empty for a plain member) — already sorted/deduped there, Slint just
// displays it ahead of the name.
struct MemberRow {
    name: string,
    prefix: string,
    // The theme's op/halfop/voice color for the role marker.
    prefix-color: color,
    // Same hash-derived per-nick color chat lines use (`nick_color` in
    // Rust) — nicknames stay colored everywhere, not just in the chat
    // body.
    color: color,
}

// A thin draggable strip between two side-by-side panels: drag
// horizontally to resize whichever property `target-width` is bound to.
// `moved`'s incremental `target-width + (mouse-x - pressed-x)` (rather
// than recomputing from scratch) is the documented pattern for avoiding a
// binding loop on a self-referential resize (confirmed against a real
// slint-ui/slint issue report before writing this, not guessed).
component ResizeHandle {
    // Not named `min-width`/`max-width`: those are builtin layout
    // properties every element already has (its own size constraints) —
    // redeclaring them is a compile error, and they mean something
    // different anyway (this component's own 6px width is fixed, these
    // bound the *target* panel's width instead).
    in-out property <length> target-width;
    in property <length> target-min-width: 120px;
    in property <length> target-max-width: 420px;

    width: 6px;

    Rectangle {
        width: 2px;
        x: (parent.width - self.width) / 2;
        background: #808080;
    }

    TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                target-width = max(
                    target-min-width,
                    min(target-max-width, target-width + (self.mouse-x - self.pressed-x))
                );
            }
        }
    }
}

// Right-click menu for a nick, usable both in the chat body and the
// member list — the instantiator supplies the label text/styling as
// plain properties rather than nested content (`@children` inside
// `ContextMenuArea` crashed the Slint compiler itself — an internal
// panic, "range end index 1 out of range for slice of length 0", not a
// reported syntax error — so this sticks to a plain `Text` child
// instead, the same uncomplicated shape `ContextMenuArea`'s own docs
// example uses). Item list, gating and wire shapes all confirmed against
// Cicchetto's own source (UserContextMenu.tsx + lib/socket.ts +
// lib/api.ts) before writing this, not guessed: Op/Deop/Voice/Devoice/
// Kick/Ban only make sense (and are only ever enabled) when the viewer
// is a channel op; WHOIS/CTCP/Query need no permission. A local
// `component`, not `export`, the same as `ResizeHandle` — its callbacks
// are plain pass-throughs the instantiator wires to AppWindow's own
// top-level callbacks (Slint has no way for a nested component to reach
// an ancestor's callbacks by name).
component MemberContextMenu {
    in property <string> target-nick;
    in property <bool> is-chat-message: false;
    in property <string> reply-body: "";
    in property <bool> can-moderate;
    in property <string> display-text;
    in property <color> text-color;
    // An optional role marker drawn before the text in its own color.
    in property <string> prefix-text: "";
    in property <color> prefix-color;
    in property <bool> text-bold: false;
    in property <bool> text-italic: false;
    callback mode-action(string, string); // verb, nick
    callback kick(string);
    callback ban(string);
    callback whois(string);
    callback ctcp(string, string); // nick, verb
    callback query(string);
    callback reply(string, string); // nick, raw message body

    ContextMenuArea {
        Menu {
            if is-chat-message : MenuItem {
                title: "↩  " + @tr("Reply");
                enabled: reply-body != "";
                activated => { reply(target-nick, reply-body); }
            }
            MenuItem {
                title: "⬆  " + @tr("Op");
                enabled: can-moderate;
                activated => { mode-action("op", target-nick); }
            }
            MenuItem {
                title: "⬇  " + @tr("Deop");
                enabled: can-moderate;
                activated => { mode-action("deop", target-nick); }
            }
            MenuItem {
                title: "🔊  " + @tr("Voice");
                enabled: can-moderate;
                activated => { mode-action("voice", target-nick); }
            }
            MenuItem {
                title: "🔇  " + @tr("Devoice");
                enabled: can-moderate;
                activated => { mode-action("devoice", target-nick); }
            }
            MenuItem {
                title: "👢  " + @tr("Kick");
                enabled: can-moderate;
                activated => { kick(target-nick); }
            }
            MenuItem {
                title: "⛔  " + @tr("Ban");
                enabled: can-moderate;
                activated => { ban(target-nick); }
            }
            MenuItem {
                title: "🔍  " + @tr("WHOIS");
                activated => { whois(target-nick); }
            }
            Menu {
                title: "📡  " + @tr("CTCP");
                MenuItem { title: "VERSION"; activated => { ctcp(target-nick, "VERSION"); } }
                MenuItem { title: "TIME"; activated => { ctcp(target-nick, "TIME"); } }
                MenuItem { title: "PING"; activated => { ctcp(target-nick, "PING"); } }
                MenuItem { title: "CLIENTINFO"; activated => { ctcp(target-nick, "CLIENTINFO"); } }
                MenuItem { title: "USERINFO"; activated => { ctcp(target-nick, "USERINFO"); } }
                MenuItem { title: "SOURCE"; activated => { ctcp(target-nick, "SOURCE"); } }
            }
            MenuItem {
                title: "💬  " + @tr("Query");
                activated => { query(target-nick); }
            }
        }

        HorizontalLayout {
            if prefix-text != "" : Text {
                text: prefix-text;
                wrap: no-wrap;
                font-weight: text-bold ? 700 : 400;
                font-italic: text-italic;
                color: prefix-color;
            }
            Text {
                text: display-text;
                wrap: no-wrap;
                font-weight: text-bold ? 700 : 400;
                font-italic: text-italic;
                color: text-color;
            }
        }
    }
}

// One color theme in Settings > Themes: its name, author and a strip of
// color swatches (background, text, accent, muted, mention, op, voice and
// the first nick colors), like an irssi theme's color set.
struct ThemeChoiceRow {
    key: string,
    name: string,
    author: string,
    selected: bool,
    // In use at night, when the OS is in dark mode.
    night: bool,
    // A Grappa theme (the built-in copies can't be edited or copied), and
    // whether the account owns it and has published it.
    server: bool,
    mine: bool,
    published: bool,
    swatches: [color],
}

// One of the 27 colors in the theme editor: its wire key, the hex being
// typed, and the last valid color.
struct EditorColor {
    key: string,
    // 0-15 for the nick colors, -1 for the base ones.
    nick-index: int,
    value: string,
    color: color,
    valid: bool,
}

// Icon-only button of the sidebar's top menu. Hovering shows its name in
// Slint's tooltip (an input-transparent popup: it never takes a click);
// keyboard focus is reported through `has-focus` so the sidebar can name
// the focused button under the icons.
component TopMenuButton {
    in property <string> icon;
    in property <string> label;
    in property <bool> dark;
    out property <bool> has-focus: button.has-focus;
    callback clicked();

    button := Button {
        text: root.icon;
        accessible-label: root.label;
        width: 32px;
        height: 32px;
        clicked => { root.clicked(); }

        // Slint's tooltip: an input-transparent popup next to the pointer,
        // so it never takes a click meant for the icons under it.
        Tooltip {
            Rectangle {
                border-radius: 4px;
                border-width: 1px;
                border-color: root.dark ? #5c5c5c : #a0a0a0;
                background: root.dark ? #2b2b2b : #ffffe1;

                HorizontalLayout {
                    padding-top: 3px;
                    padding-bottom: 3px;
                    padding-left: 6px;
                    padding-right: 6px;

                    Text {
                        text: root.label;
                        font-size: 12px * FontScale.percent / 100;
                        color: root.dark ? #f0f0f0 : #1a1a1a;
                    }
                }
            }
        }
    }
}

// One row of the channel directory: name with its featured/joined labels,
// topic under it, user count at the right edge. Click, Enter or Space
// activates it (join, or open when already joined), like Cicchetto.
component DirectoryEntry inherits Rectangle {
    in property <string> name;
    in property <string> topic;
    in property <string> users;
    in property <bool> featured;
    in property <bool> joined;
    in property <bool> dark;
    // Secondary-text color, the window's `palette-muted`.
    in property <color> muted;
    callback activated();

    border-radius: 5px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #8080807f;
    background: touch.has-hover || focus.has-focus ? #80808022 : transparent;
    accessible-role: button;
    accessible-label: joined ? @tr("Open {}", name) : @tr("Join {}", name);
    accessible-description: topic == ""
        ? @tr("{} users", users)
        : @tr("{} users — {}", users, topic);
    accessible-action-default => { activated(); }

    // Under the touch area, and not focused by the click itself: otherwise
    // it takes the first click on a row for focus and only the second one
    // activates.
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.activated();
        }
    }

    HorizontalLayout {
        padding: 6px;
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;

            HorizontalLayout {
                alignment: start;
                spacing: 6px;

                Text {
                    text: root.name;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.featured : Text {
                    text: @tr("featured");
                    font-size: 11px * FontScale.percent / 100;
                    color: root.muted;
                    vertical-alignment: center;
                }
                if root.joined : Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.dark ? #4a7fb0 : #3d7cc9;
                    background: root.dark ? #1f2d3a : #e3f0ff;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: @tr("joined");
                            font-size: 11px * FontScale.percent / 100;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.topic != "" : Text {
                text: root.topic;
                font-size: 12px * FontScale.percent / 100;
                color: root.muted;
                wrap: word-wrap;
            }
        }

        Text {
            text: root.users;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: top;
            min-width: 40px;
        }
    }
}

// Settings/admin navigation entry: a compact, flat row with an icon naming
// the section's purpose, highlighted while its section is open.
component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    min-height: 30px;
    border-radius: 5px;
    border-width: selected ? 1px : 0px;
    border-color: #8080807f;
    background: selected ? #80808040 : (touch.has-hover ? #80808022 : transparent);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: icon;
            width: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: label;
            vertical-alignment: center;
            overflow: elide;
            font-weight: selected ? 600 : 400;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A button only as wide as its label, so a row or column never stretches
// it across the screen.
component CompactButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> a11y-label: "";
    callback clicked();

    horizontal-stretch: 0;

    HorizontalLayout {
        alignment: start;

        Button {
            text: root.text;
            enabled: root.enabled;
            accessible-label: root.a11y-label == "" ? root.text : root.a11y-label;
            clicked => { root.clicked(); }
        }
    }
}

// A bordered settings/admin panel with an icon and a title. `fill` lets a
// panel holding a list take the remaining height.
component SectionCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <bool> fill: false;

    vertical-stretch: fill ? 1 : 0;
    border-width: 1px;
    border-radius: 8px;
    border-color: #8080806a;
    background: #8080800d;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        if title != "" : HorizontalLayout {
            spacing: 8px;

            Text {
                text: icon;
                font-size: 16px * FontScale.percent / 100;
                vertical-alignment: center;
            }
            Text {
                text: title;
                font-size: 16px * FontScale.percent / 100;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }

        @children
    }
}

// The warning for a sign-in that would send credentials over plain http://
// to a host that isn't this device (issue #201). `blocked` also offers the
// confirmation the sign-in buttons wait for.
component CleartextNotice {
    in property <bool> dark;
    in property <bool> server-cleartext;
    in property <bool> origin-cleartext;
    in property <bool> blocked;
    callback confirm();

    VerticalLayout {
        spacing: 8px;

        if root.server-cleartext : Text {
            text: @tr("This server address uses plain http://, so your password and session token cross the network unencrypted and anyone on the way can read them. Use https:// unless you trust the whole network between you and the server.");
            wrap: word-wrap;
            color: root.dark ? #ffb74d : #a05a00;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }
        if root.origin-cleartext : Text {
            text: @tr("This passkey origin uses plain http:// on a host that isn't this device. Use it only if your server is really set up with it.");
            wrap: word-wrap;
            color: root.dark ? #ffb74d : #a05a00;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }
        if root.blocked : CompactButton {
            text: @tr("Send it unencrypted anyway");
            clicked => { root.confirm(); }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <int> font-size-percent: 100;
    callback font-size-changed(int);
    changed font-size-percent => { FontScale.percent = font-size-percent; }
    // Account-wide unread count (Grappa's `badge_count`). It goes in the
    // title, which every taskbar shows, and on Windows also in a taskbar
    // badge; the "Show event badge" preference turns both off.
    in property <int> unread-badge: 0;
    title: pref-show-event-badge && unread-badge > 0 ? "(" + unread-badge + ") Cordiale" : "Cordiale";
    // The same count as a native badge on the Windows taskbar button; 0
    // clears it. Other platforms ignore the callback.
    property <int> taskbar-badge: pref-show-event-badge ? unread-badge : 0;
    callback taskbar-badge-changed(int, string);
    changed taskbar-badge => {
        taskbar-badge-changed(taskbar-badge, @tr("{} unread", taskbar-badge));
    }
    // A color theme (see `palette-active`) paints the window itself and
    // switches the app to a monospace font, irssi-style.
    background: palette-active ? palette-bg : Palette.background;
    default-font-family: palette-active ? palette-font : "";
    default-font-size: 14px * FontScale.percent / 100;
    // Winresource only embeds an icon into the .exe file's own Win32
    // resources (Explorer file icon, Alt-Tab before the window exists).
    // The live window's title-bar corner and running taskbar icon come
    // from the window handle itself, which winit/Slint leaves unset
    // unless this property is set — the two are independent.
    icon: @image-url("../../../resources/branding/cordiale_icona_256.png");
    // Not `width`/`height`: those pin the window to a fixed size the
    // window manager won't let the user resize or maximize past.
    // `preferred-*` only picks the initial size, same window otherwise
    // fully resizable — confirmed against Slint's own Window docs and a
    // maintainer's explanation (slint-ui/slint discussion #2514) before
    // writing this, since it's the opposite of what the property names
    // alone would suggest.
    preferred-width: 900px;
    preferred-height: 600px;

    // Without this, std-widgets (Button/LineEdit/CheckBox/ListView/...)
    // silently follow the OS's own dark/light setting, independent of
    // Cordiale's own `theme` property below — which only drove a handful
    // of hand-rolled Text colors. That split is exactly what made an OS
    // in dark mode show native-dark widget chrome with light-theme text
    // colors on top of it (unreadable). `Palette.color-scheme` isn't a
    // plain bindable property (a `:` binding here is a parse error, since
    // it's a write into an external global rather than this component's
    // own property) — it has to be set imperatively, so Rust invokes this
    // callback right after every `set-theme` call instead.
    callback apply-color-scheme();
    apply-color-scheme() => {
        Palette.color-scheme = theme == "dark" ? ColorScheme.dark : ColorScheme.light;
    }

    // One of "splash", "language", "connect", "connected", "settings" —
    // Slint has no `else`/`else if`: mutually exclusive `if` blocks are
    // the documented pattern for multi-screen navigation.
    in-out property <string> screen: "splash";
    // Leaving the chat for a screen it is expected to come back from
    // destroys the chat pane (see `chat-resume`); the other screens (sign-in,
    // disconnect) start it afresh, and so does coming back with no window
    // selected.
    changed screen => {
        if screen == "connected" {
            if !has-selected-channel {
                chat-resume = false;
            }
        } else {
            chat-resume = screen == "media" || screen == "settings" || screen == "links" || screen == "archive" || screen == "reply" || screen == "umodes" || screen == "radio" || screen == "debug";
        }
    }
    // Set once by Rust before the window is shown: where the splash
    // screen hands off to once its animation finishes ("language" on
    // first launch, "connect" otherwise).
    in property <string> next-screen: "connect";
    // Which Settings section is open; mirrors Cicchetto's own Settings
    // drawer categories (see docs/feature-matrix.md) so the navigation
    // feels familiar to anyone coming from that client.
    in-out property <string> settings-section: "general";
    in property <bool> is-admin: false;

    in-out property <string> server-url: "https://irc.sindro.me";
    changed server-url => { passkey-origin-reload(server-url); }
    // The WebAuthn origin to assert for this server when it isn't the one
    // rebuilt from its URL (issue #163); empty means no override.
    in-out property <string> passkey-origin: "";
    // Set after Settings > Security saved the field; any edit clears it.
    in-out property <bool> passkey-origin-saved: false;
    property <bool> passkey-origin-ok: passkey-origin-valid(passkey-origin);
    // Plain http:// to a host that isn't this device (issue #201). The key
    // names the cleartext origins in use ("" when there are none); a sign-in
    // waits until the user confirmed the current key, and the confirmation
    // lives only in memory, so a changed address asks again.
    pure callback cleartext-key(string, string) -> string; // server URL, passkey origin
    property <string> cleartext-current: cleartext-key(server-url, passkey-origin);
    property <string> cleartext-confirmed: "";
    property <bool> cleartext-blocked: cleartext-current != "" && cleartext-current != cleartext-confirmed;
    in-out property <string> identifier: "";
    in-out property <string> password: "";
    // The code step of a two-factor sign-in (screen "totp").
    in-out property <string> totp-code: "";
    // The account's factor is a passkey and TOTP isn't armed: the step
    // takes only recovery codes.
    in property <bool> totp-recovery-only: false;
    // The security key prompt of the USB backend (issue #161), drawn over
    // whatever screen started a passkey ceremony: `key-prompt-step` is
    // "touch" while the key waits for a touch, "pin" for its PIN, "error"
    // with a retry, "" when hidden; `key-prompt-error` a `key-*` reason and
    // `key-prompt-retries` the PIN attempts left (-1 when unknown).
    in property <string> key-prompt-step: "";
    in property <string> key-prompt-error: "";
    in property <int> key-prompt-retries: -1;
    in-out property <string> key-prompt-pin: "";
    // A passkey can finish this sign-in here (issue #160), and whether the
    // code field is open too (not when a passkey is the only factor).
    in property <bool> totp-passkey-offered: false;
    in property <bool> totp-code-accepted: true;
    // Settings > Security, TOTP (issue #118). `security-totp-state` is ""
    // (loading), `enabled`, `disabled`, `client-token` (a per-client token
    // can't manage second factors), `visitor` (a guest or visitor session has
    // no account, nothing is requested) or `unavailable`; `security-totp-step`
    // is "" , `enroll` (secret shown, waiting for the first code) or
    // `codes` (recovery codes shown once).
    in property <string> security-totp-state: "";
    in property <string> security-totp-step: "";
    in property <string> security-totp-secret: "";
    in property <string> security-totp-uri: "";
    in property <image> security-totp-qr;
    in property <[string]> security-recovery-codes: [];
    in property <string> security-totp-error: "";
    in property <bool> security-totp-busy: false;
    in-out property <string> security-password: "";
    in-out property <string> security-totp-code: "";
    // The sign-in with a share token (screen "share"): the pasted token or link.
    in-out property <string> share-token-input: "";
    // The sign-in with a recovery code (screen "recover"): the code, which is
    // a credential and is emptied as soon as it is sent.
    in-out property <string> recovery-code-input: "";
    // Settings > Security, share this session: the link to open on another
    // device (empty until one is made), its QR code and expiry text, and
    // the reason a link couldn't be made (`client-token`, `incognito`,
    // `throttled` or `failed`).
    in property <string> security-share-link: "";
    in property <image> security-share-qr;
    in property <string> security-share-expires: "";
    in property <string> security-share-error: "";
    in property <bool> security-share-busy: false;
    // Settings > Security, passkeys (issue #147): list and delete only.
    // `security-passkey-state` is "" (loading), `loaded`, `client-token`,
    // `visitor` (as for TOTP) or `unavailable`; `security-passkey-mode` is Grappa's `disabled`,
    // `second_factor` or `passwordless`.
    in property <string> security-passkey-state: "";
    in property <string> security-passkey-mode: "";
    in property <[PasskeyRow]> security-passkeys: [];
    in property <string> security-passkey-error: "";
    in property <bool> security-passkey-busy: false;
    in-out property <string> security-passkey-password: "";
    // This platform can run a passkey ceremony (issue #160): sign-in with a
    // passkey, adding one and changing the mode. The name of the passkey to
    // add, and the recovery codes shown before passwordless is armed.
    in property <bool> passkey-available: false;
    in-out property <string> security-passkey-name: "";
    in property <[string]> security-passwordless-codes: [];
    // Set only when this server/identifier has a non-empty returned bearer
    // in CredentialStore. The button compares both against the editable
    // server and identifier, hiding it as soon as either value changes.
    in property <string> saved-profile-identifier: "";
    in property <string> saved-profile-server-url: "";
    // `status-kind` selects a translated template below; `status-message`
    // is shown verbatim only when `status-kind` is empty (a
    // raw/passthrough message Rust didn't map to a template).
    // `status-network-count`/`status-channel-count`/`status-protocol-version`
    // fill the `{}` placeholders of the templates that need a number.
    in property <string> status-kind: "";
    in property <string> status-message: "";
    // Seconds left before the next reconnect attempt (`reconnecting` and
    // `disconnected`), counted down below; also the wait a `rate-limited`
    // answer asked for.
    in-out property <int> status-retry-secs: 0;
    in property <int> status-network-count: 0;
    in property <int> status-channel-count: 0;
    // Fill the `invite-sent` template (341 RPL_INVITING acknowledgement).
    in property <string> status-invite-peer: "";
    in property <string> status-invite-channel: "";
    in property <string> status-invite-network: "";
    // Fill the `presence-*` templates (for errors, `-nick` holds the
    // rejected targets).
    in property <string> status-presence-nick: "";
    in property <string> status-presence-network: "";
    // Fill the `dcc-accepted`/`dcc-refused`/`dcc-expired` templates.
    in property <string> status-dcc-filename: "";
    in property <string> status-dcc-from: "";
    in property <int> status-protocol-version: 0;
    in property <bool> connecting: false;
    // Base URLs of servers previously connected to successfully — see
    // `docs/feature-matrix.md`: `ServersFile.servers` existed on disk
    // already, nothing populated or showed it until now.
    in property <[string]> known-servers: [];

    // Sidebar model: one entry per connected network, each carrying its own
    // joined-channels list and expand/collapse state (default expanded).
    in property <[NetworkGroup]> network-groups: [];
    // Home page, shown whenever no window is selected (Cicchetto's
    // HomePane). The session line picks its copy by `home-session-kind`
    // (`user`, `visitor-registered`, `visitor-guest`); a registered visitor
    // on a single network is named by `home-named-nick`/`-network`.
    in property <string> home-session-kind: "";
    in property <string> home-named-nick: "";
    in property <string> home-named-network: "";
    in property <[HomeNetworkRow]> home-networks: [];
    in property <[string]> home-available: [];
    in property <string> home-connecting: "";
    in property <string> home-available-error: "";
    in property <string> home-available-error-network: "";
    // The pending confirmation, `disconnect` or `remove`, for
    // `home-confirm-network` ("" when none).
    in-out property <string> home-confirm-kind: "";
    in-out property <string> home-confirm-network: "";
    in property <[ChatLine]> chat-lines: [];
    // Paging back through the open window's history (`?before=`). The
    // chat pane asks for the previous page by itself when the reader
    // scrolls (or pages with PgUp) up to the oldest loaded line; it sets
    // `history-loading` at once, so a burst of scroll events sends one
    // request, and Rust clears it when the page has landed or failed.
    in-out property <bool> history-loading: false;
    in property <bool> history-start-reached: false;
    // Set by Rust with `history-loading` back to false: whether that page
    // request failed. A failed page is retried only once the reader comes
    // back to the top (or presses PgUp), never in a loop.
    in property <bool> history-failed: false;
    callback older-history-requested();
    // A message row of the mentions summary was clicked (its row index).
    callback mention-open-requested(int);
    // The chat pane's scroll position (two-way with the pane) and height,
    // read by Rust to keep the reader's line in place while an older page
    // is prepended, and whether the pane is following the newest line.
    in-out property <length> chat-scroll-y: 0px;
    out property <length> chat-content-height: 0px;
    in-out property <bool> chat-follow-bottom: true;
    // The row a mention jump landed on, tinted for a moment; -1 for none.
    in-out property <int> chat-highlight-row: -1;
    // What lets a chat pane that is torn down and rebuilt (the reader went
    // to the media viewer, Settings...) come back where it was: the number
    // of lines `chat-content-height` was measured for, and the window the
    // saved position belongs to. `chat-resume` is set when the pane is left
    // for one of those screens and consumed by the rebuilt pane; Rust turns
    // the saved position into the line to go back to.
    out property <int> chat-content-rows: 0;
    private property <string> chat-pane-label: "";
    private property <bool> chat-resume: false;
    callback chat-resume-requested() -> bool;
    callback chat-resume-landed();
    // PgUp/PgDown in the compose box page the chat pane: the direction
    // (-1 up, 1 down) and a counter bumped on every press.
    in-out property <int> chat-page-direction: 0;
    in-out property <int> chat-page-seq: 0;
    in-out property <string> compose-text: "";
    // A counter lets the compose field react to every Reply, including
    // repeated replies to the same message from the scrollback's scope.
    private property <int> compose-focus-request: 0;
    in property <string> current-channel-label: "";
    in property <bool> current-server-window: false;
    // RPL_TOPIC-equivalent for the selected channel, shown above the chat
    // list; empty when the server hasn't sent one (falls back to the
    // channel label in the markup below).
    in property <string> current-topic: "";
    // Compact `+nt` snapshot for the selected channel; empty when unknown or
    // when the server confirms there are no channel modes.
    // One-line status above the topic: network + user modes, then the
    // window + channel modes (`Azzurra +Sir · #grappa +rnt`); "" on home.
    in property <string> window-status: "";
    in property <bool> has-selected-channel: false;
    in property <bool> current-query: false;
    // The peer's nick for the open private window — set together with
    // `current-query`, so it's always valid whenever `current-query` is
    // true. Tab-completion's only candidate in a query window.
    in property <string> current-query-peer-nick: "";
    // Away message of the open private window's peer (a standalone 301);
    // `peer-away-message` may be empty when the peer gave no text.
    in property <bool> peer-away-visible: false;
    in property <string> peer-away-peer: "";
    // Why the open channel is inactive: kind "kicked" or "failed" (or ""),
    // who kicked, and the server's reason text.
    in property <string> window-note-kind: "";
    in property <string> window-note-actor: "";
    in property <string> window-note-reason: "";
    in property <string> peer-away-message: "";
    // A DM can be selected before its Phoenix topic joins and history load
    // finish. Keep composition disabled until Rust marks it ready.
    in property <bool> current-query-ready: false;
    // Only show the roster after Grappa confirms this window is joined.
    // Autojoin entries in `/boot` can be known but not currently connected.
    in property <bool> current-window-is-joined: false;
    // Denoise is on for the open channel: its join/part/quit/nick/mode lines
    // are left out of the transcript.
    in property <bool> current-denoise: false;
    // Latest server invitation banner. Receiving an invitation must not
    // select/focus its channel; the Join action is explicit.
    in property <string> window-invite-banner: "";
    in property <string> window-invite-network: "";
    in property <string> window-invite-channel: "";
    in property <string> window-invite-inviter: "";
    // Server-driven identity recovery (`/recover`): the first
    // `recover_progress` opens this panel and later ones update their step
    // in place. It is never opened locally.
    in property <bool> recover-visible: false;
    in property <string> recover-network: "";
    in property <[RecoverStepRow]> recover-steps: [];
    // Held DCC offers; each leaves only when the server resolves it.
    in property <[DccOfferRow]> dcc-offers: [];
    // Latest reply to a command this client issued (requester events). The
    // screen opens only when the reply arrives, like Cicchetto's modals.
    // `reply-kind` is the wire kind (e.g. "who_reply"); the title is
    // composed and translated by `reply-title-text`.
    in property <string> reply-kind: "";
    in property <string> reply-subject: "";
    in property <string> reply-network: "";
    // The WHOIS avatar, once downloaded from Grappa.
    in property <image> reply-avatar;
    in property <bool> reply-avatar-visible: false;
    in property <[ReplyRow]> reply-rows: [];
    // Archive of one network (`/archive`). `archive-confirm-target` is the
    // row awaiting delete confirmation, set and cleared by the screen itself.
    in property <string> archive-network: "";
    in property <[ArchiveRow]> archive-rows: [];
    in property <bool> archive-loaded: false;
    in property <string> archive-error: "";
    in-out property <string> archive-confirm-target: "";
    // Channel directory of one network (`/list`). `directory-status` is the
    // server's snapshot token (fresh/stale/no_results/unknown/loading) and
    // `directory-error` a key translated by `directory-error-text`.
    in property <string> directory-network: "";
    in property <[DirectoryRow]> directory-rows: [];
    in property <string> directory-status: "";
    in property <string> directory-total: "";
    in property <string> directory-captured-at: "";
    in property <string> directory-error: "";
    in property <string> directory-sort: "users";
    in-out property <string> directory-query: "";
    in property <bool> directory-has-more: false;
    in property <bool> directory-refresh-pending: false;
    // The top menu's Admin button exists only for admins, so its focus is
    // mirrored here for the row's focused-name label.
    property <bool> admin-button-focused: false;
    // `reason` of the last failed capture (raw server token), or "".
    in property <string> directory-failed-reason: "";
    // The directory pane replaces the chat while open; the sidebar stays.
    in-out property <bool> directory-open: false;
    // Unix seconds of the listing's capture ("" when none), and its age in
    // seconds (-1 when none), re-derived by `directory-age-tick` so the
    // "N ago" label keeps moving while the pane is open.
    in property <string> directory-captured-epoch: "";
    in-out property <int> directory-age-seconds: -1;
    // Search debounce: typing restarts a short quiet window before the
    // query is sent, so a burst of keystrokes costs one request.
    property <int> directory-search-edits: 0;
    property <int> directory-search-seen: 0;
    property <bool> directory-search-pending: false;
    // Account settings Grappa stores (`/me/settings/*`), edited on
    // Settings > General and kept in sync with its `*_changed` pushes. An
    // empty text means the server's own default; a delay of 0 turns
    // auto-away off.
    in property <bool> personal-prefs-loaded: false;
    in-out property <string> edit-leave-message: "";
    in-out property <string> edit-away-message: "";
    in-out property <string> edit-away-delay: "";
    // Auto-away nick suffix (protocol v32): "" is rename off. Hidden when
    // the server doesn't have the setting.
    in-out property <string> edit-away-nick-suffix: "";
    in property <bool> away-nick-suffix-supported: false;
    in-out property <bool> pref-show-peer-profiles: false;
    callback personal-prefs-save-requested();
    // Per-network DCC auto-accept for peers with an open private window.
    in-out property <bool> pref-dcc-auto-accept: false;
    callback dcc-auto-accept-toggled(bool);
    // Upload limits from `server_settings_changed`, hidden until announced.
    in property <bool> server-upload-limits-known: false;
    in property <UploadLimitsRow> server-upload-limits;
    // "" while running, then "succeeded" or "failed" from `recover_result`.
    in property <string> recover-outcome: "";
    in property <string> recover-outcome-reason: "";
    // Boot snapshot plus live join/part/quit/nick-change updates —
    // doesn't track role (mode) changes yet, see README's Known gaps.
    // Already sorted ops-first by Rust.
    in property <[MemberRow]> channel-members: [];
    // Whether the viewer's own last-known role in the open channel is
    // `@` — gates the Op/Deop/Voice/Devoice/Kick/Ban items in
    // `MemberContextMenu`. Can go stale the same way `channel-members`'
    // prefixes can (see above) since it's read from the same data.
    in property <bool> can-moderate-members: false;

    // User-resizable via the drag handles between the three "connected"
    // screen columns (see `ResizeHandle`) — session-local, not persisted.
    property <length> sidebar-width: 180px;
    property <length> members-width: 160px;
    // Texts measured by the invisible probes below to derive each side
    // column's minimum width: the widest sidebar row label, and a run of
    // average-width characters as long as the average member label.
    in property <string> sidebar-widest-label: "";
    in property <string> members-average-nick: "";
    // The sidebar never gets narrower than its widest row (plus the row
    // indent, the part button and the box padding); the member column never
    // narrower than the average member label or its Actions button.
    property <length> sidebar-min-width: max(120px, sidebar-label-probe.preferred-width + 90px);
    property <length> members-min-width: max(
        actions-probe.preferred-width + 16px,
        members-nick-probe.preferred-width + 40px);

    in-out property <string> theme: "light";
    // Color theme in use (Grappa's gallery or a built-in copy); false is
    // the classic light/dark look.
    in property <bool> palette-active: false;
    in property <color> palette-bg: #000000;
    // The theme's mention color, behind lines that mention the user.
    in property <color> palette-mention: #c0a000;
    in property <color> palette-bg-alt: #000000;
    in property <color> palette-fg: #ffffff;
    in property <color> palette-accent: #ffffff;
    // Secondary text; `push_palette` sets it for classic mode and themes alike.
    in property <color> palette-muted: #666666;
    in property <color> palette-border: #808080;
    in property <string> palette-font: "";
    // The theme's wallpaper, drawn behind every screen while a color theme
    // is in use: full-bleed, or tiled at its own size.
    in property <image> palette-background;
    in property <bool> palette-background-set: false;
    in property <bool> palette-background-tile: false;
    in property <float> palette-background-opacity: 1;
    in property <[ThemeChoiceRow]> theme-choices: [];
    in property <bool> display-prefs-loaded: false;
    in-out property <bool> pref-colored-nicklist: true;
    // `display_prefs.date_format` (protocol v29), by `DateFormat::ALL`
    // index. `pref-date-format-set` is false while the server hasn't sent
    // one and the user hasn't picked one, so a save doesn't invent it.
    in-out property <int> pref-date-format-index: 0;
    in-out property <bool> pref-date-format-set: false;
    // Live examples for the selector, one per format, on today's date.
    in property <[string]> date-format-examples: ["", "", "", ""];
    in-out property <bool> pref-bold-mentions: true;
    in-out property <bool> pref-strip-formatting: false;
    in-out property <bool> pref-show-event-badge: true;
    in-out property <bool> pref-show-bottom-bar: true;
    // Upload preferences (`/me/settings/upload-*`): the lifetime menu
    // index (see `UPLOAD_TTL_CHOICES`) and the ask-before-upload switch.
    in property <bool> upload-prefs-loaded: false;
    in-out property <int> pref-upload-ttl-index: 0;
    in-out property <bool> pref-upload-confirm: false;
    callback upload-prefs-changed();
    // Texts of the native confirmation shown before an upload.
    out property <string> upload-confirm-title: @tr("Upload file");
    out property <string> upload-confirm-text: @tr("Upload this file to the server and post its link in the open window?");
    // Offered when pasting text of several lines into the one-line compose
    // box.
    out property <string> paste-upload-title: @tr("Paste as a file");
    public pure function paste-upload-text(lines: int) -> string {
        return @tr("The clipboard holds {} lines. Upload them as paste.txt and post its link instead of pasting them into one message?", lines);
    }
    // True when the paste went up as a file, so the compose box skips it.
    callback paste-requested() -> bool;

    // Admin — Settings > Admin, only meaningful when `is-admin` (see
    // `docs/protocol-notes.md` §4ter): a deliberately small slice of
    // Grappa's actual `/admin/*` surface, not the full operator console.
    in-out property <string> admin-section: "sessions";
    in property <string> admin-overview-text: "";
    in property <[AdminSessionRow]> admin-sessions: [];
    in property <[AdminUserRow]> admin-users: [];
    in property <[AdminNetworkRow]> admin-networks: [];
    in property <[AdminVisitorRow]> admin-visitors: [];
    in property <[AdminVisitorSessionRow]> admin-visitor-sessions: [];
    // Admin > Uploads: the registry, and the budget once the server has
