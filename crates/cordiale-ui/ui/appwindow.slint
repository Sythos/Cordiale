    // Live admin feed (`grappa:admin:events`), newest first.
    in property <[string]> admin-events: [];
    // Opening Settings > Admin loads the panel and starts the live feed.
    changed settings-section => {
        if settings-section == "admin" {
            admin-refresh-requested();
        }
    }
    in property <bool> admin-loading: false;

    // `/links` network-topology view — see `cordiale_core::links` for the
