import { LineEdit, Button, VerticalBox, HorizontalBox, ProgressIndicator, CheckBox, ListView, Palette } from "std-widgets.slint";

// One joined channel under a network, in the sidebar's expandable list.
struct ChannelEntry {
    network: string,
    channel: string,
    label: string,
    mention-badge: string,
    mentions-description: string,
    unread-count: string,
    unread-description: string,
    failed: bool,
    kicked: bool,
    invited: bool,
    joined: bool,
}

// One open private-conversation window under its network.
struct QueryEntry {
    network: string,
    nick: string,
    label: string,
    mention-badge: string,
    mentions-description: string,
}

// One row of a server reply screen (WHO/WHOIS/WHOWAS/MOTD/ban list/LUSERS).
// `label` is a key translated by `reply-label`, or empty for a plain line;
// `value` is server data shown verbatim.
struct ReplyRow {
    label: string,
    value: string,
}

// One DCC file offer Grappa holds until it is accepted or refused; `size`
// is already formatted, `offer-id` is the server's opaque id.
struct DccOfferRow {
    network: string,
    offer-id: string,
    from: string,
    filename: string,
    size: string,
}

// One archived window (`/archive`): `kind` is the wire token (channel or
// query) and `last-activity` an already formatted local time.
struct ArchiveRow {
    target: string,
    kind: string,
    last-activity: string,
}

// One watched nick in Settings > Watch Lists, with its presence token
// (online, offline or unknown).
struct NotifyRow {
    nick: string,
    presence: string,
}

// Per-file upload limits advertised by the server (sizes already
// formatted; `video-seconds` empty when not advertised).
struct UploadLimitsRow {
    host: string,
    image: string,
    video: string,
    video-seconds: string,
    document: string,
    audio: string,
}

// One channel of the directory screen (`/list`), as sent by the server.
struct DirectoryRow {
    name: string,
    users: string,
    topic: string,
    featured: bool,
}

// One step of the identity-recovery panel, as raw wire tokens; the visible
// labels are translated by the `recover-*-label` functions below.
struct RecoverStepRow {
    step: string,
    status: string,
    reason: string,
}

// One connected network in the sidebar, with its joined channels and
// whether the channel list under it is currently shown (default: yes).
struct NetworkGroup {
    network: string,
    connection-label: string,
    parked: bool,
    separator-before: bool,
    expanded: bool,
    channels: [ChannelEntry],
    queries: [QueryEntry],
}

// One color/weight run within a rendered chat line — mIRC control codes
// (see `cordiale_core::formatting`) already parsed out on the Rust side.
struct MessageSegment {
    text: string,
    has-color: bool,
    color: color,
    bold: bool,
    italic: bool,
}

// One line of chat, already split into mIRC color/weight segments.
struct ChatLine {
    // `timestamp`/`nick` are split out from `segments` on purpose: lets
    // the markup style the timestamp as muted text and wrap just the
    // nick in its own right-click context-menu area, separate from the
    // mIRC body `Text` elements around them. Empty `nick` (a
    // system/event line has none) means no nick to show.
    timestamp: string,
    timestamp-color: color,
    nick: string,
    nick-prefix: string,
    nick-color: color,
    italic: bool,
    segments: [MessageSegment],
}

// One row in the admin Sessions list.
struct AdminSessionRow {
    label: string,
    alive: bool,
    session-id: string,
}

// One row in the admin Users list.
struct AdminUserRow {
    label: string,
    is-admin: bool,
    user-id: string,
}

// One row in the admin Networks list.
struct AdminNetworkRow {
    label: string,
    network-id: string,
}

// One row in the admin Visitors list.
struct AdminVisitorRow {
    label: string,
    visitor-id: string,
}

// One custom command alias — Settings > Aliases (account-scoped).
struct AliasRow {
    command: string,
    expansion: string,
}

// One selectable outgoing address — Settings > Source Address
// (account-scoped; `selected` reflects the last fetched/saved state).
struct VhostOptionRow {
    address: string,
    label: string,
    selected: bool,
}

// One positioned node in the radial `/links` diagram — see
// `cordiale_core::links::radial_layout`, which computes `x`/`y` (already
// offset to the canvas center) in Rust; the graph window only draws them.
struct LinksGraphNode {
    server: string,
    // Plain pixel counts, not `length`: keeps the Rust-side type exactly
    // `i32`, the same int<->i32 mapping already proven by CI elsewhere in
    // this file (`status-network-count` etc.), rather than betting on an
    // unverified `length` binding. `* 1px` below is the documented
    // int-to-length conversion idiom.
    x: int,
    y: int,
}

// One reconstructed `/links` tree row, already indented and formatted in
// Rust (see `cordiale_core::links`) — Slint just displays it verbatim.
struct LinksRow {
    display: string,
}

// One member of the currently-selected channel. `prefix` is the
// highest-ranked mode marker Rust resolved for that member (`@`/`%`/`+`
// or empty for a plain member) — already sorted/deduped there, Slint just
// displays it ahead of the name.
struct MemberRow {
    name: string,
    prefix: string,
    // Same hash-derived per-nick color chat lines use (`nick_color` in
    // Rust) — nicknames stay colored everywhere, not just in the chat
    // body.
    color: color,
}

// A thin draggable strip between two side-by-side panels: drag
// horizontally to resize whichever property `target-width` is bound to.
// `moved`'s incremental `target-width + (mouse-x - pressed-x)` (rather
// than recomputing from scratch) is the documented pattern for avoiding a
// binding loop on a self-referential resize (confirmed against a real
// slint-ui/slint issue report before writing this, not guessed).
component ResizeHandle {
    // Not named `min-width`/`max-width`: those are builtin layout
    // properties every element already has (its own size constraints) —
    // redeclaring them is a compile error, and they mean something
    // different anyway (this component's own 6px width is fixed, these
    // bound the *target* panel's width instead).
    in-out property <length> target-width;
    in property <length> target-min-width: 120px;
    in property <length> target-max-width: 420px;

    width: 6px;

    Rectangle {
        width: 2px;
        x: (parent.width - self.width) / 2;
        background: #808080;
    }

    TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                target-width = max(
                    target-min-width,
                    min(target-max-width, target-width + (self.mouse-x - self.pressed-x))
                );
            }
        }
    }
}

// Right-click menu for a nick, usable both in the chat body and the
// member list — the instantiator supplies the label text/styling as
// plain properties rather than nested content (`@children` inside
// `ContextMenuArea` crashed the Slint compiler itself — an internal
// panic, "range end index 1 out of range for slice of length 0", not a
// reported syntax error — so this sticks to a plain `Text` child
// instead, the same uncomplicated shape `ContextMenuArea`'s own docs
// example uses). Item list, gating and wire shapes all confirmed against
// Cicchetto's own source (UserContextMenu.tsx + lib/socket.ts +
// lib/api.ts) before writing this, not guessed: Op/Deop/Voice/Devoice/
// Kick/Ban only make sense (and are only ever enabled) when the viewer
// is a channel op; WHOIS/CTCP/Query need no permission. A local
// `component`, not `export`, the same as `ResizeHandle` — its callbacks
// are plain pass-throughs the instantiator wires to AppWindow's own
// top-level callbacks (Slint has no way for a nested component to reach
// an ancestor's callbacks by name).
component MemberContextMenu {
    in property <string> target-nick;
    in property <bool> can-moderate;
    in property <string> display-text;
    in property <color> text-color;
    in property <bool> text-bold: false;
    in property <bool> text-italic: false;
    callback mode-action(string, string); // verb, nick
    callback kick(string);
    callback ban(string);
    callback whois(string);
    callback ctcp(string, string); // nick, verb
    callback query(string);

    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Op");
                enabled: can-moderate;
                activated => { mode-action("op", target-nick); }
            }
            MenuItem {
                title: @tr("Deop");
                enabled: can-moderate;
                activated => { mode-action("deop", target-nick); }
            }
            MenuItem {
                title: @tr("Voice");
                enabled: can-moderate;
                activated => { mode-action("voice", target-nick); }
            }
            MenuItem {
                title: @tr("Devoice");
                enabled: can-moderate;
                activated => { mode-action("devoice", target-nick); }
            }
            MenuItem {
                title: @tr("Kick");
                enabled: can-moderate;
                activated => { kick(target-nick); }
            }
            MenuItem {
                title: @tr("Ban");
                enabled: can-moderate;
                activated => { ban(target-nick); }
            }
            MenuItem {
                title: @tr("WHOIS");
                activated => { whois(target-nick); }
            }
            Menu {
                title: @tr("CTCP");
                MenuItem { title: "VERSION"; activated => { ctcp(target-nick, "VERSION"); } }
                MenuItem { title: "TIME"; activated => { ctcp(target-nick, "TIME"); } }
                MenuItem { title: "PING"; activated => { ctcp(target-nick, "PING"); } }
                MenuItem { title: "CLIENTINFO"; activated => { ctcp(target-nick, "CLIENTINFO"); } }
                MenuItem { title: "USERINFO"; activated => { ctcp(target-nick, "USERINFO"); } }
                MenuItem { title: "SOURCE"; activated => { ctcp(target-nick, "SOURCE"); } }
            }
            MenuItem {
                title: @tr("Query");
                activated => { query(target-nick); }
            }
        }

        Text {
            text: display-text;
            wrap: no-wrap;
            font-weight: text-bold ? 700 : 400;
            font-italic: text-italic;
            color: text-color;
        }
    }
}

export component AppWindow inherits Window {
    title: "Cordiale";
    // Winresource only embeds an icon into the .exe file's own Win32
    // resources (Explorer file icon, Alt-Tab before the window exists).
    // The live window's title-bar corner and running taskbar icon come
    // from the window handle itself, which winit/Slint leaves unset
    // unless this property is set — the two are independent.
    icon: @image-url("../../../resources/branding/cordiale_icona.png");
    // Not `width`/`height`: those pin the window to a fixed size the
    // window manager won't let the user resize or maximize past.
    // `preferred-*` only picks the initial size, same window otherwise
    // fully resizable — confirmed against Slint's own Window docs and a
    // maintainer's explanation (slint-ui/slint discussion #2514) before
    // writing this, since it's the opposite of what the property names
    // alone would suggest.
    preferred-width: 900px;
    preferred-height: 600px;

    // Without this, std-widgets (Button/LineEdit/CheckBox/ListView/...)
    // silently follow the OS's own dark/light setting, independent of
    // Cordiale's own `theme` property below — which only drove a handful
    // of hand-rolled Text colors. That split is exactly what made an OS
    // in dark mode show native-dark widget chrome with light-theme text
    // colors on top of it (unreadable). `Palette.color-scheme` isn't a
    // plain bindable property (a `:` binding here is a parse error, since
    // it's a write into an external global rather than this component's
    // own property) — it has to be set imperatively, so Rust invokes this
    // callback right after every `set-theme` call instead.
    callback apply-color-scheme();
    apply-color-scheme() => {
        Palette.color-scheme = theme == "dark" ? ColorScheme.dark : ColorScheme.light;
    }

    // One of "splash", "language", "connect", "connected", "settings" —
    // Slint has no `else`/`else if`: mutually exclusive `if` blocks are
    // the documented pattern for multi-screen navigation.
    in-out property <string> screen: "splash";
    // Set once by Rust before the window is shown: where the splash
    // screen hands off to once its animation finishes ("language" on
    // first launch, "connect" otherwise).
    in property <string> next-screen: "connect";
    // Which Settings section is open; mirrors Cicchetto's own Settings
    // drawer categories (see docs/feature-matrix.md) so the navigation
    // feels familiar to anyone coming from that client.
    in-out property <string> settings-section: "general";
    in property <bool> is-admin: false;

    in-out property <string> server-url: "https://irc.sindro.me";
    in-out property <string> identifier: "";
    in-out property <string> password: "";
    // Set only when this server/identifier has a non-empty returned bearer
    // in CredentialStore. The button compares both against the editable
    // server and identifier, hiding it as soon as either value changes.
    in property <string> saved-profile-identifier: "";
    in property <string> saved-profile-server-url: "";
    // `status-kind` selects a translated template below; `status-message`
    // is shown verbatim only when `status-kind` is empty (a
    // raw/passthrough message Rust didn't map to a template).
    // `status-network-count`/`status-channel-count`/`status-protocol-version`
    // fill the `{}` placeholders of the templates that need a number.
    in property <string> status-kind: "";
    in property <string> status-message: "";
    in property <int> status-network-count: 0;
    in property <int> status-channel-count: 0;
    // Fill the `invite-sent` template (341 RPL_INVITING acknowledgement).
    in property <string> status-invite-peer: "";
    in property <string> status-invite-channel: "";
    in property <string> status-invite-network: "";
    // Fill the `presence-*` templates (for errors, `-nick` holds the
    // rejected targets).
    in property <string> status-presence-nick: "";
    in property <string> status-presence-network: "";
    // Fill the `dcc-accepted`/`dcc-refused`/`dcc-expired` templates.
    in property <string> status-dcc-filename: "";
    in property <string> status-dcc-from: "";
    in property <int> status-protocol-version: 0;
    in property <bool> connecting: false;
    // Base URLs of servers previously connected to successfully — see
    // `docs/feature-matrix.md`: `ServersFile.servers` existed on disk
    // already, nothing populated or showed it until now.
    in property <[string]> known-servers: [];

    // Sidebar model: one entry per connected network, each carrying its own
    // joined-channels list and expand/collapse state (default expanded).
    in property <[NetworkGroup]> network-groups: [];
    in property <[ChatLine]> chat-lines: [];
    in-out property <string> compose-text: "";
    in property <string> current-channel-label: "";
    // RPL_TOPIC-equivalent for the selected channel, shown above the chat
    // list; empty when the server hasn't sent one (falls back to the
    // channel label in the markup below).
    in property <string> current-topic: "";
    // Compact `+nt` snapshot for the selected channel; empty when unknown or
    // when the server confirms there are no channel modes.
    in property <string> current-channel-modes: "";
    in property <bool> has-selected-channel: false;
    in property <bool> current-query: false;
    // Away message of the open private window's peer (a standalone 301);
    // `peer-away-message` may be empty when the peer gave no text.
    in property <bool> peer-away-visible: false;
    in property <string> peer-away-peer: "";
    in property <string> peer-away-message: "";
    // A DM can be selected before its Phoenix topic joins and history load
    // finish. Keep composition disabled until Rust marks it ready.
    in property <bool> current-query-ready: false;
    // Only show the roster after Grappa confirms this window is joined.
    // Autojoin entries in `/boot` can be known but not currently connected.
    in property <bool> current-window-is-joined: false;
    // Latest server invitation banner. Receiving an invitation must not
    // select/focus its channel; the Join action is explicit.
    in property <string> window-invite-banner: "";
    in property <string> window-invite-network: "";
    in property <string> window-invite-channel: "";
    in property <string> window-invite-inviter: "";
    // Server-driven identity recovery (`/recover`): the first
    // `recover_progress` opens this panel and later ones update their step
    // in place. It is never opened locally.
    in property <bool> recover-visible: false;
    in property <string> recover-network: "";
    in property <[RecoverStepRow]> recover-steps: [];
    // Held DCC offers; each leaves only when the server resolves it.
    in property <[DccOfferRow]> dcc-offers: [];
    // Latest reply to a command this client issued (requester events). The
    // screen opens only when the reply arrives, like Cicchetto's modals.
    // `reply-kind` is the wire kind (e.g. "who_reply"); the title is
    // composed and translated by `reply-title-text`.
    in property <string> reply-kind: "";
    in property <string> reply-subject: "";
    in property <string> reply-network: "";
    in property <[ReplyRow]> reply-rows: [];
    // Archive of one network (`/archive`). `archive-confirm-target` is the
    // row awaiting delete confirmation, set and cleared by the screen itself.
    in property <string> archive-network: "";
    in property <[ArchiveRow]> archive-rows: [];
    in property <bool> archive-loaded: false;
    in property <string> archive-error: "";
    in-out property <string> archive-confirm-target: "";
    // Channel directory of one network (`/list`). `directory-status` is the
    // server's snapshot token (fresh/stale/no_results/unknown/loading) and
    // `directory-error` a key translated by `directory-error-text`.
    in property <string> directory-network: "";
    in property <[DirectoryRow]> directory-rows: [];
    in property <string> directory-status: "";
    in property <string> directory-total: "";
    in property <string> directory-captured-at: "";
    in property <string> directory-error: "";
    in property <string> directory-sort: "users";
    in-out property <string> directory-query: "";
    in property <bool> directory-has-more: false;
    in property <bool> directory-refresh-pending: false;
    // `reason` of the last failed capture (raw server token), or "".
    in property <string> directory-failed-reason: "";
    // Server-stored preferences mirrored from `*_changed` pushes: "" until
    // announced, then "default" (null), "off" (0) or a number of seconds.
    in property <string> server-pref-auto-away-debounce: "";
    // Remembered QUIT/PART text: hidden until announced; `-set` is false
    // for `null` (no message, the server uses its own fallback).
    in property <bool> server-pref-leave-message-known: false;
    in property <bool> server-pref-leave-message-set: false;
    in property <string> server-pref-leave-message: "";
    // Auto-away text: hidden until announced; `-set` is false for `null`
    // (the server keeps its own built-in text).
    in property <bool> server-pref-auto-away-reason-known: false;
    in property <bool> server-pref-auto-away-reason-set: false;
    in property <string> server-pref-auto-away-reason: "";
    // Upload limits from `server_settings_changed`, hidden until announced.
    in property <bool> server-upload-limits-known: false;
    in property <UploadLimitsRow> server-upload-limits;
    // "" while running, then "succeeded" or "failed" from `recover_result`.
    in property <string> recover-outcome: "";
    in property <string> recover-outcome-reason: "";
    // Boot snapshot plus live join/part/quit/nick-change updates —
    // doesn't track role (mode) changes yet, see README's Known gaps.
    // Already sorted ops-first by Rust.
    in property <[MemberRow]> channel-members: [];
    // Whether the viewer's own last-known role in the open channel is
    // `@` — gates the Op/Deop/Voice/Devoice/Kick/Ban items in
    // `MemberContextMenu`. Can go stale the same way `channel-members`'
    // prefixes can (see above) since it's read from the same data.
    in property <bool> can-moderate-members: false;

    // User-resizable via the drag handles between the three "connected"
    // screen columns (see `ResizeHandle`) — session-local, not persisted.
    property <length> sidebar-width: 180px;
    property <length> members-width: 160px;
    // Texts measured by the invisible probes below to derive each side
    // column's minimum width: the widest sidebar row label, and a run of
    // average-width characters as long as the average member label.
    in property <string> sidebar-widest-label: "";
    in property <string> members-average-nick: "";
    // The sidebar never gets narrower than its widest row (plus the row
    // indent, the part button and the box padding); the member column never
    // narrower than the average member label or its Actions button.
    property <length> sidebar-min-width: max(120px, sidebar-label-probe.preferred-width + 90px);
    property <length> members-min-width: max(
        actions-probe.preferred-width + 16px,
        members-nick-probe.preferred-width + 40px);

    in-out property <string> theme: "light";
    in property <bool> display-prefs-loaded: false;
    in-out property <bool> pref-colored-nicklist: true;
    in-out property <bool> pref-bold-mentions: true;
    in-out property <bool> pref-strip-formatting: false;
    in-out property <bool> pref-show-event-badge: true;
    in-out property <bool> pref-show-bottom-bar: true;

    // Admin — Settings > Admin, only meaningful when `is-admin` (see
    // `docs/protocol-notes.md` §4ter): a deliberately small slice of
    // Grappa's actual `/admin/*` surface, not the full operator console.
    in-out property <string> admin-section: "sessions";
    in property <string> admin-overview-text: "";
    in property <[AdminSessionRow]> admin-sessions: [];
    in property <[AdminUserRow]> admin-users: [];
    in property <[AdminNetworkRow]> admin-networks: [];
    in property <[AdminVisitorRow]> admin-visitors: [];
    in property <[string]> admin-session-log: [];
    in property <bool> admin-loading: false;

    // `/links` network-topology view — see `cordiale_core::links` for the
    // tree reconstruction that feeds `links-rows`, and the radial layout
    // that feeds `links-graph-*` (read by `on_links_graph_requested` in
    // main.rs to populate a `LinksGraphWindow` on demand).
    in property <[string]> known-networks: [];
    in property <string> links-network-label: "";
    in property <[LinksRow]> links-rows: [];
    in property <string> links-graph-edges-commands: "";
    in property <[LinksGraphNode]> links-graph-nodes: [];

    // Settings > Credits: Cordiale's own info only — deliberately not a
    // list of Grappa/Cicchetto contributors.
    in property <string> credits-copyright-text: "";
    in property <string> app-version: "";

    // Self-service network profile (never admin-only) — see
    // `docs/protocol-notes.md` §4quater. `settings-network` picks which
    // known network the Identity/Ignores/Perform/Notify sections act on.
    in-out property <string> settings-network: "";
    in-out property <string> identity-nick: "";
    in-out property <string> identity-ident: "";
    in-out property <string> identity-realname: "";
    in property <[string]> settings-ignores: [];
    in-out property <string> new-ignore-mask: "";
    in-out property <string> perform-text: "";
    in property <[AliasRow]> settings-aliases: [];
    in-out property <string> new-alias-command: "";
    in-out property <string> new-alias-expansion: "";
    in property <[VhostOptionRow]> settings-vhost-options: [];
    in property <[NotifyRow]> settings-notify-nicks: [];
    in-out property <string> new-notify-nick: "";
    in property <[string]> settings-watch-patterns: [];
    in-out property <string> new-watch-pattern: "";

    callback connect-requested(string, string, string);
    callback saved-profile-connect-requested(string, string);
    callback server-selected(string);
    callback language-selected(string);
    callback disconnect-requested();
    // Deselects the current channel and returns to "connected" without
    // dropping the session — a quick way back to the network overview
    // from Settings/Links, or from a channel back to "nothing open".
    callback home-requested();
    // Context-menu actions on a nick — see `MemberContextMenu`. All are
    // scoped to whatever channel is currently open (`current-channel`
    // isn't exposed to Slint; Rust reads its own copy).
    callback member-mode-action-requested(string, string); // verb, nick
    callback member-kick-requested(string);
    callback member-ban-requested(string);
    callback member-whois-requested(string);
    callback member-ctcp-requested(string, string); // nick, verb
    callback member-query-requested(string);
    callback channel-selected(string, string);
    callback channel-part-requested(string, string);
    callback query-selected(string, string);
    callback window-invite-join-requested(string, string);
    callback kicked-channel-dismiss-requested(string, string);
    callback recover-dismiss-requested();
    callback peer-away-dismiss-requested();
    callback dcc-offer-accept-requested(string, string); // network, offer id
    callback dcc-offer-refuse-requested(string, string); // network, offer id
    callback directory-refresh-requested();
    callback directory-load-more-requested();
    callback directory-sort-requested(string);
    callback directory-search-requested(string);
    callback directory-closed();
    callback archive-delete-requested(string);
    callback archive-closed();
    callback network-toggle-requested(string);
    callback send-chat-message(string);
    callback compose-text-changed(string);
    callback attach-file-requested();
    callback admin-refresh-requested();
    callback admin-disconnect-session(string);
    callback admin-user-toggle-admin(string, bool);
    callback admin-user-delete(string);
    callback admin-visitor-delete(string);
    callback admin-network-reset-circuit(string);
    callback admin-reaper-run();
    callback links-graph-requested();
    callback theme-toggle-requested();
    callback display-prefs-changed();
    callback settings-network-selected(string);
    callback identity-save-requested();
    callback ignore-add-requested(string);
    callback ignore-remove-requested(string);
    callback perform-save-requested(string);
    callback alias-add-requested(string, string);
    callback alias-remove-requested(string);
    callback vhost-toggle-requested(string);
    callback notify-add-requested(string);
    callback notify-remove-requested(string);
    callback watch-pattern-add-requested(string);
    callback watch-pattern-remove-requested(string);

    // Maps a machine-readable `status-kind` (set from Rust, never
    // English text directly) to a translated template — the only way to
    // get Rust-originated dynamic status text through Slint's `@tr()`
    // translation system, since `@tr()` only works on string literals
    // that live in a `.slint` file.
    // Sidebar connection labels arrive from Rust as English keys
    // ("connecting", "reconnecting", "paused", "connection failed").
    function connection-label-text(label: string) -> string {
        if label == "connecting" {
            return @tr("connecting");
        } else if label == "reconnecting" {
            return @tr("reconnecting");
        } else if label == "paused" {
            return @tr("paused");
        } else if label == "connection failed" {
            return @tr("connection failed");
        } else {
            return label;
        }
    }

    function reply-title-text() -> string {
        if reply-kind == "who_reply" {
            return @tr("WHO {} on {}", reply-subject, reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "motd" {
            return @tr("Message of the day on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "info" {
            return @tr("Server information on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "version" {
            return @tr("Server version on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "admin" {
            return @tr("Server administrator on {}", reply-network);
        } else if reply-kind == "whois_bundle" {
            return @tr("WHOIS {} on {}", reply-subject, reply-network);
        } else if reply-kind == "whowas_bundle" {
            return @tr("WHOWAS {} on {}", reply-subject, reply-network);
        } else if reply-kind == "banlist_bundle" {
            return @tr("Mode list {} on {}", reply-subject, reply-network);
        } else if reply-kind == "mentions_bundle" {
            return @tr("Mentions while you were away on {}", reply-network);
        } else if reply-kind == "lusers_bundle" {
            return @tr("Network statistics for {}", reply-network);
        } else {
            return reply-network;
        }
    }

    function reply-label(key: string) -> string {
        if key == "who-empty" {
            return @tr("No users matched.");
        } else if key == "reply-empty" {
            return @tr("The server sent no lines.");
        } else if key == "whois-userhost" {
            return @tr("Address");
        } else if key == "whois-realname" {
            return @tr("Real name");
        } else if key == "whois-server" {
            return @tr("Server");
        } else if key == "whois-account" {
            return @tr("Account");
        } else if key == "whois-channels" {
            return @tr("Channels");
        } else if key == "whois-idle" {
            return @tr("Idle");
        } else if key == "whois-signon" {
            return @tr("Signed on");
        } else if key == "whois-away" {
            return @tr("Away");
        } else if key == "whois-operator" {
            return @tr("IRC operator");
        } else if key == "whois-umodes" {
            return @tr("User modes");
        } else if key == "whois-secure" {
            return @tr("Secure connection");
        } else if key == "whois-certfp" {
            return @tr("Certificate fingerprint");
        } else if key == "whois-actually" {
            return @tr("Actual host");
        } else if key == "whois-registered" {
            return @tr("Registered nick");
        } else if key == "whois-admin" {
            return @tr("Server administrator");
        } else if key == "whois-services-admin" {
            return @tr("Services administrator");
        } else if key == "whois-helper" {
            return @tr("Helper");
        } else if key == "whois-chanop" {
            return @tr("Channel operator");
        } else if key == "whois-agent" {
            return @tr("Agent");
        } else if key == "whois-java" {
            return @tr("Java client");
        } else if key == "whois-avatar" {
            return @tr("Avatar available on the server");
        } else if key == "whowas-logoff" {
            return @tr("Last seen");
        } else if key == "whowas-not-found" {
            return @tr("The server has no history for this nick.");
        } else if key == "banlist-empty" {
            return @tr("The list is empty.");
        } else if key == "mentions-away-period" {
            return @tr("Away");
        } else if key == "mentions-away-reason" {
            return @tr("Away message");
        } else if key == "mentions-empty" {
            return @tr("Nobody mentioned you.");
        } else if key == "lusers-total-users" {
            return @tr("Users");
        } else if key == "lusers-invisible" {
            return @tr("Invisible");
        } else if key == "lusers-servers" {
            return @tr("Servers");
        } else if key == "lusers-operators" {
            return @tr("Operators online");
        } else if key == "lusers-unknown-connections" {
            return @tr("Unknown connections");
        } else if key == "lusers-channels-formed" {
            return @tr("Channels formed");
        } else if key == "lusers-local-clients" {
            return @tr("Clients on this server");
        } else if key == "lusers-local-servers" {
            return @tr("Servers linked to this server");
        } else if key == "lusers-current-local" {
            return @tr("Current local users");
        } else if key == "lusers-max-local" {
            return @tr("Max local users");
        } else if key == "lusers-current-global" {
            return @tr("Current global users");
        } else if key == "lusers-max-global" {
            return @tr("Max global users");
        } else {
            return key;
        }
    }

    function recover-step-label(step: string) -> string {
        if step == "identify" {
            return @tr("Identify with services");
        } else if step == "register" {
            return @tr("Confirm registration");
        } else if step == "nick" {
            return @tr("Switch nick");
        } else if step == "recover" {
            return @tr("Recover the nick");
        } else if step == "release" {
            return @tr("Release the nick");
        } else {
            return step;
        }
    }

    function recover-status-label(status: string) -> string {
        if status == "running" {
            return @tr("in progress");
        } else if status == "ok" {
            return @tr("done");
        } else if status == "failed" {
            return @tr("failed");
        } else {
            return status;
        }
    }

    // Grappa's four known reasons are localized; any additive future reason
    // is shown verbatim rather than dropped.
    function recover-reason-label(reason: string) -> string {
        if reason == "wrong_password" {
            return @tr("wrong password");
        } else if reason == "nick_unavailable" {
            return @tr("nick unavailable");
        } else if reason == "services_declined" {
            return @tr("services declined");
        } else if reason == "identify_unconfirmed" {
            return @tr("identification not confirmed");
        } else {
            return reason;
        }
    }

    function directory-status-text() -> string {
        if directory-status == "fresh" || directory-status == "stale" {
            return directory-status == "fresh"
                ? @tr("{} channels, listed {}.", directory-total, directory-captured-at)
                : @tr("{} channels, listed {} (may be out of date).", directory-total, directory-captured-at);
        } else if directory-status == "no_results" {
            return @tr("The server listed no channels.");
        } else if directory-status == "loading" {
            return @tr("Listing channels…");
        } else if directory-status == "unknown" {
            return @tr("No channel list yet.");
        } else {
            return "";
        }
    }

    function archive-error-text() -> string {
        if archive-error == "archive-rate-limited" {
            return @tr("Too many archive requests. Wait a moment and try again.");
        } else if archive-error == "archive-fetch-failed" {
            return @tr("Couldn't load the archive.");
        } else if archive-error == "archive-delete-failed" {
            return @tr("Couldn't delete that history.");
        } else {
            return archive-error;
        }
    }

    function directory-error-text() -> string {
        if directory-error == "directory-fetch-failed" {
            return @tr("Couldn't load the channel list.");
        } else if directory-error == "directory-refresh-failed" {
            return @tr("Couldn't refresh the channel list. Is the network connected?");
        } else {
            return directory-error;
        }
    }

    function status-text() -> string {
        if status-kind == "signed-in" {
            return @tr("Signed in. {} network(s), {} channel(s).", status-network-count, status-channel-count);
        } else if status-kind == "wrong-credentials" {
            return @tr("Wrong username or password/token.");
        } else if status-kind == "reauthentication-required" {
            return @tr("Saved sign-in is unavailable. Enter your password or client token to sign in again.");
        } else if status-kind == "command-usage" {
            return @tr("That command is missing an argument, for example: /whowas <nick>.");
        } else if status-kind == "session-severed-flood" {
            return @tr("You were signed out because this client sent too many requests. Your IRC session is still running; sign in again to continue.");
        } else if status-kind == "two-factor-required" {
            return @tr("This account has two-factor authentication enabled. Sign in from a browser instead.");
        } else if status-kind == "too-many-attempts" {
            return @tr("Too many attempts. Wait a bit before trying again.");
        } else if status-kind == "login-failed" {
            return @tr("Login failed.");
        } else if status-kind == "boot-me-failed" {
            return @tr("Signed in, but couldn't load account data.");
        } else if status-kind == "unreachable" {
            return @tr("Couldn't reach the server. Check the URL and try again.");
        } else if status-kind == "protocol-too-old" {
            return @tr("This server's protocol version ({}) is too old for Cordiale.", status-protocol-version);
        } else if status-kind == "send-failed" {
            return @tr("Couldn't send that message.");
        } else if status-kind == "part-failed" {
            return @tr("Couldn't leave the channel. Please try again.");
        } else if status-kind == "disconnected" {
            return status-message == "" ? @tr("Disconnected. Reconnecting…") : @tr("Disconnected. Reconnecting… ({})", status-message);
        } else if status-kind == "reconnecting" {
            return status-message == "" ? @tr("Reconnecting…") : @tr("Reconnecting… ({})", status-message);
        } else if status-kind == "presence-online" {
            return @tr("{} is now online on {}.", status-presence-nick, status-presence-network);
        } else if status-kind == "presence-offline" {
            return @tr("{} went offline on {}.", status-presence-nick, status-presence-network);
        } else if status-kind == "presence-list-full" {
            return @tr("The watch list on {} is full; not watched: {}.", status-presence-network, status-presence-nick);
        } else if status-kind == "presence-rejected" {
            return @tr("The server on {} refused to watch: {}.", status-presence-network, status-presence-nick);
        } else if status-kind == "dcc-accepted" {
            return @tr("Accepted {} from {}; the transfer runs on the server.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-refused" {
            return @tr("Refused {} from {}.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-expired" {
            return @tr("The offer of {} from {} expired.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-offer-gone" {
            return @tr("That file offer is no longer available.");
        } else if status-kind == "dcc-rate-limited" {
            return @tr("Daily file transfer limit reached. Try again later.");
        } else if status-kind == "dcc-not-connected" {
            return @tr("That network isn't connected, so the file offer can't be answered.");
        } else if status-kind == "dcc-no-space" {
            return @tr("The server has no room left for this file.");
        } else if status-kind == "dcc-action-failed" {
            return @tr("Couldn't answer the file offer.");
        } else if status-kind == "no-mentions" {
            return @tr("No away summary for this network yet.");
        } else if status-kind == "invite-sent" {
            return @tr("Invited {} to {} on {}.", status-invite-peer, status-invite-channel, status-invite-network);
        } else if status-kind == "attach-unsupported" {
            return @tr("Attachments aren't supported yet.");
        } else {
            return status-message;
        }
    }

    // Invisible measuring probes for the side columns' minimum widths.
    sidebar-label-probe := Button {
        text: sidebar-widest-label;
        visible: false;
        enabled: false;
    }
    members-nick-probe := Text {
        text: members-average-nick;
        visible: false;
    }
    actions-probe := Button {
        text: "☰ " + @tr("Actions") + " ▾";
        visible: false;
        enabled: false;
    }

    if screen == "splash" : VerticalBox {
        padding: 32px;
        spacing: 24px;
        alignment: center;

        property <float> splash-progress: 0;
        animate splash-progress {
            duration: 1800ms;
            easing: ease-out;
        }

        init => {
            splash-progress = 1.0;
        }

        Timer {
            interval: 1900ms;
            running: true;
            triggered => {
                screen = next-screen;
            }
        }

        Image {
            source: @image-url("../../../resources/branding/cordiale.png");
            image-fit: contain;
            height: 220px;
        }

        ProgressIndicator {
            progress: splash-progress;
        }
    }

    if screen == "language" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: @tr("Choose your language");
            font-size: 22px;
            horizontal-alignment: center;
        }

        // Language names are shown in their own language regardless of
        // the current UI language (so a French speaker can still find
        // "Français" even if the UI is currently in English) — never
        // wrapped in @tr().
        Button {
            text: "English";
            clicked => { language-selected("en"); }
        }
        Button {
            text: "Italiano";
            clicked => { language-selected("it"); }
        }
        Button {
            text: "Français";
            clicked => { language-selected("fr"); }
        }
        Button {
            text: "Deutsch";
            clicked => { language-selected("de"); }
        }
        Button {
            text: "Español";
            clicked => { language-selected("es"); }
        }
    }

    if screen == "connect" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px;
            horizontal-alignment: center;
        }

        LineEdit {
            placeholder-text: @tr("Server URL");
            accessible-label: @tr("Server URL");
            text <=> server-url;
        }

        LineEdit {
            placeholder-text: @tr("Username");
            accessible-label: @tr("Username");
            text <=> identifier;
        }

        LineEdit {
            placeholder-text: @tr("Password or client token");
            accessible-label: @tr("Password or client token");
            text <=> password;
            // Qualified as `InputType.password`, not bare `password`: this
            // component also has a property named `password` (the text
            // itself), which would otherwise shadow the enum variant.
            input-type: InputType.password;
        }

        Button {
            text: connecting ? @tr("Connecting…") : @tr("Connect");
            enabled: !connecting;
            clicked => { connect-requested(server-url, identifier, password); }
        }

        if saved-profile-identifier != "" && saved-profile-identifier == identifier && saved-profile-server-url == server-url : Button {
            text: @tr("Sign in with saved profile");
            enabled: !connecting;
            clicked => { saved-profile-connect-requested(server-url, identifier); }
        }

        Button {
            text: @tr("Change language");
            clicked => { screen = "language"; }
        }

        Text {
            text: status-text();
            color: #cc3333;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if known-servers.length > 0 : VerticalBox {
            padding-top: 8px;
            spacing: 4px;

            Text {
                text: @tr("Previously used servers");
                font-size: 14px;
            }

            for known in known-servers : Button {
                text: known;
                accessible-label: @tr("Switch to server {}", known);
                clicked => { server-selected(known); }
            }
        }
    }

    if screen == "connected" : HorizontalBox {
        padding: 16px;
        spacing: 8px;

        VerticalBox {
            width: max(sidebar-width, sidebar-min-width);
            spacing: 8px;

            HorizontalLayout {
                alignment: start;
                spacing: 4px;

                Button {
                    text: "🏠";
                    accessible-label: @tr("Home");
                    width: 32px;
                    height: 32px;
                    clicked => { home-requested(); }
                }

                if is-admin : Button {
                    text: "🛡";
                    accessible-label: @tr("Admin");
                    width: 32px;
                    height: 32px;
                    clicked => {
                        screen = "settings";
                        settings-section = "admin";
                    }
                }

                Button {
                    text: "⚙";
                    accessible-label: @tr("Settings");
                    width: 32px;
                    height: 32px;
                    clicked => { screen = "settings"; }
                }

                // Signing out is how the user switches accounts: it also
                // turns off the automatic sign-in at the next launch.
                Button {
                    text: "⏏";
                    accessible-label: @tr("Disconnect");
                    width: 32px;
                    height: 32px;
                    clicked => { disconnect-requested(); }
                }
            }

            // Once actually signed in, this row of icons is the whole
            // story — the connecting/error/reconnecting text below only
            // shows while there's something to report, so a healthy
            // session doesn't sit under a permanent status paragraph.
            if status-kind != "signed-in" : Text {
                text: @tr("Connected to {}", server-url);
                wrap: word-wrap;
            }

            if status-kind != "signed-in" : Text {
                text: status-text();
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
                accessible-live-region: AccessibleLiveness.polite;
            }

            if window-invite-banner != "" : Rectangle {
                background: theme == "dark" ? #3a321f : #fff2bf;
                border-width: 1px;
                border-color: theme == "dark" ? #c99b2e : #b58a00;
                padding: 6px;
                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: window-invite-banner;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Join");
                        accessible-label: @tr("Join invited channel");
                        clicked => {
                            window-invite-join-requested(window-invite-network, window-invite-channel);
                        }
                    }
                }
            }

            if recover-visible : Rectangle {
                background: theme == "dark" ? #1f2d3a : #e3f0ff;
                border-width: 1px;
                border-color: theme == "dark" ? #4a7fb0 : #3d7cc9;
                padding: 6px;
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: @tr("Identity recovery on {}", recover-network);
                        wrap: word-wrap;
                        font-weight: 700;
                        accessible-role: AccessibleRole.text;
                    }
                    for row in recover-steps : Text {
                        text: row.reason == ""
                            ? @tr("{}: {}", recover-step-label(row.step), recover-status-label(row.status))
                            : @tr("{}: {} ({})", recover-step-label(row.step), recover-status-label(row.status), recover-reason-label(row.reason));
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    if recover-outcome != "" : Text {
                        text: recover-outcome == "succeeded"
                            ? @tr("Identity recovered.")
                            : (recover-outcome-reason == ""
                                ? @tr("Recovery failed.")
                                : @tr("Recovery failed ({}).", recover-reason-label(recover-outcome-reason)));
                        wrap: word-wrap;
                        font-weight: 700;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Dismiss");
                        accessible-label: @tr("Dismiss identity recovery");
                        clicked => { recover-dismiss-requested(); }
                    }
                }
            }

            for offer in dcc-offers : Rectangle {
                background: theme == "dark" ? #2a2438 : #f0eaff;
                border-width: 1px;
                border-color: theme == "dark" ? #8a74c9 : #6b4fc0;
                padding: 6px;
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: @tr("{} offers {} ({}) on {}", offer.from, offer.filename, offer.size, offer.network);
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    HorizontalBox {
                        spacing: 4px;
                        padding: 0px;
                        Button {
                            text: @tr("Accept");
                            accessible-label: @tr("Accept {} from {}", offer.filename, offer.from);
                            clicked => { dcc-offer-accept-requested(offer.network, offer.offer-id); }
                        }
                        Button {
                            text: @tr("Refuse");
                            accessible-label: @tr("Refuse {} from {}", offer.filename, offer.from);
                            clicked => { dcc-offer-refuse-requested(offer.network, offer.offer-id); }
                        }
                    }
                }
            }

            ListView {
                vertical-stretch: 1;

                for group in network-groups : VerticalLayout {
                    alignment: start;
                    spacing: 0px;
                    padding-top: group.separator-before ? 8px : 0px;

                    if group.separator-before : Rectangle {
                        height: 1px;
                        horizontal-stretch: 1;
                        background: #808080;
                    }

                    if !group.parked : Button {
                        text: (group.expanded ? "▾ 🔌 " : "▸ 🔌 ") + group.network
                            + (group.connection-label == "" ? "" : " · " + connection-label-text(group.connection-label));
                        accessible-label: group.network
                            + (group.connection-label == "" ? "" : " — " + connection-label-text(group.connection-label));
                        clicked => { network-toggle-requested(group.network); }
                    }
                    if group.parked : HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: group.expanded ? "▾" : "▸";
                            width: 28px;
                            accessible-label: @tr("Expand or collapse parked network {}", group.network);
                            clicked => { network-toggle-requested(group.network); }
                        }
                        Text {
                            text: @tr("{} [PARKED]", group.network);
                            font-italic: true;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                        }
                    }

                    // Channel and query rows sit directly under their
                    // network row, with no gap between them.
                    if group.expanded : VerticalLayout {
                        alignment: start;
                        padding-left: 16px;
                        spacing: 0px;

                        for entry in group.channels : HorizontalLayout {
                            spacing: 4px;

                            Button {
                                horizontal-stretch: 1;
                                text: (entry.invited ? "🔔 " : "") + entry.label + entry.mention-badge;
                                accessible-label: entry.label + entry.mentions-description
                                    + (entry.invited
                                        ? " — invited"
                                        : (entry.kicked
                                            ? " — kicked"
                                            : (entry.failed ? " — join failed" : "")));
                                // Cicchetto keeps failed and kicked channels as
                                // muted, selectable pseudo-windows; details
                                // remain in session state, not in the row.
                                opacity: (entry.failed || entry.kicked) ? 0.55 : 1.0;
                                clicked => { channel-selected(entry.network, entry.channel); }
                            }

                            if entry.unread-description != "" : Text {
                                text: entry.unread-count;
                                accessible-label: entry.unread-description;
                                accessible-role: AccessibleRole.text;
                                horizontal-alignment: right;
                                min-width: 28px;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            if entry.kicked : Button {
                                text: "×";
                                accessible-label: @tr("Dismiss kicked channel {}", entry.label);
                                width: 28px;
                                clicked => {
                                    kicked-channel-dismiss-requested(entry.network, entry.channel);
                                }
                            }
                            if entry.joined : Button {
                                text: "×";
                                accessible-label: @tr("Leave channel {} on {}", entry.channel, entry.network);
                                width: 28px;
                                clicked => { channel-part-requested(entry.network, entry.channel); }
                            }
                        }

                        for query in group.queries : Button {
                            horizontal-stretch: 1;
                            text: "↳ " + query.label + query.mention-badge;
                            accessible-label: @tr("Private conversation with {} on {}", query.nick, query.network)
                                + query.mentions-description;
                            clicked => { query-selected(query.network, query.nick); }
                        }
                    }
                }
            }
        }

        ResizeHandle {
            target-width <=> sidebar-width;
            target-min-width: sidebar-min-width;
            target-max-width: max(360px, sidebar-min-width);
        }

        VerticalBox {
            spacing: 8px;

            Text {
                text: current-channel-label;
                font-size: 14px;
                font-weight: 700;
            }
            if has-selected-channel && !current-query : Rectangle {
                height: 60px;
                background: theme == "dark" ? #242424 : #f5f5f5;
                border-width: 1px;
                border-color: theme == "dark" ? #5c5c5c : #d0d0d0;
                padding: 3px;
                Text {
                    text: current-topic == "" ? @tr("No topic set") : current-topic;
                    font-size: 14px;
                    wrap: word-wrap;
                    max-height: 54px;
                    vertical-alignment: top;
                }
            }
            if current-channel-modes != "" : Text {
                text: current-channel-modes;
                font-size: 12px;
            }
            if current-query && peer-away-visible : Rectangle {
                background: theme == "dark" ? #3a321f : #fff2bf;
                border-width: 1px;
                border-color: theme == "dark" ? #c99b2e : #b58a00;
                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: peer-away-message == ""
                            ? @tr("{} is away.", peer-away-peer)
                            : @tr("{} is away: {}", peer-away-peer, peer-away-message);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Dismiss");
                        accessible-label: @tr("Dismiss away message");
                        clicked => { peer-away-dismiss-requested(); }
                    }
                }
            }

            ListView {
                vertical-stretch: 1;

                for line in chat-lines : HorizontalLayout {
                    alignment: start;
                    spacing: 0px;

                    Text {
                        text: "[" + line.timestamp + "] ";
                        color: line.timestamp-color;
                        font-italic: line.italic;
                    }

                    if line.nick != "" : MemberContextMenu {
                        target-nick: line.nick;
                        can-moderate: can-moderate-members;
                        display-text: "<" + line.nick-prefix + line.nick + "> ";
                        text-color: line.nick-color;
                        text-bold: true;
                        text-italic: line.italic;
                        mode-action(verb, nick) => { member-mode-action-requested(verb, nick); }
                        kick(nick) => { member-kick-requested(nick); }
                        ban(nick) => { member-ban-requested(nick); }
                        whois(nick) => { member-whois-requested(nick); }
                        ctcp(nick, verb) => { member-ctcp-requested(nick, verb); }
                        query(nick) => { member-query-requested(nick); }
                    }

                    for segment in line.segments : Text {
                        text: segment.text;
                        wrap: word-wrap;
                        font-weight: segment.bold ? 700 : 400;
                        font-italic: segment.italic;
                        color: segment.has-color
                            ? segment.color
                            : (theme == "dark" ? white : black);
                    }
                }
            }

            // Small compose bar, never more than one line tall: paperclip
            // to attach a file (left, like Cicchetto), text field, send
            // icon (right).
            HorizontalBox {
                height: 40px;
                spacing: 6px;

                Button {
                    text: "📎";
                    accessible-label: @tr("Attach file");
                    width: 36px;
                    enabled: !current-query || current-query-ready;
                    clicked => { attach-file-requested(); }
                }

                LineEdit {
                    placeholder-text: @tr("Message");
                    accessible-label: @tr("Message");
                    text <=> compose-text;
                    enabled: !current-query || current-query-ready;
                    accepted => { send-chat-message(compose-text); }
                    edited(new-text) => { compose-text-changed(new-text); }
                }

                Button {
                    text: "➤";
                    accessible-label: @tr("Send");
                    width: 36px;
                    enabled: current-query ? current-query-ready : has-selected-channel;
                    clicked => { send-chat-message(compose-text); }
                }
            }
        }

        // Always present on the "connected" screen, not just once a
        // channel is open: the "actions" row at its bottom (global nav,
        // not per-member) doesn't depend on a channel selection at all,
        // and hiding the whole column also hid it.
        ResizeHandle {
            target-width <=> members-width;
            target-min-width: members-min-width;
            target-max-width: max(320px, members-min-width);
        }

        VerticalBox {
            width: max(members-width, members-min-width);
            spacing: 4px;

            if current-window-is-joined && !current-query : Text {
                text: @tr("Members ({})", channel-members.length);
                font-size: 14px;
            }

            if current-window-is-joined && !current-query : ListView {
                vertical-stretch: 1;

                for member in channel-members : MemberContextMenu {
                    target-nick: member.name;
                    can-moderate: can-moderate-members;
                    display-text: member.prefix == "" ? member.name : "[" + member.prefix + "] " + member.name;
                    text-color: member.color;
                    mode-action(verb, nick) => { member-mode-action-requested(verb, nick); }
                    kick(nick) => { member-kick-requested(nick); }
                    ban(nick) => { member-ban-requested(nick); }
                    whois(nick) => { member-whois-requested(nick); }
                    ctcp(nick, verb) => { member-ctcp-requested(nick, verb); }
                    query(nick) => { member-query-requested(nick); }
                }
            }

            // Keep the global Actions row anchored at the bottom even when
            // the selected window isn't joined and the roster is hidden.
            if !current-window-is-joined || current-query : Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            // Cicchetto's own bottom-of-members-column "actions" row (a
            // plain click, not a right-click, unlike `MemberContextMenu`)
            // — confirmed against its real source and the user's own
            // screenshot: a global nav/utility menu, not a per-member one.
            // Only lists what Cordiale actually has; Cicchetto's version
            // also has rooms/radio/archive/mute/switch-account.
            HorizontalLayout {
                alignment: start;

                Button {
                    text: "☰ " + @tr("Actions") + " ▾";
                    clicked => { actions-menu-area.show({ x: 0px, y: 0px }); }
                }

                actions-menu-area := ContextMenuArea {
                    Menu {
                        MenuItem { title: @tr("Home"); activated => { home-requested(); } }
                        MenuItem { title: @tr("Settings"); activated => { screen = "settings"; } }
                        MenuItem {
                            title: @tr("Themes");
                            activated => {
                                screen = "settings";
                                settings-section = "themes";
                            }
                        }
                        if is-admin : MenuItem {
                            title: @tr("Admin");
                            activated => {
                                screen = "settings";
                                settings-section = "admin";
                            }
                        }
                        MenuItem { title: @tr("Disconnect"); activated => { disconnect-requested(); } }
                    }
                }
            }
        }
    }

    if screen == "settings" : HorizontalBox {
        padding: 16px;
        spacing: 16px;

        VerticalBox {
            width: 200px;
            spacing: 4px;

            Text {
                text: @tr("Settings");
                font-size: 18px;
            }

            // Section list mirrors Cicchetto's Settings drawer order — see
            // docs/feature-matrix.md. Only General/Display are backed by
            // real Cordiale functionality today; the rest are placeholders
            // naming what's missing rather than pretending to work.
            Button {
                text: @tr("General");
                clicked => { settings-section = "general"; }
            }
            Button {
                text: @tr("Display");
                clicked => { settings-section = "display"; }
            }
            Button {
                text: @tr("Security");
                clicked => { settings-section = "security"; }
            }
            Button {
                text: @tr("Themes");
                clicked => { settings-section = "themes"; }
            }
            Button {
                text: @tr("Notifications");
                clicked => { settings-section = "push"; }
            }
            Button {
                text: @tr("Watch Lists");
                clicked => { settings-section = "watchlists"; }
            }
            Button {
                text: @tr("Ignore List");
                clicked => { settings-section = "ignores"; }
            }
            Button {
                text: @tr("Aliases");
                clicked => { settings-section = "aliases"; }
            }
            Button {
                text: @tr("On-Connect Commands");
                clicked => { settings-section = "perform"; }
            }
            Button {
                text: @tr("Source Address");
                clicked => { settings-section = "vhost"; }
            }
            if is-admin : Button {
                text: @tr("Admin");
                clicked => { settings-section = "admin"; }
            }
            Button {
                text: @tr("Credits");
                clicked => { settings-section = "credits"; }
            }

            Button {
                text: @tr("Back");
                clicked => { screen = "connected"; }
            }
        }

        VerticalBox {
            spacing: 12px;

            if settings-section == "general" : VerticalBox {
                spacing: 8px;

                Text {
                    text: @tr("Language");
                    font-size: 16px;
                }
                Button {
                    text: "English";
                    clicked => { language-selected("en"); }
                }
                Button {
                    text: "Italiano";
                    clicked => { language-selected("it"); }
                }
                Button {
                    text: "Français";
                    clicked => { language-selected("fr"); }
                }
                Button {
                    text: "Deutsch";
                    clicked => { language-selected("de"); }
                }
                Button {
                    text: "Español";
                    clicked => { language-selected("es"); }
                }

                Text {
                    text: @tr("Theme");
                    font-size: 16px;
                }
                Button {
                    text: theme == "light" ? @tr("Switch to dark") : @tr("Switch to light");
                    clicked => { theme-toggle-requested(); }
                }

                Text {
                    text: @tr("Connection");
                    font-size: 16px;
                }
                Button {
                    text: @tr("Disconnect");
                    clicked => { disconnect-requested(); }
                }

                // Read-only copies of preferences Grappa stores and applies
                // itself; they update live from its `*_changed` pushes and
                // stay hidden until the server has announced them.
                if server-pref-auto-away-debounce != "" : Text {
                    text: @tr("Auto-away delay: {}",
                        server-pref-auto-away-debounce == "default"
                            ? @tr("server default")
                            : (server-pref-auto-away-debounce == "off"
                                ? @tr("off")
                                : @tr("{} seconds", server-pref-auto-away-debounce)));
                    wrap: word-wrap;
                }
                if server-pref-leave-message-known : Text {
                    text: server-pref-leave-message-set
                        ? @tr("Quit/part message: {}", server-pref-leave-message)
                        : @tr("Quit/part message: none (server default)");
                    wrap: word-wrap;
                }
                if server-pref-auto-away-reason-known : Text {
                    text: server-pref-auto-away-reason-set
                        ? @tr("Auto-away message: {}", server-pref-auto-away-reason)
                        : @tr("Auto-away message: server default");
                    wrap: word-wrap;
                }
                if server-upload-limits-known : Text {
                    text: server-upload-limits.video-seconds == ""
                        ? @tr("Server upload limits ({}): images {}, videos {}, documents {}, audio {}.", server-upload-limits.host, server-upload-limits.image, server-upload-limits.video, server-upload-limits.document, server-upload-limits.audio)
                        : @tr("Server upload limits ({}): images {}, videos {} (up to {} s), documents {}, audio {}.", server-upload-limits.host, server-upload-limits.image, server-upload-limits.video, server-upload-limits.video-seconds, server-upload-limits.document, server-upload-limits.audio);
                    wrap: word-wrap;
                }

                if known-networks.length > 0 : VerticalBox {
                    padding-top: 8px;
                    spacing: 4px;

                    Text {
                        text: @tr("Network identity");
                        font-size: 16px;
                    }

                    HorizontalBox {
                        for network in known-networks : Button {
                            text: network;
                            clicked => {
                                settings-network = network;
                                settings-network-selected(network);
                            }
                        }
                    }

                    Text {
                        text: settings-network;
                        font-size: 12px;
                    }

                    LineEdit {
                        placeholder-text: @tr("Nickname");
                        accessible-label: @tr("Nickname");
                        text <=> identity-nick;
                    }
                    LineEdit {
                        placeholder-text: @tr("Ident");
                        accessible-label: @tr("Ident");
                        text <=> identity-ident;
                    }
                    LineEdit {
                        placeholder-text: @tr("Real name");
                        accessible-label: @tr("Real name");
                        text <=> identity-realname;
                    }
                    Button {
                        text: @tr("Save");
                        enabled: settings-network != "";
                        clicked => { identity-save-requested(); }
                    }
                }
            }

            if settings-section == "display" : VerticalBox {
                spacing: 8px;

                Text {
                    text: display-prefs-loaded ? @tr("Display preferences") : @tr("Loading…");
                    font-size: 16px;
                }

                CheckBox {
                    text: @tr("Colored nicklist");
                    checked <=> pref-colored-nicklist;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Bold mentions");
                    checked <=> pref-bold-mentions;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Strip formatting");
                    checked <=> pref-strip-formatting;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Show event badge");
                    checked <=> pref-show-event-badge;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Show bottom bar");
                    checked <=> pref-show-bottom-bar;
                    toggled => { display-prefs-changed(); }
                }
            }

            if settings-section == "security" || settings-section == "push" : VerticalBox {
                Text {
                    text: @tr("Not available yet — this section needs Grappa REST/WS endpoints Cordiale doesn't implement yet.");
                    wrap: word-wrap;
                }
            }

            // Purely client-side — no Grappa REST/WS endpoint involved,
            // unlike Security/Notifications above. A server-driven theme
            // (if/when Grappa exposes one) is a separate, later addition;
            // this is just the local light/dark switch, same toggle as
            // the one on General, surfaced here too since that's where
            // it's discoverable.
            if settings-section == "themes" : VerticalBox {
                spacing: 8px;

                Text {
                    text: @tr("Theme");
                    font-size: 16px;
                }
                Text {
                    text: @tr("Local only for now — a theme driven by Grappa itself will be a separate option once the server supports one.");
                    wrap: word-wrap;
                }
                Button {
                    text: theme == "light" ? @tr("Switch to dark") : @tr("Switch to light");
                    clicked => { theme-toggle-requested(); }
                }
            }

            if settings-section == "watchlists" : VerticalBox {
                spacing: 8px;

                Text {
                    text: @tr("Presence (per network)");
                    font-size: 16px;
                }
                HorizontalBox {
                    for network in known-networks : Button {
                        text: network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                for row in settings-notify-nicks : HorizontalBox {
                    Text {
                        text: row.presence == "online"
                            ? @tr("{} (online)", row.nick)
                            : (row.presence == "offline" ? @tr("{} (offline)", row.nick) : row.nick);
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Delete");
                        clicked => { notify-remove-requested(row.nick); }
                    }
                }
                HorizontalBox {
                    LineEdit {
                        placeholder-text: @tr("Nickname");
                        text <=> new-notify-nick;
                    }
                    Button {
                        text: @tr("Add");
                        enabled: settings-network != "";
                        clicked => {
                            notify-add-requested(new-notify-nick);
                            new-notify-nick = "";
                        }
                    }
                }

                Text {
                    text: @tr("Keyword highlights");
                    font-size: 16px;
                }
                for pattern in settings-watch-patterns : HorizontalBox {
                    Text {
                        text: pattern;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Delete");
                        clicked => { watch-pattern-remove-requested(pattern); }
                    }
                }
                HorizontalBox {
                    LineEdit {
                        placeholder-text: @tr("Pattern");
                        text <=> new-watch-pattern;
                    }
                    Button {
                        text: @tr("Add");
                        clicked => {
                            watch-pattern-add-requested(new-watch-pattern);
                            new-watch-pattern = "";
                        }
                    }
                }
            }

            if settings-section == "ignores" : VerticalBox {
                spacing: 8px;

                HorizontalBox {
                    for network in known-networks : Button {
                        text: network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                for mask in settings-ignores : HorizontalBox {
                    Text {
                        text: mask;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Delete");
                        clicked => { ignore-remove-requested(mask); }
                    }
                }
                HorizontalBox {
                    LineEdit {
                        placeholder-text: @tr("Mask (nick!user@host)");
                        text <=> new-ignore-mask;
                    }
                    Button {
                        text: @tr("Add");
                        enabled: settings-network != "";
                        clicked => {
                            ignore-add-requested(new-ignore-mask);
                            new-ignore-mask = "";
                        }
                    }
                }
            }

            if settings-section == "aliases" : VerticalBox {
                spacing: 8px;

                for row in settings-aliases : HorizontalBox {
                    Text {
                        text: row.command;
                        wrap: word-wrap;
                    }
                    Text {
                        text: row.expansion;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Delete");
                        clicked => { alias-remove-requested(row.command); }
                    }
                }
                HorizontalBox {
                    LineEdit {
                        placeholder-text: @tr("Command");
                        text <=> new-alias-command;
                    }
                    LineEdit {
                        placeholder-text: @tr("Expansion");
                        text <=> new-alias-expansion;
                    }
                    Button {
                        text: @tr("Add");
                        clicked => {
                            alias-add-requested(new-alias-command, new-alias-expansion);
                            new-alias-command = "";
                            new-alias-expansion = "";
                        }
                    }
                }
            }

            if settings-section == "perform" : VerticalBox {
                spacing: 8px;

                HorizontalBox {
                    for network in known-networks : Button {
                        text: network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                Text {
                    text: @tr("On-connect commands (one per line, semicolon-separated)");
                    wrap: word-wrap;
                }
                LineEdit {
                    text <=> perform-text;
                }
                Button {
                    text: @tr("Save");
                    enabled: settings-network != "";
                    clicked => { perform-save-requested(perform-text); }
                }
            }

            if settings-section == "vhost" : VerticalBox {
                spacing: 8px;

                for option in settings-vhost-options : CheckBox {
                    text: option.label;
                    checked: option.selected;
                    toggled => { vhost-toggle-requested(option.address); }
                }
            }

            if settings-section == "credits" : VerticalBox {
                spacing: 8px;
                alignment: start;

                Image {
                    source: @image-url("../../../resources/branding/cordiale_icona.png");
                    image-fit: contain;
                    height: 96px;
                }

                Text {
                    text: "Cordiale";
                    font-size: 20px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Sythos";
                    horizontal-alignment: center;
                }

                Text {
                    text: credits-copyright-text;
                    horizontal-alignment: center;
                }

                Text {
                    text: app-version;
                    horizontal-alignment: center;
                }
            }

            if settings-section == "admin" : VerticalBox {
                spacing: 8px;

                Text {
                    text: @tr("Vhosts, credentials, server-wide settings write, and the live admin event stream aren't built yet.");
                    wrap: word-wrap;
                }

                HorizontalBox {
                    Button {
                        text: @tr("Sessions");
                        clicked => { admin-section = "sessions"; }
                    }
                    Button {
                        text: @tr("Users");
                        clicked => { admin-section = "users"; }
                    }
                    Button {
                        text: @tr("Networks");
                        clicked => { admin-section = "networks"; }
                    }
                    Button {
                        text: @tr("Visitors");
                        clicked => { admin-section = "visitors"; }
                    }
                    Button {
                        text: @tr("Session Log");
                        clicked => { admin-section = "session-log"; }
                    }
                }

                HorizontalBox {
                    Button {
                        text: @tr("Refresh");
                        clicked => { admin-refresh-requested(); }
                    }
                    Button {
                        text: @tr("Run reaper sweep");
                        clicked => { admin-reaper-run(); }
                    }
                }

                Text {
                    text: admin-loading ? @tr("Loading…") : admin-overview-text;
                    wrap: word-wrap;
                }

                if admin-section == "sessions" : VerticalBox {
                    for row in admin-sessions : HorizontalBox {
                        Text {
                            text: row.label;
                            wrap: word-wrap;
                        }
                        Button {
                            text: @tr("Disconnect");
                            enabled: row.alive;
                            clicked => { admin-disconnect-session(row.session-id); }
                        }
                    }
                }

                if admin-section == "users" : VerticalBox {
                    for row in admin-users : HorizontalBox {
                        Text {
                            text: row.label;
                            wrap: word-wrap;
                        }
                        Button {
                            text: row.is-admin ? @tr("Revoke admin") : @tr("Make admin");
                            clicked => { admin-user-toggle-admin(row.user-id, !row.is-admin); }
                        }
                        Button {
                            text: @tr("Delete");
                            clicked => { admin-user-delete(row.user-id); }
                        }
                    }
                }

                if admin-section == "networks" : VerticalBox {
                    for row in admin-networks : HorizontalBox {
                        Text {
                            text: row.label;
                            wrap: word-wrap;
                        }
                        Button {
                            text: @tr("Reset circuit");
                            clicked => { admin-network-reset-circuit(row.network-id); }
                        }
                    }
                }

                if admin-section == "visitors" : VerticalBox {
                    for row in admin-visitors : HorizontalBox {
                        Text {
                            text: row.label;
                            wrap: word-wrap;
                        }
                        Button {
                            text: @tr("Delete");
                            clicked => { admin-visitor-delete(row.visitor-id); }
                        }
                    }
                }

                if admin-section == "session-log" : VerticalBox {
                    for line in admin-session-log : Text {
                        text: line;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if screen == "reply" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: reply-title-text();
            font-size: 18px;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        ListView {
            vertical-stretch: 1;
            for row in reply-rows : Text {
                text: row.label == ""
                    ? row.value
                    : (row.value == "" ? reply-label(row.label) : @tr("{}: {}", reply-label(row.label), row.value));
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }

        Button {
            text: @tr("Back");
            clicked => { screen = "connected"; }
        }
    }

    if screen == "archive" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("Archive on {}", archive-network);
            font-size: 18px;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        Text {
            text: !archive-loaded
                ? @tr("Loading…")
                : (archive-rows.length == 0
                    ? @tr("No archived windows.")
                    : @tr("Windows you left that still have history on the bouncer."));
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if archive-error != "" : Text {
            text: archive-error-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if archive-confirm-target != "" : HorizontalBox {
            padding: 0px;
            spacing: 4px;

            Text {
                text: @tr("Delete all history of {} on {}? Only the bouncer's copy is removed.", archive-confirm-target, archive-network);
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.text;
            }

            Button {
                text: @tr("Delete");
                clicked => {
                    archive-delete-requested(archive-confirm-target);
                    archive-confirm-target = "";
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => { archive-confirm-target = ""; }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in archive-rows : HorizontalBox {
                padding: 0px;
                spacing: 4px;

                Text {
                    text: row.kind == "query"
                        ? @tr("{} (private, last active {})", row.target, row.last-activity)
                        : @tr("{} (last active {})", row.target, row.last-activity);
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    accessible-role: AccessibleRole.text;
                }

                Button {
                    text: @tr("Delete history");
                    accessible-label: @tr("Delete history of {}", row.target);
                    clicked => { archive-confirm-target = row.target; }
                }
            }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                archive-closed();
            }
        }
    }

    if screen == "directory" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("Channels on {}", directory-network);
            font-size: 18px;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        Text {
            text: directory-status-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if directory-failed-reason != "" : Text {
            text: @tr("The last channel listing failed ({}); showing the previous list.", directory-failed-reason);
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if directory-error != "" : Text {
            text: directory-error-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        HorizontalBox {
            padding: 0px;

            LineEdit {
                placeholder-text: @tr("Search channels");
                accessible-label: @tr("Search channels");
                text <=> directory-query;
                accepted => { directory-search-requested(directory-query); }
            }

            Button {
                text: directory-sort == "name" ? @tr("Sort by users") : @tr("Sort by name");
                clicked => { directory-sort-requested(directory-sort == "name" ? "users" : "name"); }
            }

            Button {
                text: directory-refresh-pending ? @tr("Refreshing…") : @tr("Refresh");
                enabled: !directory-refresh-pending;
                clicked => { directory-refresh-requested(); }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in directory-rows : Text {
                text: row.topic == ""
                    ? @tr("{} ({} users)", row.name, row.users)
                    : @tr("{} ({} users) — {}", row.name, row.users, row.topic);
                font-weight: row.featured ? 700 : 400;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }

        if directory-has-more : Button {
            text: @tr("Load more");
            clicked => { directory-load-more-requested(); }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                directory-closed();
            }
        }
    }

    if screen == "links" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: links-network-label;
            font-size: 18px;
        }

        for row in links-rows : Text {
            text: row.display;
            wrap: word-wrap;
        }

        Button {
            text: @tr("Show graph");
            clicked => { links-graph-requested(); }
        }

        Button {
            text: @tr("Back");
            clicked => { screen = "connected"; }
        }
    }
}

export component LinksGraphWindow inherits Window {
    title: @tr("Cordiale — Network Links");
    width: 800px;
    height: 640px;

    in property <string> network-label: "";
    in property <string> edges-commands: "";
    in property <[LinksGraphNode]> nodes: [];

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        Text {
            text: network-label;
            font-size: 18px;
        }

        Rectangle {
            // Explicit size: absolutely-positioned children (the nodes
            // and the Path below) don't contribute a preferred size to
            // the enclosing VerticalBox, so without this the canvas
            // could collapse to zero height.
            width: 100%;
            height: 560px;
            background: #1e1e1e;

            Path {
                width: 100%;
                height: 100%;
                commands: edges-commands;
                stroke: #888888;
                stroke-width: 1.5px;
            }

            for node in nodes : Rectangle {
                x: node.x * 1px - 5px;
                y: node.y * 1px - 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: #4a9eff;
            }

            for node in nodes : Text {
                x: node.x * 1px + 8px;
                y: node.y * 1px - 7px;
                text: node.server;
                color: white;
                font-size: 12px;
            }
        }
    }
}
