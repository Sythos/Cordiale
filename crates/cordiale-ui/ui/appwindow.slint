import { LineEdit, Button, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Cordiale";
    width: 480px;
    height: 440px;

    // One of "language", "connect", "connected" — see MEMORY.md §3.4 for
    // why there's no `else`/`else if` in Slint: mutually exclusive `if`
    // blocks are the documented pattern for multi-screen navigation.
    in-out property <string> screen: "connect";

    in-out property <string> server-url: "https://irc.sindro.me";
    in-out property <string> identifier: "";
    in-out property <string> password: "";
    in property <string> status-message: "";
    in property <bool> connecting: false;
    in property <[string]> networks: [];

    callback connect-requested(string, string, string);
    callback language-selected(string);
    callback disconnect-requested();

    if screen == "language" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Choose your language";
            font-size: 22px;
            horizontal-alignment: center;
        }

        Button {
            text: "English";
            clicked => { language-selected("en"); }
        }
        Button {
            text: "Italiano";
            clicked => { language-selected("it"); }
        }
        Button {
            text: "Français";
            clicked => { language-selected("fr"); }
        }
        Button {
            text: "Deutsch";
            clicked => { language-selected("de"); }
        }
        Button {
            text: "Español";
            clicked => { language-selected("es"); }
        }
    }

    if screen == "connect" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px;
            horizontal-alignment: center;
        }

        LineEdit {
            placeholder-text: "Server URL";
            text <=> server-url;
        }

        LineEdit {
            placeholder-text: "Username";
            text <=> identifier;
        }

        LineEdit {
            placeholder-text: "Password or client token";
            text <=> password;
            // Qualified as `InputType.password`, not bare `password`: this
            // component also has a property named `password` (the text
            // itself), which would otherwise shadow the enum variant.
            input-type: InputType.password;
        }

        Button {
            text: connecting ? "Connecting…" : "Connect";
            enabled: !connecting;
            clicked => { connect-requested(server-url, identifier, password); }
        }

        Button {
            text: "Change language";
            clicked => { screen = "language"; }
        }

        Text {
            text: status-message;
            color: #cc3333;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if screen == "connected" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Connected to " + server-url;
            font-size: 20px;
            horizontal-alignment: center;
        }

        Text {
            text: status-message;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        for network in networks : Text {
            text: "• " + network;
        }

        Button {
            text: "Disconnect";
            clicked => { disconnect-requested(); }
        }
    }
}
