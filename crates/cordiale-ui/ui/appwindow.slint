    callback profile-save-requested();
    callback avatar-pick-requested();
    callback avatar-remove-requested();
    callback ignore-add-requested(string, string); // mask, text pattern ("" for none)
    callback ignore-remove-requested(string, string); // mask, text pattern ("" for none)
    callback perform-save-requested(string);
    callback alias-add-requested(string, string);
    callback alias-remove-requested(string);
    callback vhost-toggle-requested(string);
    callback notify-add-requested(string);
    callback notify-remove-requested(string);
    callback watch-pattern-add-requested(string);
    callback watch-pattern-remove-requested(string);

    // Maps a machine-readable `status-kind` (set from Rust, never
    // English text directly) to a translated template — the only way to
    // get Rust-originated dynamic status text through Slint's `@tr()`
    // translation system, since `@tr()` only works on string literals
    // that live in a `.slint` file.
    // Sidebar connection labels arrive from Rust as English keys
    // ("connecting", "reconnecting", "paused", "connection failed").
    function home-state-text(state: string) -> string {
        if state == "connected" {
            return @tr("connected");
        } else if state == "failing" {
            return @tr("failing");
        } else if state == "parked" {
            return @tr("parked");
        } else if state == "failed" {
            return @tr("failed");
        } else {
            return state;
        }
    }

    function home-error-text(key: string, network: string) -> string {
        if key == "remove-forbidden" {
            return @tr("A guest session can't remove {}.", network);
        } else if key == "remove-not-found" {
            return @tr("{} is no longer part of this session.", network);
        } else if key == "remove-failed" {
            return @tr("Couldn't remove {}.", network);
        } else if key == "disconnect-failed" {
            return @tr("Couldn't disconnect {}.", network);
        } else if key == "reconnect-failed" {
            return @tr("Couldn't reconnect {}.", network);
        } else if key == "connect-failed" {
            return @tr("Couldn't connect {}.", network);
        } else {
            return key;
        }
    }

    function home-session-text() -> string {
        if home-session-kind == "user" {
            return @tr("Your chat stays connected — always. This device stays signed in for 7 days of inactivity; after that you'll sign back in, but Grappa never drops your IRC connection.");
        } else if home-session-kind == "visitor-registered" && home-named-network != "" {
            return @tr("You're registered as {} on {}, so your chat stays connected and your history is kept for good. This device stays signed in for 7 days of inactivity; after that you'll sign back in, but nothing is lost.", home-named-nick, home-named-network);
        } else if home-session-kind == "visitor-registered" {
            return @tr("You're registered, so your chat stays connected and your history is kept for good. This device stays signed in for 7 days of inactivity; after that you'll sign back in, but nothing is lost.");
        } else if home-session-kind == "visitor-guest" {
            return @tr("You're chatting as a guest. Your session is kept alive for up to 48 hours of inactivity — after that it expires and everything in it is gone.");
        } else {
            return "";
        }
    }

    function connection-label-text(label: string) -> string {
        if label == "connecting" {
            return @tr("connecting");
        } else if label == "reconnecting" {
            return @tr("reconnecting");
        } else if label == "paused" {
            return @tr("paused");
        } else if label == "connection failed" {
            return @tr("connection failed");
        } else {
            return label;
        }
    }

    function reply-title-text() -> string {
        if reply-kind == "who_reply" {
            return @tr("WHO {} on {}", reply-subject, reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "motd" {
            return @tr("Message of the day on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "info" {
            return @tr("Server information on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "version" {
            return @tr("Server version on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "admin" {
            return @tr("Server administrator on {}", reply-network);
        } else if reply-kind == "whois_bundle" {
            return @tr("WHOIS {} on {}", reply-subject, reply-network);
        } else if reply-kind == "whowas_bundle" {
            return @tr("WHOWAS {} on {}", reply-subject, reply-network);
        } else if reply-kind == "banlist_bundle" {
            return @tr("Mode list {} on {}", reply-subject, reply-network);
        } else if reply-kind == "mentions_bundle" {
            return @tr("Mentions while you were away on {}", reply-network);
        } else if reply-kind == "lusers_bundle" {
            return @tr("Network statistics for {}", reply-network);
        } else {
            return reply-network;
        }
    }

    function reply-label(key: string) -> string {
        if key == "who-empty" {
            return @tr("No users matched.");
        } else if key == "reply-empty" {
            return @tr("The server sent no lines.");
        } else if key == "whois-userhost" {
            return @tr("Address");
        } else if key == "whois-realname" {
            return @tr("Real name");
        } else if key == "whois-server" {
            return @tr("Server");
        } else if key == "whois-account" {
            return @tr("Account");
        } else if key == "whois-channels" {
            return @tr("Channels");
        } else if key == "whois-idle" {
            return @tr("Idle");
        } else if key == "whois-signon" {
            return @tr("Signed on");
        } else if key == "whois-away" {
            return @tr("Away");
        } else if key == "whois-operator" {
            return @tr("IRC operator");
        } else if key == "whois-umodes" {
            return @tr("User modes");
        } else if key == "whois-secure" {
            return @tr("Secure connection");
        } else if key == "whois-certfp" {
            return @tr("Certificate fingerprint");
        } else if key == "whois-actually" {
            return @tr("Actual host");
        } else if key == "whois-registered" {
            return @tr("Registered nick");
        } else if key == "whois-admin" {
            return @tr("Server administrator");
        } else if key == "whois-services-admin" {
            return @tr("Services administrator");
        } else if key == "whois-helper" {
            return @tr("Helper");
        } else if key == "whois-chanop" {
            return @tr("Channel operator");
        } else if key == "whois-agent" {
            return @tr("Agent");
        } else if key == "whois-java" {
            return @tr("Java client");
        } else if key == "whois-avatar" {
            return @tr("Avatar available on the server");
        } else if key == "whowas-logoff" {
            return @tr("Last seen");
        } else if key == "whowas-not-found" {
            return @tr("The server has no history for this nick.");
        } else if key == "banlist-empty" {
            return @tr("The list is empty.");
        } else if key == "mentions-away-period" {
            return @tr("Away");
        } else if key == "mentions-away-reason" {
            return @tr("Away message");
        } else if key == "mentions-empty" {
            return @tr("Nobody mentioned you.");
        } else if key == "lusers-total-users" {
            return @tr("Users");
        } else if key == "lusers-invisible" {
            return @tr("Invisible");
        } else if key == "lusers-servers" {
            return @tr("Servers");
        } else if key == "lusers-operators" {
            return @tr("Operators online");
        } else if key == "lusers-unknown-connections" {
            return @tr("Unknown connections");
        } else if key == "lusers-channels-formed" {
            return @tr("Channels formed");
        } else if key == "lusers-local-clients" {
            return @tr("Clients on this server");
        } else if key == "lusers-local-servers" {
            return @tr("Servers linked to this server");
        } else if key == "lusers-current-local" {
            return @tr("Current local users");
        } else if key == "lusers-max-local" {
            return @tr("Max local users");
        } else if key == "lusers-current-global" {
            return @tr("Current global users");
        } else if key == "lusers-max-global" {
            return @tr("Max global users");
        } else {
            return key;
        }
    }

    function recover-step-label(step: string) -> string {
        if step == "identify" {
            return @tr("Identify with services");
        } else if step == "register" {
            return @tr("Confirm registration");
        } else if step == "nick" {
            return @tr("Switch nick");
        } else if step == "recover" {
            return @tr("Recover the nick");
        } else if step == "release" {
            return @tr("Release the nick");
        } else {
            return step;
        }
    }

    function recover-status-label(status: string) -> string {
        if status == "running" {
            return @tr("in progress");
        } else if status == "ok" {
            return @tr("done");
        } else if status == "failed" {
            return @tr("failed");
        } else {
            return status;
        }
    }

    // Grappa's four known reasons are localized; any additive future reason
    // is shown verbatim rather than dropped.
    function recover-reason-label(reason: string) -> string {
        if reason == "wrong_password" {
            return @tr("wrong password");
        } else if reason == "nick_unavailable" {
            return @tr("nick unavailable");
        } else if reason == "services_declined" {
            return @tr("services declined");
        } else if reason == "identify_unconfirmed" {
            return @tr("identification not confirmed");
        } else {
            return reason;
        }
    }

    // Relative age of the listing, Cicchetto's thresholds.
    function directory-age-text() -> string {
        if directory-age-seconds < 0 {
            return directory-status == "loading" ? @tr("listing…") : @tr("never listed");
        } else if directory-age-seconds < 60 {
            return @tr("just now");
        } else if directory-age-seconds < 3600 {
            return @tr("{}m ago", floor(directory-age-seconds / 60));
        } else if directory-age-seconds < 86400 {
            return @tr("{}h ago", floor(directory-age-seconds / 3600));
        } else {
            return @tr("{}d ago", floor(directory-age-seconds / 86400));
        }
    }

    function mute-remaining-text() -> string {
        if current-mute-hours > 0 && current-mute-minutes > 0 {
            return @tr("{} h {} min", current-mute-hours, current-mute-minutes);
        } else if current-mute-hours > 0 {
            return @tr("{} h", current-mute-hours);
        } else {
            return @tr("{} min", current-mute-minutes);
        }
    }

    function mute-bar-text() -> string {
        if current-mute-until == "" {
            return current-mute-since == ""
                ? @tr("Channel muted")
                : @tr("Channel muted at {}", current-mute-since);
        } else {
            return current-mute-since == ""
                ? @tr("Channel muted - expires in {}", mute-remaining-text())
                : @tr("Channel muted at {} - expires in {}", current-mute-since, mute-remaining-text());
        }
    }

    function directory-empty-text() -> string {
        if directory-rows.length > 0 {
            return "";
        } else if directory-status == "loading" {
            return @tr("Listing channels…");
        } else if directory-status == "unknown" {
            return @tr("No channel list yet.");
        } else if directory-status == "no_results" {
            return directory-query == "" ? @tr("The server listed no channels.") : @tr("No channels match your search.");
        } else {
            return "";
        }
    }

    function archive-error-text() -> string {
        if archive-error == "archive-rate-limited" {
            return @tr("Too many archive requests. Wait a moment and try again.");
        } else if archive-error == "archive-fetch-failed" {
            return @tr("Couldn't load the archive.");
        } else if archive-error == "archive-delete-failed" {
            return @tr("Couldn't delete that history.");
        } else {
            return archive-error;
        }
    }

    function directory-error-text() -> string {
        if directory-error == "directory-fetch-failed" {
            return @tr("Couldn't load the channel list.");
        } else if directory-error == "directory-refresh-failed" {
            return @tr("Couldn't refresh the channel list. Is the network connected?");
        } else if directory-error == "directory-join-failed" {
            return @tr("Couldn't join that channel.");
        } else {
            return directory-error;
        }
    }

    // Why a security key gave no answer (`key-prompt-error`).
    function key-prompt-text(reason: string) -> string {
        if reason == "key-missing" {
            return @tr("No security key found. Plug it in and try again.");
        } else if reason == "key-several" {
            return @tr("More than one security key is plugged in. Leave just one and try again.");
        } else if reason == "key-pin-invalid" {
            return key-prompt-retries < 0 ? @tr("Wrong PIN.") : @tr("Wrong PIN. Attempts left before the key locks: {}.", key-prompt-retries);
        } else if reason == "key-pin-auth-blocked" {
            return @tr("Too many wrong PINs in a row. Unplug the key, plug it back in and try again.");
        } else if reason == "key-pin-blocked" {
            return @tr("The key's PIN is blocked. Only resetting the key, which erases its passkeys, unblocks it.");
        } else if reason == "key-pin-policy" {
            return @tr("A security key PIN has 4 to 63 characters.");
        } else if reason == "key-pin-not-set" {
            return @tr("This key has no PIN, and Grappa requires one. Set a PIN on the key first, for example in a browser's security key settings.");
        } else if reason == "key-no-uv" {
            return @tr("This key can't confirm it's you with a PIN or a fingerprint, which Grappa requires.");
        } else if reason == "key-not-registered" {
            return @tr("This security key doesn't hold a passkey for this account.");
        } else if reason == "key-denied" {
            return @tr("The key wasn't touched in time, or the request was refused on the key.");
        } else if reason == "key-full" {
            return @tr("The security key has no room left for another passkey.");
        } else if reason == "key-unsupported" {
            return @tr("Grappa asked for a kind of passkey this security key can't create.");
        } else if reason == "key-failed" {
            return @tr("The security key didn't answer as expected. Try again.");
        }
        return "";
    }

    function status-text() -> string {
        if status-kind == "signed-in" {
            return @tr("Signed in. {} network(s), {} channel(s).", status-network-count, status-channel-count);
        } else if status-kind == "wrong-credentials" {
            return @tr("Wrong username or password/token.");
        } else if status-kind == "reauthentication-required" {
            return @tr("Saved sign-in is unavailable. Enter your password or client token to sign in again.");
        } else if status-kind == "away-delay-invalid" {
            return @tr("The auto-away delay must be a whole number of seconds.");
        } else if status-kind == "personal-prefs-saved" {
            return @tr("Settings saved.");
        } else if status-kind == "away-nick-suffix-invalid" {
            return @tr("That nick suffix isn't valid on IRC.");
        } else if status-kind == "personal-prefs-failed" {
            return @tr("Couldn't save those settings.");
        } else if status-kind == "profile-saved" {
            return @tr("Profile saved.");
        } else if status-kind == "profile-invalid" {
            return @tr("Profile fields must be one line and at most 100 bytes each.");
        } else if status-kind == "profile-failed" {
            return @tr("Couldn't save the profile.");
        } else if status-kind == "avatar-saved" {
            return @tr("Avatar updated.");
        } else if status-kind == "avatar-removed" {
            return @tr("Avatar removed.");
        } else if status-kind == "avatar-remove-failed" {
            return @tr("Couldn't remove the avatar.");
        } else if status-kind == "command-refused" {
            return @tr("The server refused that command ({}).", status-command-hint);
        } else if status-kind == "alias-too-deep" {
            return @tr("That alias expands into too many others: {}", status-command-hint);
        } else if status-kind == "kickban-host-unknown" {
            return @tr("{}'s host isn't known yet, so they were only kicked; /whois them first to ban too.", status-command-hint);
        } else if status-kind == "command-topic" {
            return @tr("Topic of {}", status-command-hint);
        } else if status-kind == "command-no-topic" {
            return @tr("{} has no topic.", status-command-hint);
        } else if status-kind == "command-modes" {
            return @tr("Modes of {}", status-command-hint);
        } else if status-kind == "command-no-modes" {
            return @tr("No modes known for {} yet.", status-command-hint);
        } else if status-kind == "beep-current" {
            return @tr("Notification sound: {}", status-command-hint);
        } else if status-kind == "beep-set" {
            return @tr("Notification sound set to {}.", status-command-hint);
        } else if status-kind == "beep-unknown" {
            return @tr("Unknown sound. Available: {}", status-command-hint);
        } else if status-kind == "theme-saved" {
            return @tr("Theme saved and in use.");
        } else if status-kind == "theme-invalid" {
            return @tr("A theme needs a name (up to 60 characters) and 27 valid #rrggbb colors.");
        } else if status-kind == "theme-refused" {
            return @tr("Grappa refused the theme: the name may be taken or a value is invalid.");
        } else if status-kind == "theme-rate-limited" {
            return @tr("Too many new themes today; try again tomorrow.");
        } else if status-kind == "theme-action-failed" {
            return @tr("The theme action failed ({}).", status-command-hint);
        } else if status-kind == "theme-background-failed" {
            return @tr("The wallpaper couldn't be uploaded ({}).", status-command-hint);
        } else if status-kind == "np-idle" {
            return @tr("/np: nothing is playing. Tune a station from the radio first.");
        } else if status-kind == "np-unsupported" {
            return @tr("/np: {} publishes no track information.", status-command-hint);
        } else if status-kind == "np-unanswered" {
            return @tr("/np: no track from {} yet; its feed hasn't answered.", status-command-hint);
        } else if status-kind == "np-stale" {
            return @tr("/np: the last track from {} is over 3 minutes old, so it wasn't sent.", status-command-hint);
        } else if status-kind == "radio-station-invalid" {
            return @tr("A station needs a name and an http:// or https:// stream URL.");
        } else if status-kind == "command-usage-hint" {
            return @tr("Usage: {}", status-command-hint);
        } else if status-kind == "command-unknown" {
            return @tr("Unknown command: {}", status-command-hint);
        } else if status-kind == "command-needs-channel" {
            return @tr("{} only works in a channel window.", status-command-hint);
        } else if status-kind == "no-active-network" {
            return @tr("Select a network before entering a command.");
        } else if status-kind == "server-window-commands-only" {
            return @tr("The server window accepts only slash commands.");
        } else if status-kind == "server-history-failed" {
            return @tr("Could not load the server messages. Live messages may still arrive.");
        } else if status-kind == "command-failed" {
            return @tr("{} failed.", status-command-hint);
        } else if status-kind == "command-usage" {
            return @tr("That command is missing an argument, for example: /whowas <nick>.");
        } else if status-kind == "session-severed-flood" {
            return @tr("You were signed out because this client sent too many requests. Your IRC session is still running; sign in again to continue.");
        } else if status-kind == "two-factor-passkey-only" {
            return @tr("This account's second factor is a passkey, which Cordiale can't use yet. Sign in with a per-client token created in Cicchetto, or use Cicchetto.");
        } else if status-kind == "passkey-refused" {
            return @tr("The server refused the passkey. The authenticator may be the wrong one, or the server expects another origin than {}. If it does, enter it under Passkey origin.", passkey-origin-preview(server-url, passkey-origin));
        } else if status-kind == "passkey-cancelled" {
            return @tr("The passkey request was cancelled, timed out, or found no passkey for this account.");
        } else if status-kind == "passkey-no-account" {
            return @tr("That account doesn't sign in with a passkey alone. Use its password instead.");
        } else if status-kind == "passkey-busy" {
            return @tr("Grappa is busy right now. Try again in a moment.");
        } else if status-kind == "passkey-failed" {
            return @tr("The passkey request failed.");
        } else if status-kind == "totp-invalid" {
            return @tr("That code isn't valid. Check the clock on your device, or use one of your recovery codes.");
        } else if status-kind == "totp-expired" {
            return @tr("The sign-in took too long. Enter your password again.");
        } else if status-kind == "totp-throttled" {
            return @tr("Too many attempts. Wait a few minutes before trying again.");
        } else if status-kind == "totp-failed" {
            return @tr("Couldn't verify the code. Try again.");
        } else if status-kind == "recovery-invalid" {
            return @tr("That recovery code didn't work. It may be wrong or already used: each code works only once.");
        } else if status-kind == "recovery-busy" {
            return @tr("Grappa is busy right now. Try again in a moment.");
        } else if status-kind == "recovery-failed" {
            return @tr("Couldn't sign in with that recovery code. Try again.");
        } else if status-kind == "share-invalid" {
            return @tr("That isn't a share token or link Grappa accepts. Copy it again from the other device.");
        } else if status-kind == "share-expired" {
            return @tr("This share link has expired. Create a new one on the other device.");
        } else if status-kind == "share-consumed" {
            return @tr("This share link has already been used. Create a new one on the other device.");
        } else if status-kind == "share-gone" {
            return @tr("The account this link was made for no longer exists.");
        } else if status-kind == "share-failed" {
            return @tr("Couldn't sign in with that share token. Try again.");
        } else if status-kind == "too-many-attempts" {
            return @tr("Too many attempts. Wait a bit before trying again.");
        } else if status-kind == "login-failed" {
            return @tr("Login failed.");
        } else if status-kind == "guest-nick-taken" {
            return status-message == ""
                ? @tr("That nickname is taken on this server right now. Pick another one or try again later.")
                : @tr("That nickname is taken on this server right now. Pick another one or try again in {} seconds.", status-message);
        } else if status-kind == "guest-nick-taken-hours" {
            return @tr("That nickname is taken on this server right now. Pick another one or try again in about {} hours.", status-message);
        } else if status-kind == "guest-too-many-sessions" {
            return @tr("This server has reached its guest session limit for your connection. Sign out another guest session or try again later.");
        } else if status-kind == "guest-logout-unconfirmed" {
            return @tr("Disconnected here, but the server did not confirm guest sign-out. Your nickname may remain reserved; reconnect to try again.");
        } else if status-kind == "guest-nick-in-use" {
            return @tr("That nickname is already in use on the network. Pick another one.");
        } else if status-kind == "guest-nick-invalid" {
            return @tr("That isn't a valid IRC nickname. Enter one in the name field.");
        } else if status-kind == "guest-captcha-required" {
            return @tr("This server asks guests to solve a CAPTCHA, which needs a browser. Sign in from a browser instead.");
        } else if status-kind == "boot-me-failed" {
            return @tr("Signed in, but couldn't load account data.");
        } else if status-kind == "unreachable" {
            return @tr("Couldn't reach the server. Check the URL and try again.");
        } else if status-kind == "protocol-too-old" {
            return @tr("This server's protocol version ({}) is too old for Cordiale.", status-protocol-version);
        } else if status-kind == "notify-prefs-invalid" {
            return @tr("Keep at least one message notification on.");
        } else if status-kind == "notify-prefs-failed" {
            return @tr("Couldn't save the notification settings.");
        } else if status-kind == "admin-action-done" {
            return @tr("Done.");
        } else if status-kind == "admin-action-failed" {
            return @tr("The server refused that admin action ({}).", status-command-hint);
        } else if status-kind == "admin-forbidden" {
            return @tr("Admin actions need an administrator signed in with a full session. A client token can't do them.");
        } else if status-kind == "admin-network-in-use" {
            return @tr("That network still has accounts bound to it. Unbind them on the Credentials tab first.");
        } else if status-kind == "admin-credential-stopped" {
            return @tr("Saved. The account's live session was stopped because its login changed; it has to reconnect.");
        } else if status-kind == "admin-credential-invalid" {
            return @tr("A credential needs an account, a network and a nickname.");
        } else if status-kind == "admin-server-invalid" {
            return @tr("A server needs a host and a port between 1 and 65535.");
        } else if status-kind == "admin-setting-invalid" {
            return @tr("Sizes and the video length must be positive numbers.");
        } else if status-kind == "admin-cap-invalid" {
            return @tr("Caps must be whole numbers, or empty for unlimited.");
        } else if status-kind == "send-failed" {
            return @tr("Couldn't send that message.");
        } else if status-kind == "rate-limited" {
            return @tr("Too many requests. Try again in about {} s.", status-retry-secs);
        } else if status-kind == "part-failed" {
            return @tr("Couldn't leave the channel. Please try again.");
        } else if status-kind == "invite-decline-failed" {
            return @tr("Couldn't decline the invite. Please try again.");
        } else if status-kind == "disconnected" {
            return status-retry-secs > 0 ? @tr("Disconnected. Reconnecting in {} s… ({})", status-retry-secs, status-message) : status-message == "" ? @tr("Disconnected. Reconnecting…") : @tr("Disconnected. Reconnecting… ({})", status-message);
        } else if status-kind == "session-refused" {
            return @tr("Grappa refused the realtime session ({}). Sign out and in again; if it keeps happening, please report it.", status-message);
        } else if status-kind == "certificate-untrusted" {
            return @tr("This computer doesn't trust the server's certificate ({}). Add the server's certificate authority to the system trust store, then sign in again.", status-message);
        } else if status-kind == "upgrade-required" {
            return @tr("This server no longer accepts this version of Cordiale. Please update Cordiale.");
        } else if status-kind == "reconnecting" {
            return status-retry-secs > 0 ? @tr("Reconnecting in {} s… ({})", status-retry-secs, status-message) : status-message == "" ? @tr("Reconnecting…") : @tr("Reconnecting… ({})", status-message);
        } else if status-kind == "presence-online" {
            return @tr("{} is now online on {}.", status-presence-nick, status-presence-network);
        } else if status-kind == "presence-offline" {
            return @tr("{} went offline on {}.", status-presence-nick, status-presence-network);
        } else if status-kind == "presence-list-full" {
            return @tr("The watch list on {} is full; not watched: {}.", status-presence-network, status-presence-nick);
        } else if status-kind == "presence-rejected" {
            return @tr("The server on {} refused to watch: {}.", status-presence-network, status-presence-nick);
        } else if status-kind == "dcc-accepted" {
            return @tr("Accepted {} from {}; the transfer runs on the server.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-refused" {
            return @tr("Refused {} from {}.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-expired" {
            return @tr("The offer of {} from {} expired.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-offer-gone" {
            return @tr("That file offer is no longer available.");
        } else if status-kind == "dcc-rate-limited" {
            return @tr("Daily file transfer limit reached. Try again later.");
        } else if status-kind == "dcc-not-connected" {
            return @tr("That network isn't connected, so the file offer can't be answered.");
        } else if status-kind == "dcc-no-space" {
            return @tr("The server has no room left for this file.");
        } else if status-kind == "dcc-action-failed" {
            return @tr("Couldn't answer the file offer.");
        } else if status-kind == "no-mentions" {
            return @tr("No away summary for this network yet.");
        } else if status-kind == "mention-window-gone" {
            return @tr("That window is no longer open.");
        } else if status-kind == "mention-not-found" {
            return @tr("That message is no longer in the history.");
        } else if status-kind == "mention-load-failed" {
            return @tr("Could not load that message.");
        } else if status-kind == "invite-sent" {
            return @tr("Invited {} to {} on {}.", status-invite-peer, status-invite-channel, status-invite-network);
        } else if status-kind == "attach-uploading" {
            return @tr("Uploading {}…", status-attach-name);
        } else if status-kind == "attach-unsupported-type" {
            return @tr("The server doesn't accept this type of file: {}", status-attach-name);
        } else if status-kind == "attach-too-large" {
            return @tr("{} is larger than the server allows for this type of file.", status-attach-name);
        } else if status-kind == "ignore-invalid-text-pattern" {
            return @tr("The text pattern can't be blank or span more than one line.");
        } else if status-kind == "ignore-invalid-mask" {
            return @tr("That mask isn't valid.");
        } else if status-kind == "display-prefs-rejected" {
            return @tr("Grappa refused that date format; the saved one is back.");
        } else if status-kind == "display-prefs-save-failed" {
            return @tr("Couldn't save the display preferences.");
        } else if status-kind == "attach-no-space" {
            return @tr("The upload of {} was refused for lack of space.", status-attach-name);
        } else if status-kind == "attach-read-failed" {
            return @tr("Couldn't read {}.", status-attach-name);
        } else if status-kind == "attach-no-window" {
            return @tr("Open a channel or private conversation before attaching a file.");
        } else if status-kind == "attach-failed" {
            return @tr("Couldn't upload {}.", status-attach-name);
        } else if status-kind == "theme-change-failed" {
            return @tr("Couldn't change the theme on the server.");
        } else {
            return status-message;
        }
    }

    // Invisible measuring probes for the side columns' minimum widths.
    sidebar-label-probe := Button {
        text: sidebar-widest-label;
        visible: false;
        enabled: false;
    }
    members-nick-probe := Text {
        text: members-average-nick;
        visible: false;
    }
    actions-probe := Button {
        text: "☰ " + @tr("Actions") + " ▾";
        visible: false;
        enabled: false;
    }

    if palette-active && palette-background-set : Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: palette-background;
        image-fit: palette-background-tile ? ImageFit.preserve : ImageFit.cover;
        horizontal-tiling: palette-background-tile ? ImageTiling.repeat : ImageTiling.none;
        vertical-tiling: palette-background-tile ? ImageTiling.repeat : ImageTiling.none;
        opacity: palette-background-opacity;
        accessible-role: AccessibleRole.none;
    }

    if screen == "splash" : VerticalBox {
        padding: 32px;
        spacing: 24px;
        alignment: center;

        property <float> splash-progress: 0;
        animate splash-progress {
            duration: 1800ms;
            easing: ease-out;
        }

        init => {
            splash-progress = 1.0;
        }

        Timer {
            interval: 1900ms;
            running: true;
            triggered => {
                screen = next-screen;
            }
        }

        Image {
            source: @image-url("../../../resources/branding/cordiale.png");
            image-fit: contain;
            height: 220px;
        }

        ProgressIndicator {
            progress: splash-progress;
        }
    }

    if screen == "language" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: @tr("Choose your language");
            font-size: 22px * FontScale.percent / 100;
            horizontal-alignment: center;
        }

        // Language names are shown in their own language regardless of
        // the current UI language (so a French speaker can still find
        // "Français" even if the UI is currently in English) — never
        // wrapped in @tr().
        Button {
            text: "English";
            clicked => { language-selected("en"); }
        }
        Button {
            text: "Italiano";
            clicked => { language-selected("it"); }
        }
        Button {
            text: "Français";
            clicked => { language-selected("fr"); }
        }
        Button {
            text: "Deutsch";
            clicked => { language-selected("de"); }
        }
        Button {
            text: "Español";
            clicked => { language-selected("es"); }
        }
    }

    if screen == "totp" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px * FontScale.percent / 100;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Two-factor authentication");
            font-size: 18px * FontScale.percent / 100;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: !totp-code-accepted
                ? @tr("This account's second factor is a passkey. Use it to finish signing in. The request expires after five minutes.")
                : totp-recovery-only && passkey-available
                ? @tr("This account's second factor is a passkey. If you can't use it, enter one of your recovery codes instead: each works only once. The request expires after five minutes.")
                : totp-recovery-only
                ? @tr("This account's second factor is a passkey, which Cordiale can't use yet. Enter one of your recovery codes instead: each works only once. The request expires after five minutes.")
                : @tr("Enter the 6-digit code from your authenticator app, or one of your recovery codes. The request expires after five minutes.");
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if totp-passkey-offered : Button {
            text: connecting ? @tr("Waiting for the passkey…") : @tr("Use a passkey");
            enabled: !connecting;
            clicked => { passkey-second-factor-requested(); }
        }
        if totp-code-accepted : LineEdit {
            placeholder-text: @tr("Code or recovery code");
            accessible-label: @tr("Code or recovery code");
            text <=> totp-code;
            enabled: !connecting;
            init => { self.focus(); }
            accepted => { totp-verify-requested(totp-code); }
        }
        if totp-code-accepted : Button {
            text: connecting ? @tr("Verifying…") : @tr("Verify");
            enabled: !connecting && totp-code != "";
            clicked => { totp-verify-requested(totp-code); }
        }
        Button {
            text: @tr("Cancel");
            enabled: !connecting;
            clicked => { totp-cancel-requested(); }
        }
        Text {
            text: status-text();
            color: theme == "dark" ? #e57373 : #c0392b;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }
    }

    if screen == "share" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px * FontScale.percent / 100;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Sign in with a share token");
            font-size: 18px * FontScale.percent / 100;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Paste the share link or token made on another device, in Settings > Security here or \"open on another device\" in Cicchetto. It works once and expires after ten minutes.");
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        LineEdit {
            placeholder-text: @tr("Server URL");
            accessible-label: @tr("Server URL");
            text <=> server-url;
            enabled: !connecting;
        }
        share-field := LineEdit {
            placeholder-text: @tr("Share link or token");
            accessible-label: @tr("Share link or token");
            text <=> share-token-input;
            // A share token signs in as you, like a password.
            input-type: InputType.password;
            enabled: !connecting;
            init => { self.focus(); }
            accepted => {
                if !cleartext-blocked { share-consume-requested(server-url, share-token-input); }
            }
        }
        if cleartext-current != "" : CleartextNotice {
            dark: theme == "dark";
            server-cleartext: cleartext-key(server-url, "") != "";
            origin-cleartext: cleartext-key("", passkey-origin) != "";
            blocked: cleartext-blocked;
            confirm => { cleartext-confirmed = cleartext-current; }
        }
        Button {
            text: connecting ? @tr("Connecting…") : @tr("Sign in");
            enabled: !connecting && share-token-input != "" && !cleartext-blocked;
            clicked => { share-consume-requested(server-url, share-token-input); }
        }
        Button {
            text: @tr("Cancel");
            enabled: !connecting;
            clicked => { share-screen-requested(false); }
        }
        Text {
            text: status-text();
            color: theme == "dark" ? #e57373 : #c0392b;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }
    }

    if screen == "recover" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px * FontScale.percent / 100;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Sign in with a recovery code");
            font-size: 18px * FontScale.percent / 100;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("For an account that signs in with a passkey and has no password. Enter your username and one of the recovery codes Grappa showed you when you turned passwordless sign-in on. Each code works only once.");
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        LineEdit {
            placeholder-text: @tr("Server URL");
            accessible-label: @tr("Server URL");
            text <=> server-url;
            enabled: !connecting;
        }
        LineEdit {
            placeholder-text: @tr("Username");
            accessible-label: @tr("Username");
            text <=> identifier;
            enabled: !connecting;
        }
        recovery-field := LineEdit {
            placeholder-text: @tr("Recovery code");
            accessible-label: @tr("Recovery code");
            text <=> recovery-code-input;
            // A recovery code signs in as you, like a password.
            input-type: InputType.password;
            enabled: !connecting;
            init => { self.focus(); }
            accepted => {
                if !cleartext-blocked { recovery-sign-in-requested(server-url, identifier, recovery-code-input); }
            }
        }
        if cleartext-current != "" : CleartextNotice {
            dark: theme == "dark";
            server-cleartext: cleartext-key(server-url, "") != "";
            origin-cleartext: cleartext-key("", passkey-origin) != "";
            blocked: cleartext-blocked;
            confirm => { cleartext-confirmed = cleartext-current; }
        }
        Button {
            text: connecting ? @tr("Connecting…") : @tr("Sign in");
            enabled: !connecting && identifier != "" && recovery-code-input != "" && !cleartext-blocked;
            clicked => { recovery-sign-in-requested(server-url, identifier, recovery-code-input); }
        }
        Button {
            text: @tr("Cancel");
            enabled: !connecting;
            clicked => { recovery-screen-requested(false); }
        }
        Text {
            text: status-text();
            color: theme == "dark" ? #e57373 : #c0392b;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }
    }

    if screen == "connect" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px * FontScale.percent / 100;
            horizontal-alignment: center;
        }

        LineEdit {
            placeholder-text: @tr("Server URL");
            accessible-label: @tr("Server URL");
            text <=> server-url;
        }

        LineEdit {
            placeholder-text: @tr("Username");
            accessible-label: @tr("Username");
            text <=> identifier;
        }

        LineEdit {
            placeholder-text: @tr("Password or client token");
            accessible-label: @tr("Password or client token");
            text <=> password;
            // Qualified as `InputType.password`, not bare `password`: this
            // component also has a property named `password` (the text
            // itself), which would otherwise shadow the enum variant.
            input-type: InputType.password;
        }

        LineEdit {
            placeholder-text: @tr("Passkey origin (optional)");
            accessible-label: @tr("Passkey origin (optional)");
            text <=> passkey-origin;
            edited => { passkey-origin-saved = false; }
        }
        if !passkey-origin-ok : Text {
            text: @tr("That isn't an origin. Use the form https://host or https://host:port, without a path.");
            wrap: word-wrap;
            color: theme == "dark" ? #e57373 : #c0392b;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if cleartext-current != "" : CleartextNotice {
            dark: theme == "dark";
            server-cleartext: cleartext-key(server-url, "") != "";
            origin-cleartext: cleartext-key("", passkey-origin) != "";
            blocked: cleartext-blocked;
            confirm => { cleartext-confirmed = cleartext-current; }
        }

        Button {
            text: connecting ? @tr("Connecting…") : @tr("Connect");
            enabled: !connecting && passkey-origin-ok && !cleartext-blocked;
            clicked => { connect-requested(server-url, identifier, password); }
        }

        // A passwordless account: no password, a passkey for the server.
        if passkey-available : Button {
            text: @tr("Sign in with a passkey");
            enabled: !connecting && passkey-origin-ok && !cleartext-blocked && identifier != "";
            clicked => { passkey-login-requested(server-url, identifier); }
        }

        if saved-profile-identifier != "" && saved-profile-identifier == identifier && saved-profile-server-url == server-url : Button {
            text: @tr("Sign in with saved profile");
            enabled: !connecting && !cleartext-blocked;
            clicked => { saved-profile-connect-requested(server-url, identifier); }
        }

        Button {
            text: @tr("Sign in with a share token…");
            enabled: !connecting;
            clicked => { share-screen-requested(true); }
        }

        Button {
            text: @tr("Passwordless account? Sign in with a recovery code…");
            enabled: !connecting;
            clicked => { recovery-screen-requested(true); }
        }

        Button {
            text: @tr("Change language");
            clicked => { screen = "language"; }
        }

        Text {
            text: status-text();
            color: theme == "dark" ? #e57373 : #c0392b;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if known-servers.length > 0 : VerticalBox {
            padding-top: 8px;
            spacing: 4px;

            Text {
                text: @tr("Previously used servers");
                font-size: 14px * FontScale.percent / 100;
            }

            for known in known-servers : Button {
                text: known;
                accessible-label: @tr("Switch to server {}", known);
                clicked => { server-selected(known); }
            }
        }
    }

    // Directory search debounce: fires once a tick passes with no new edit.
    Timer {
        interval: 250ms;
        running: directory-search-pending;
        triggered => {
            if directory-search-seen == directory-search-edits {
                directory-search-pending = false;
                directory-search-requested(directory-query);
            } else {
                directory-search-seen = directory-search-edits;
            }
        }
    }

    // Keeps the directory's "N ago" label current while the pane is open.
    Timer {
        interval: 30s;
        running: directory-open && directory-captured-epoch != "";
        triggered => { directory-age-tick(); }
    }

    // Keeps the time left on a timed mute current while its bar is shown.
    Timer {
        interval: 15s;
        running: current-mute-active && current-mute-until != "";
        triggered => { mute-countdown-tick(); }
    }

    // Counts down the wait before the next reconnect attempt.
    Timer {
        interval: 1s;
        running: (status-kind == "reconnecting" || status-kind == "disconnected") && status-retry-secs > 0;
        triggered => { status-retry-secs -= 1; }
    }

    if screen == "connected" : HorizontalBox {
        padding: 16px;
        spacing: 8px;

        VerticalBox {
            width: max(sidebar-width, sidebar-min-width);
            spacing: 8px;

            HorizontalLayout {
                alignment: start;
                spacing: 4px;

                home-button := TopMenuButton {
                    icon: "🏠";
                    label: @tr("Home");
                    dark: theme == "dark";
                    clicked => { home-requested(); }
                }

                if is-admin : TopMenuButton {
                    icon: "🛡";
                    label: @tr("Admin");
                    dark: theme == "dark";
                    changed has-focus => { admin-button-focused = self.has-focus; }
                    clicked => {
                        screen = "settings";
                        settings-section = "admin";
                    }
                }

                debug-button := TopMenuButton {
                    icon: "🐞";
                    label: @tr("Debug");
                    dark: theme == "dark";
                    clicked => {
                        debug-requested();
                        screen = "debug";
                    }
                }

                settings-button := TopMenuButton {
                    icon: "⚙";
                    label: @tr("Settings");
                    dark: theme == "dark";
                    clicked => { screen = "settings"; }
                }

                // Signing out is how the user switches accounts: it also
                // turns off the automatic sign-in at the next launch.
                disconnect-button := TopMenuButton {
                    icon: "⏏";
                    label: @tr("Disconnect");
                    dark: theme == "dark";
                    clicked => { disconnect-requested(); }
                }
            }

            // The focused button's name, for keyboard users (hover has the
            // tooltip): a line under the icons, only while one has focus, so
            // nothing is covered.
            if home-button.has-focus || admin-button-focused || debug-button.has-focus || settings-button.has-focus || disconnect-button.has-focus : Text {
                text: home-button.has-focus ? @tr("Home")
                    : admin-button-focused ? @tr("Admin")
                    : debug-button.has-focus ? @tr("Debug")
                    : settings-button.has-focus ? @tr("Settings")
                    : @tr("Disconnect");
                font-size: 12px * FontScale.percent / 100;
                overflow: elide;
                accessible-role: none;
            }

            // Once actually signed in, this row of icons is the whole
            // story — the connecting/error/reconnecting text below only
            // shows while there's something to report, so a healthy
            // session doesn't sit under a permanent status paragraph.
            if status-kind != "signed-in" : Text {
                text: @tr("Connected to {}", server-url);
                wrap: word-wrap;
            }

            if status-kind != "signed-in" : Text {
                text: status-text();
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
                accessible-live-region: AccessibleLiveness.polite;
            }

            if window-invite-banner != "" : Rectangle {
                background: theme == "dark" ? #3a321f : #fff2bf;
                border-width: 1px;
                border-color: theme == "dark" ? #c99b2e : #b58a00;
                padding: 6px;
                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: window-invite-banner;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Join");
                        accessible-label: @tr("Join invited channel");
                        clicked => {
                            window-invite-join-requested(window-invite-network, window-invite-channel);
                        }
                    }
                    Button {
                        text: @tr("Decline");
                        accessible-label: @tr("Decline channel invite");
                        clicked => {
                            window-invite-decline-requested(window-invite-network, window-invite-channel);
                        }
                    }
                }
            }

            if recover-visible : Rectangle {
                background: theme == "dark" ? #1f2d3a : #e3f0ff;
                border-width: 1px;
                border-color: theme == "dark" ? #4a7fb0 : #3d7cc9;
                padding: 6px;
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: @tr("Identity recovery on {}", recover-network);
                        wrap: word-wrap;
                        font-weight: 700;
                        accessible-role: AccessibleRole.text;
                    }
                    for row in recover-steps : Text {
                        text: row.reason == ""
                            ? @tr("{}: {}", recover-step-label(row.step), recover-status-label(row.status))
                            : @tr("{}: {} ({})", recover-step-label(row.step), recover-status-label(row.status), recover-reason-label(row.reason));
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    if recover-outcome != "" : Text {
                        text: recover-outcome == "succeeded"
                            ? @tr("Identity recovered.")
                            : (recover-outcome-reason == ""
                                ? @tr("Recovery failed.")
                                : @tr("Recovery failed ({}).", recover-reason-label(recover-outcome-reason)));
                        wrap: word-wrap;
                        font-weight: 700;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Dismiss");
                        accessible-label: @tr("Dismiss identity recovery");
                        clicked => { recover-dismiss-requested(); }
                    }
                }
            }

            for offer in dcc-offers : Rectangle {
                background: theme == "dark" ? #2a2438 : #f0eaff;
                border-width: 1px;
                border-color: theme == "dark" ? #8a74c9 : #6b4fc0;
                padding: 6px;
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: @tr("{} offers {} ({}) on {}", offer.from, offer.filename, offer.size, offer.network);
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    HorizontalBox {
                        spacing: 4px;
                        padding: 0px;
                        Button {
                            text: @tr("Accept");
                            accessible-label: @tr("Accept {} from {}", offer.filename, offer.from);
                            clicked => { dcc-offer-accept-requested(offer.network, offer.offer-id); }
                        }
                        Button {
                            text: @tr("Refuse");
                            accessible-label: @tr("Refuse {} from {}", offer.filename, offer.from);
                            clicked => { dcc-offer-refuse-requested(offer.network, offer.offer-id); }
                        }
                    }
                }
            }

            ListView {
                vertical-stretch: 1;

                for group in network-groups : VerticalLayout {
                    alignment: start;
                    spacing: 0px;
                    padding-top: group.separator-before ? 8px : 0px;

                    if group.separator-before : Rectangle {
                        height: 1px;
                        horizontal-stretch: 1;
                        background: #808080;
                    }

                    if !group.parked : HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: group.expanded ? "▾" : "▸";
                            width: 28px;
                            accessible-label: @tr("Expand or collapse network {}", group.network);
                            clicked => { network-toggle-requested(group.network); }
                        }
                        Button {
                            horizontal-stretch: 1;
                            text: "🔌 " + group.network
                                + (group.connection-label == "" ? "" : " · " + connection-label-text(group.connection-label));
                            accessible-label: @tr("Open network messages on {}", group.network);
                            clicked => { network-selected(group.network); }
                        }
                    }
                    if group.parked : HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: group.expanded ? "▾" : "▸";
                            width: 28px;
                            accessible-label: @tr("Expand or collapse parked network {}", group.network);
                            clicked => { network-toggle-requested(group.network); }
                        }
                        Text {
                            text: @tr("{} [PARKED]", group.network);
                            font-italic: true;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                        }
                    }

                    // Channel and query rows sit directly under their
                    // network row, with no gap between them.
                    if group.expanded : VerticalLayout {
                        alignment: start;
                        padding-left: 16px;
                        spacing: 0px;

                        // Channel directory of this network (`/list`),
                        // above its channels like Cicchetto's "channels" row.
                        if !group.parked : Button {
                            horizontal-stretch: 1;
                            text: "📇 " + @tr("Channels");
                            primary: directory-open && directory-network == group.network;
                            accessible-label: @tr("Channels on {}", group.network);
                            clicked => { directory-open-requested(group.network); }
                        }

                        for entry in group.channels : HorizontalLayout {
                            spacing: 4px;

                            Button {
                                horizontal-stretch: 1;
                                text: (entry.invited ? "🔔 " : "") + entry.label + entry.mention-badge;
                                accessible-label: entry.label + entry.mentions-description
                                    + (entry.invited
                                        ? " — invited"
                                        : (entry.kicked
                                            ? " — kicked"
                                            : (entry.failed ? " — join failed" : "")));
                                // Cicchetto keeps failed and kicked channels as
                                // muted, selectable pseudo-windows; details
                                // remain in session state, not in the row.
                                opacity: (entry.failed || entry.kicked) ? 0.55 : 1.0;
                                clicked => { channel-selected(entry.network, entry.channel); }
                            }

                            if entry.unread-description != "" : Text {
                                text: entry.unread-count;
                                accessible-label: entry.unread-description;
                                accessible-role: AccessibleRole.text;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                min-width: 28px;
                                font-size: 12px * FontScale.percent / 100;
                                font-weight: 700;
                            }

                            if entry.kicked : Button {
                                text: "×";
                                accessible-label: @tr("Dismiss kicked channel {}", entry.label);
                                width: 28px;
                                clicked => {
                                    kicked-channel-dismiss-requested(entry.network, entry.channel);
                                }
                            }
                            if entry.joined : Button {
                                text: "×";
                                accessible-label: @tr("Leave channel {} on {}", entry.channel, entry.network);
                                width: 28px;
                                clicked => { channel-part-requested(entry.network, entry.channel); }
                            }
                        }

                        for query in group.queries : Button {
                            horizontal-stretch: 1;
                            text: "↳ " + query.label + query.mention-badge;
                            accessible-label: @tr("Private conversation with {} on {}", query.nick, query.network)
                                + query.mentions-description;
                            clicked => { query-selected(query.network, query.nick); }
                        }
                    }
                }
            }
        }

        ResizeHandle {
            target-width <=> sidebar-width;
            target-min-width: sidebar-min-width;
            target-max-width: max(360px, sidebar-min-width);
        }

        // Channel directory of one network: takes the chat's place, the
        // sidebar stays (Cicchetto's `$list` window).
        if directory-open : VerticalBox {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: @tr("Channels on {}", directory-network);
                    font-size: 16px * FontScale.percent / 100;
                    font-weight: 700;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                Button {
                    text: "✕";
                    width: 32px;
                    accessible-label: @tr("Close channel list");
                    clicked => {
                        directory-open = false;
                        directory-closed();
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: @tr("Search channels…");
                    accessible-label: @tr("Search channels");
                    text <=> directory-query;
                    edited => {
                        directory-search-edits += 1;
                        directory-search-pending = true;
                    }
                    accepted => {
                        directory-search-pending = false;
                        directory-search-seen = directory-search-edits;
                        directory-search-requested(directory-query);
                    }
                }
                Button {
                    text: directory-refresh-pending || directory-status == "loading" ? @tr("Refreshing…") : @tr("Refresh");
                    enabled: !directory-refresh-pending && directory-status != "loading";
                    accessible-label: @tr("Refresh the channel list of {}", directory-network);
                    clicked => { directory-refresh-requested(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: directory-total == "" ? "" : @tr("{} channels", directory-total);
                    font-weight: 700;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                }
                if directory-status != "stale" : Text {
                    text: directory-age-text();
                    color: palette-muted;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-label: directory-captured-at == "" ? self.text : @tr("Listed {}", directory-captured-at);
                }
                // A stale listing offers its own refresh, like Cicchetto.
                if directory-status == "stale" : Button {
                    text: @tr("{} — refresh now", directory-age-text());
                    enabled: !directory-refresh-pending;
                    accessible-label: @tr("Listed {}, may be out of date. Refresh now", directory-captured-at);
                    clicked => { directory-refresh-requested(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: directory-sort == "name" ? @tr("Sort: name") : @tr("Sort: users");
                    accessible-label: directory-sort == "name" ? @tr("Sorted by name; sort by users") : @tr("Sorted by users; sort by name");
                    clicked => { directory-sort-requested(directory-sort == "name" ? "users" : "name"); }
                }
            }

            if directory-failed-reason != "" : Text {
                text: @tr("The last channel listing failed ({}); showing the previous list.", directory-failed-reason);
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
                accessible-live-region: AccessibleLiveness.polite;
            }

            if directory-error != "" : HorizontalLayout {
                spacing: 8px;
                Text {
                    text: directory-error-text();
                    color: theme == "dark" ? #e57373 : #c0392b;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-live-region: AccessibleLiveness.polite;
                }
                Button {
                    text: @tr("Reload");
                    clicked => { directory-search-requested(directory-query); }
                }
            }

            if directory-empty-text() != "" : Text {
                text: directory-empty-text();
                color: palette-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }

            ListView {
                vertical-stretch: 1;
                for row in directory-rows : DirectoryEntry {
                    name: row.name;
                    topic: row.topic;
                    users: row.users;
                    featured: row.featured;
                    joined: row.joined;
                    dark: theme == "dark";
                    muted: palette-muted;
                    activated => { directory-channel-activated(row.name); }
                }
            }

            if directory-has-more : Button {
                text: @tr("Load more");
                clicked => { directory-load-more-requested(); }
            }
        }

        if !directory-open : VerticalBox {
            spacing: 8px;

            // Truncated on a narrow window; the full line stays the
            // accessible label.
            if window-status != "" : Text {
                text: window-status;
                font-size: 14px * FontScale.percent / 100;
                font-weight: 700;
                overflow: elide;
                color: palette-active ? palette-accent : Palette.foreground;
                accessible-role: AccessibleRole.text;
                accessible-label: window-status;
            }
            // The layout gives the topic the box's width, so it wraps at word
            // boundaries and the box grows to fit every line.
            if has-selected-channel && !current-query && !current-server-window : Rectangle {
                background: palette-active ? palette-bg-alt : (theme == "dark" ? #242424 : #f5f5f5);
                border-width: 1px;
                border-color: palette-active ? palette-border : (theme == "dark" ? #5c5c5c : #d0d0d0);
                clip: true;
                vertical-stretch: 0;

                VerticalLayout {
                    padding: 6px;
                    Text {
                        text: current-topic == "" ? @tr("No topic set") : current-topic;
                        font-size: 14px * FontScale.percent / 100;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                        horizontal-stretch: 1;
                    }
                }
            }
            if !current-query && window-note-kind != "" : Rectangle {
                background: theme == "dark" ? #3a2424 : #fde2e2;
                border-width: 1px;
                border-color: theme == "dark" ? #b04a4a : #c0392b;

                HorizontalBox {
                    Text {
                        text: window-note-kind == "kicked"
                            ? (window-note-actor == ""
                                ? (window-note-reason == ""
                                    ? @tr("You were kicked from this channel.")
                                    : @tr("You were kicked from this channel: {}", window-note-reason))
                                : (window-note-reason == ""
                                    ? @tr("{} kicked you from this channel.", window-note-actor)
                                    : @tr("{} kicked you from this channel: {}", window-note-actor, window-note-reason)))
                            : (window-note-reason == ""
                                ? @tr("Joining this channel failed.")
                                : @tr("Joining this channel failed: {}", window-note-reason));
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                }
            }

            if current-query && peer-away-visible : Rectangle {
                background: theme == "dark" ? #3a321f : #fff2bf;
                border-width: 1px;
                border-color: theme == "dark" ? #c99b2e : #b58a00;
                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: peer-away-message == ""
                            ? @tr("{} is away.", peer-away-peer)
                            : @tr("{} is away: {}", peer-away-peer, peer-away-message);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Dismiss");
                        accessible-label: @tr("Dismiss away message");
                        clicked => { peer-away-dismiss-requested(); }
                    }
                }
            }

            // The home page takes the chat's place when no window is open:
            // a view, not a chat, so no compose bar either (Cicchetto).
            if !has-selected-channel : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    spacing: 12px;
                    padding-right: 8px;

                    // Cancel-focused, like Cicchetto's confirm: a remove is
                    // reversible, but there's no reason to make it a mistap.
                    if home-confirm-network != "" : SectionCard {
                        icon: "⚠";
                        title: home-confirm-kind == "remove" ? @tr("Remove network") : @tr("Disconnect network");

                        Text {
                            text: home-confirm-kind == "remove"
                                ? @tr("Remove {} from your session? Your nick, login details and autojoin channels are kept — connecting it again restores them.", home-confirm-network)
                                : @tr("Disconnect from {}?", home-confirm-network);
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 6px;

                            Button {
                                text: @tr("Cancel");
                                init => { self.focus(); }
                                clicked => {
                                    home-confirm-network = "";
                                    home-confirm-kind = "";
                                }
                            }
                            Button {
                                text: home-confirm-kind == "remove" ? @tr("Remove") : @tr("Yes");
                                clicked => {
                                    if home-confirm-kind == "remove" {
                                        home-network-remove(home-confirm-network);
                                    } else {
                                        home-network-disconnect(home-confirm-network);
                                    }
                                    home-confirm-network = "";
                                    home-confirm-kind = "";
                                }
                            }
                        }
                    }

                    SectionCard {
                        icon: "🍇";
                        title: @tr("Welcome to Grappa");

                        Text {
                            text: @tr("Grappa keeps you connected to IRC even while this app is closed. Just open it and you're back in your conversations right where you left off — no reconnecting, nothing lost.");
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                        }
                        if home-session-kind != "" : Text {
                            text: home-session-text();
                            wrap: word-wrap;
                            color: palette-muted;
                            accessible-role: AccessibleRole.text;
                        }
                    }

                    SectionCard {
                        icon: "🔌";
                        title: @tr("Networks");

                        Text {
                            text: home-networks.length > 0
                                ? @tr("Below are the IRC networks you can chat on.")
                                : (home-available.length > 0
                                    ? @tr("Pick a network below to get started.")
                                    : (home-session-kind == "user"
                                        ? @tr("No networks bound. Ask the operator to bind one.")
                                        : @tr("Connecting…")));
                            wrap: word-wrap;
                            color: palette-muted;
                            accessible-role: AccessibleRole.text;
                        }

                        for row in home-networks : VerticalLayout {
                            spacing: 6px;

                            Rectangle {
                                height: 1px;
                                background: #8080806a;
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                if row.connected : Button {
                                    text: row.nick == "" ? row.network : row.network + " · " + row.nick;
                                    accessible-label: @tr("Open network messages on {}", row.network);
                                    clicked => { network-selected(row.network); }
                                }
                                if !row.connected : Text {
                                    text: row.nick == "" ? row.network : row.network + " · " + row.nick;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    accessible-role: AccessibleRole.text;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: home-state-text(row.state);
                                    color: palette-muted;
                                    vertical-alignment: center;
                                    accessible-role: AccessibleRole.text;
                                }
                                if row.connected : Button {
                                    text: @tr("Disconnect");
                                    accessible-label: @tr("Disconnect {}", row.network);
                                    clicked => {
                                        home-confirm-kind = "disconnect";
                                        home-confirm-network = row.network;
                                    }
                                }
                                if !row.connected : Button {
                                    text: row.reconnecting ? @tr("Reconnecting…") : @tr("Reconnect");
                                    enabled: !row.reconnecting;
                                    accessible-label: @tr("Reconnect {}", row.network);
                                    clicked => { home-network-reconnect(row.network); }
                                }
                                if row.can-remove : Button {
                                    text: @tr("Remove");
                                    accessible-label: @tr("Remove {}", row.network);
                                    clicked => {
                                        home-confirm-kind = "remove";
                                        home-confirm-network = row.network;
                                    }
                                }
                            }

                            if row.reason != "" : Text {
                                text: row.reason;
                                wrap: word-wrap;
                                color: palette-muted;
                                accessible-role: AccessibleRole.text;
                            }
                            if row.error != "" : Text {
                                text: home-error-text(row.error, row.network);
                                wrap: word-wrap;
                                color: theme == "dark" ? #e57373 : #c0392b;
                                accessible-role: AccessibleRole.text;
                                accessible-live-region: AccessibleLiveness.polite;
                            }
                            if row.can-recover : HorizontalLayout {
                                alignment: start;

                                Button {
                                    text: "🔑 " + @tr("Recover identity");
                                    clicked => { home-network-recover(row.network); }
                                }
                            }
                            if row.featured.length > 0 : Text {
                                text: @tr("Channels worth a look on {}:", row.network);
                                font-weight: 600;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                            }
                            for link in row.featured : HorizontalLayout {
                                alignment: start;

                                Button {
                                    text: link.description == "" ? link.name : link.name + " — " + link.description;
                                    accessible-label: @tr("Open {} on {}", link.name, row.network);
                                    clicked => { home-featured-open(row.network, link.name); }
                                }
                            }
                            if row.featured-error != "" : Text {
                                text: @tr("Couldn't join {}.", row.featured-error);
                                wrap: word-wrap;
                                color: theme == "dark" ? #e57373 : #c0392b;
                                accessible-role: AccessibleRole.text;
                                accessible-live-region: AccessibleLiveness.polite;
                            }
                        }
                    }

                    if home-available.length > 0 : SectionCard {
                        icon: "➕";
                        title: @tr("Available to connect");

                        Text {
                            text: @tr("Pick a network to connect and start chatting on it.");
                            wrap: word-wrap;
                            color: palette-muted;
                            accessible-role: AccessibleRole.text;
                        }
                        for slug in home-available : HorizontalLayout {
                            alignment: start;

                            Button {
                                text: home-connecting == slug ? @tr("Connecting {}…", slug) : "+ " + slug;
                                enabled: home-connecting == "";
                                accessible-label: @tr("Connect {}", slug);
                                clicked => { home-network-connect(slug); }
                            }
                        }
                        if home-available-error != "" : Text {
                            text: home-error-text(home-available-error, home-available-error-network);
                            wrap: word-wrap;
                            color: theme == "dark" ? #e57373 : #c0392b;
                            accessible-role: AccessibleRole.text;
                            accessible-live-region: AccessibleLiveness.polite;
                        }
                    }
                }
            }

            if has-selected-channel : chat-list := ListView {
                vertical-stretch: 1;

                // Whether the pane should keep chasing the newest line.
                // Slint's `ListView` virtualizes its rows and estimates the
                // total scrolled content height from the average height of
                // the rows it currently has instantiated (see Slint's
                // `internal/core/model/repeater.rs`,
                // `update_visible_instances`); with the word-wrapping,
                // variable-height rows here that estimate shifts on almost
                // every update, so `content-y` alone can't tell "at the
                // bottom" from "estimate drifted". Track intent explicitly
                // instead: true until the user scrolls away from the
                // bottom, so their scroll position (up or down) is always
                // respected.
                property <bool> follow-bottom <=> chat-follow-bottom;
                content-y <=> chat-scroll-y;

                // Older history: asked for when the reader gets within a
                // third of a screen of the oldest loaded line, and while
                // the loaded lines don't even fill the pane (there is
                // nothing to scroll then). `older-armed` allows one
                // request per arrival at the top: a page that lands
                // re-arms it, a failed one waits for the reader to leave
                // the top and come back, or to press PgUp.
                property <bool> older-armed: true;
                property <bool> near-top: self.content-y >= -self.visible-height / 3;

                function load-older() {
                    if older-armed && !history-loading && !history-start-reached && chat-lines.length > 0 {
                        older-armed = false;
                        history-loading = true;
                        older-history-requested();
                    }
                }

                property <bool> loading: history-loading;
                changed loading => {
                    if !loading && !history-failed {
                        older-armed = true;
                        if self.content-height <= self.visible-height {
                            load-older();
                        }
                    }
                }

                // A fresh pane opens on the newest line, unless it is the
                // same window's pane coming back from another screen with
                // the reader scrolled up: then Rust picks the line to go
                // back to, and `changed content-height` below puts it back
                // once the rows are measured. Until then the pane sits at
                // the top, so that first layout doesn't depend on the old
                // scroll position.
                property <bool> resuming: false;
                init => {
                    if chat-resume && chat-pane-label == current-channel-label {
                        resuming = chat-resume-requested();
                    }
                    if resuming {
                        chat-scroll-y = 0px;
                    } else {
                        chat-follow-bottom = true;
                    }
                    chat-resume = false;
                    chat-pane-label = current-channel-label;
                }

                // A programmatic jump to the top (PgUp) makes the `ListView`
                // lay the first rows out from its average-height estimate,
                // which can leave `content-y` above zero: a blank band over
                // the oldest line. Pull it back flush.
                changed content-y => {
                    if self.content-y > 0px {
                        self.content-y = 0px;
                    }
                }

                // PgUp/PgDown from the compose box: nine tenths of a screen
                // per press, so a line of context stays in view.
                property <int> page-seq: chat-page-seq;
                changed page-seq => {
                    let bottom = min(0px, self.visible-height - self.content-height);
                    self.content-y = max(bottom, min(0px, self.content-y - chat-page-direction * self.visible-height * 0.9));
                    self.follow-bottom = self.content-y <= bottom + 4px;
                    if self.near-top {
                        older-armed = true;
                        load-older();
                    }
                }

                // Fires only for a genuine user-driven scroll (wheel, drag,
                // scrollbar) — not for the programmatic `content-y` writes
                // below, which go through a plain property set rather than
                // Flickable's input-event path. `content-y` is 0 at the top
                // and increasingly negative going down; a few pixels of
                // slack absorb the height-estimate's own imprecision.
                scrolled => {
                    self.follow-bottom = self.content-y <= self.visible-height - self.content-height + 4px;
                    if self.near-top {
                        load-older();
                    } else if history-failed {
                        older-armed = true;
                    }
                }

                // The height estimate above is recomputed — and
                // `content-height` changes — after essentially every chat
                // update (a new line, a history page, an edit, a theme
                // re-render...), not just once. Re-snap to the bottom each
                // time while following, so a wrapped or newly-measured row
                // never leaves a gap under the newest line; once the
                // estimate settles the next change is a no-op.
                changed content-height => {
                    chat-content-height = self.content-height;
                    chat-content-rows = chat-lines.length;
                    if resuming {
                        resuming = false;
                        chat-resume-landed();
                    } else if self.follow-bottom {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                    if self.content-height <= self.visible-height {
                        load-older();
                    }
                }

                // `current-channel-label` only changes when Rust swaps in a
                // different window's history (channel/query switch, or the
                // pane being cleared) — never for a same-window refresh
                // (a live message, a history page, an edit, a theme
                // re-render). That makes it the right signal to force the
                // pane back to the bottom regardless of where it was
                // scrolled: a freshly opened window should always open on
                // its newest line. Mirrored into a local property first,
                // rather than a `changed current-channel-label` directly on
                // this nested element: only a property that's local to the
                // element (even one that just forwards an ancestor's,
                // like this) is a valid `changed` target.
                property <string> window-label: current-channel-label;
                changed window-label => {
                    chat-pane-label = window-label;
                    resuming = false;
                    self.follow-bottom = true;
                    older-armed = true;
                    self.content-y = min(0px, self.visible-height - self.content-height);
                }

                for line[line-index] in chat-lines : Rectangle {
                    // Cicchetto's flat mention background; the row a
                    // mention jump landed on is tinted over it.
                    background: line-index == chat-highlight-row
                        ? #3b82f666
                        : !line.mention
                        ? transparent
                        : palette-active
                        ? palette-mention.with-alpha(0.25)
                        : (theme == "dark" ? #6b5a0066 : #fff2b3);

                    HorizontalLayout {
                        alignment: start;
                        spacing: 0px;

                        Text {
                            text: "[" + line.timestamp + "] ";
                            color: line.timestamp-color;
                            font-italic: line.italic;
                        }

                        if line.nick != "" : MemberContextMenu {
                            target-nick: line.nick;
                            is-chat-message: true;
                            reply-body: line.reply-body;
                            can-moderate: can-moderate-members;
                            display-text: "<" + line.nick-prefix + line.nick + "> ";
                            text-color: line.nick-color;
                            text-bold: true;
                            text-italic: line.italic;
                            mode-action(verb, nick) => { member-mode-action-requested(verb, nick); }
                            kick(nick) => { member-kick-requested(nick); }
                            ban(nick) => { member-ban-requested(nick); }
                            whois(nick) => { member-whois-requested(nick); }
                            ctcp(nick, verb) => { member-ctcp-requested(nick, verb); }
                            query(nick) => { member-query-requested(nick); }
                            reply(nick, body) => {
                                reply-to-message-requested(nick, body);
                                compose-focus-request += 1;
                            }
                        }

                        StyledText {
                            text: line.body;
                            default-color: theme == "dark" ? white : black;
                            link-color: palette-active ? palette-accent : (theme == "dark" ? #8ab4f8 : #1a5fb4);
                            horizontal-stretch: 1;
                            link-clicked(href) => { chat-link-clicked(href); }
                        }
                    }
                }
            }

            // The radio on air, docked above the compose bar like
            // Cicchetto's mini-player.
            if radio-status != "" : HorizontalLayout {
                spacing: 8px;
                padding-left: 6px;
                padding-right: 6px;

                Text {
                    text: (radio-upload ? "🎵  " : "📻  ") + (radio-status == "connecting"
                        ? @tr("{}: connecting…", radio-station)
                        : radio-status == "failed"
                        ? @tr("{}: the stream failed ({})", radio-station, radio-error)
                        : radio-status == "ended"
                        ? @tr("{}: the station ended the stream", radio-station)
                        : radio-status == "finished"
                        ? @tr("{}: finished", radio-station)
                        : radio-track == ""
                        ? radio-station
                        : radio-station + " — " + radio-track);
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Slider {
                    minimum: 0;
                    maximum: 100;
                    value: radio-volume;
                    width: 100px;
                    released(value) => {
                        radio-volume = Math.round(value);
                        radio-volume-changed(radio-volume);
                    }
                }
                CompactButton {
                    text: "⏹";
                    a11y-label: @tr("Stop the radio");
                    clicked => { radio-stop(); }
                }
            }

            // The open conversation is muted: when and, for a timed mute,
            // when it ends, with a button to lift it now.
            if has-selected-channel && current-mute-active : HorizontalLayout {
                spacing: 6px;
                padding-left: 6px;
                padding-right: 6px;

                TopMenuButton {
                    icon: "🔔";
                    label: @tr("Unmute now");
                    dark: theme == "dark";
                    clicked => { notification-unmute(current-mute-key); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #8080806a;
                    background: #8080800d;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: "🔕  " + mute-bar-text();
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            // Small compose bar, never more than one line tall: paperclip
            // to attach a file (left, like Cicchetto), text field, send
            // icon (right).
            if has-selected-channel : HorizontalBox {
                height: 40px;
                spacing: 6px;

                Button {
                    text: "📎";
                    accessible-label: @tr("Attach file");
                    width: 36px;
                    enabled: (!current-query || current-query-ready) && !current-server-window;
                    clicked => { attach-file-requested(); }
                }

                FocusScope {
                    horizontal-stretch: 1;
                    capture-key-pressed(event) => {
                        if (event.modifiers.control || event.modifiers.meta) && (event.text == "v" || event.text == "V") && !event.modifiers.shift {
                            return paste-requested() ? EventResult.accept : EventResult.reject;
                        }
                        // PgUp/PgDown page the chat pane, as in terminal IRC
                        // clients; the single-line field has no use for them.
                        if event.text == Key.PageUp || event.text == Key.PageDown {
                            chat-page-direction = event.text == Key.PageUp ? -1 : 1;
                            chat-page-seq += 1;
                            return EventResult.accept;
                        }
                        // Nick completion instead of the default
                        // focus-traversal behaviour of Tab. Most backends
                        // report Shift+Tab as `Key.Tab` with the shift
                        // modifier set, but some (e.g. X11/xkb) send the
                        // dedicated `Key.Backtab` instead — handle both.
                        // Always accepted (even with nothing to complete) so
                        // Tab never kicks focus out of the compose box.
                        if event.text == Key.Tab || event.text == Key.Backtab {
                            let forward = event.text == Key.Tab && !event.modifiers.shift;
                            let completed = nick-complete-requested(forward);
                            if completed != compose-text {
                                compose-text = completed;
                                // The LineEdit interface has no caret getter
                                // (confirmed against Slint 1.18's
                                // LineEditInterface), so completion is only
                                // ever done against the last word of the
                                // text as if the caret were at the end; put
                                // it there for real once the text changes.
                                // Byte offsets past the end are clamped by
                                // TextInput, not an out-of-bounds panic.
                                compose-line-edit.set-selection-offsets(2147483647, 2147483647);
                            }
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }

                    // A layout, so the scope takes the field's size.
                    HorizontalLayout {
                        compose-line-edit := LineEdit {
                            property <int> focus-request: compose-focus-request;
                            changed focus-request => {
                                if focus-request > 0 {
                                    self.focus();
                                    self.set-selection-offsets(2147483647, 2147483647);
                                }
                            }
                            placeholder-text: current-server-window ? @tr("Command") : @tr("Message");
                            accessible-label: current-server-window ? @tr("Command") : @tr("Message");
                            text <=> compose-text;
                            enabled: !current-query || current-query-ready;
                            accepted => { send-chat-message(compose-text); }
                            edited(new-text) => { compose-text-changed(new-text); }
                        }
                    }
                }

                Button {
                    text: "➤";
                    accessible-label: @tr("Send");
                    width: 36px;
                    enabled: current-query ? current-query-ready : has-selected-channel;
                    clicked => { send-chat-message(compose-text); }
                }
            }
        }

        // Always present on the "connected" screen, not just once a
        // channel is open: the "actions" row at its bottom (global nav,
        // not per-member) doesn't depend on a channel selection at all,
        // and hiding the whole column also hid it.
        ResizeHandle {
            target-width <=> members-width;
            target-min-width: members-min-width;
            target-max-width: max(320px, members-min-width);
        }

        VerticalBox {
            width: max(members-width, members-min-width);
            spacing: 4px;

            if current-window-is-joined && !current-query : Text {
                text: @tr("Members ({})", channel-members.length);
                font-size: 14px * FontScale.percent / 100;
            }

            if current-window-is-joined && !current-query : ListView {
                vertical-stretch: 1;

                for member in channel-members : MemberContextMenu {
                    target-nick: member.name;
                    can-moderate: can-moderate-members;
                    prefix-text: member.prefix == "" ? "" : "[" + member.prefix + "] ";
                    prefix-color: member.prefix-color;
                    display-text: member.name;
                    text-color: member.color;
                    mode-action(verb, nick) => { member-mode-action-requested(verb, nick); }
                    kick(nick) => { member-kick-requested(nick); }
                    ban(nick) => { member-ban-requested(nick); }
                    whois(nick) => { member-whois-requested(nick); }
                    ctcp(nick, verb) => { member-ctcp-requested(nick, verb); }
                    query(nick) => { member-query-requested(nick); }
                }
            }

            // Keep the global Actions row anchored at the bottom even when
            // the selected window isn't joined and the roster is hidden.
            if !current-window-is-joined || current-query : Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            // Cicchetto's own bottom-of-members-column "actions" row (a
            // plain click, not a right-click, unlike `MemberContextMenu`)
            // — confirmed against its real source and the user's own
            // screenshot: a global nav/utility menu, not a per-member one.
            // Only lists what Cordiale actually has; Cicchetto's version
            // also has the radio.
            HorizontalLayout {
                alignment: start;

                Button {
                    text: "☰ " + @tr("Actions") + " ▾";
                    clicked => { actions-menu-area.show({ x: 0px, y: 0px }); }
                }

                actions-menu-area := ContextMenuArea {
                    Menu {
                        MenuItem { title: "🏠  " + @tr("Home"); activated => { home-requested(); } }
                        MenuItem { title: "🚪  " + @tr("Rooms"); activated => { menu-command("/list"); } }
                        MenuItem { title: "📂  " + @tr("Archive"); activated => { menu-command("/archive"); } }
                        MenuItem { title: "👤  " + @tr("User modes"); activated => { menu-command("/umode"); } }
                        MenuItem {
                            title: "🐞  " + @tr("Debug");
                            activated => {
                                debug-requested();
                                screen = "debug";
                            }
                        }
                        MenuItem { title: "⚙  " + @tr("Settings"); activated => { screen = "settings"; } }
                        MenuItem {
                            title: "🎨  " + @tr("Themes");
                            activated => {
                                screen = "settings";
                                settings-section = "themes";
                            }
                        }
                        MenuItem { title: "📻  " + @tr("Radio"); activated => { screen = "radio"; } }
                        if is-admin : MenuItem {
                            title: "🛡  " + @tr("Admin");
                            activated => {
                                screen = "settings";
                                settings-section = "admin";
                            }
                        }
                        if has-selected-channel && !current-query && !current-server-window : MenuItem {
                            title: (current-denoise ? "☑" : "☐") + "  " + @tr("Denoise");
                            activated => { denoise-requested(); }
                        }
                        Menu {
                            title: "🔕  " + @tr("Mute this conversation");
                            MenuItem { title: @tr("For 1 hour"); activated => { mute-current-requested(3600); } }
                            MenuItem { title: @tr("For 8 hours"); activated => { mute-current-requested(28800); } }
                            MenuItem { title: @tr("Until I unmute it"); activated => { mute-current-requested(0); } }
                        }
                        MenuItem { title: "🔁  " + @tr("Switch account"); activated => { disconnect-requested(); } }
                    }
                }
            }
        }
    }

    if screen == "settings" : HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // Section navigation, in Cicchetto's Settings drawer order. Each
        // entry carries an icon matching what the section is for.
        VerticalLayout {
            width: 210px;
            spacing: 2px;
            alignment: start;

            Text {
                text: @tr("Settings");
                font-size: 18px * FontScale.percent / 100;
                font-weight: 600;
            }
            Rectangle { height: 6px; }

            NavButton {
                icon: "⚙";
                label: @tr("General");
                selected: settings-section == "general";
                clicked => { settings-section = "general"; }
            }
            NavButton {
                icon: "🖥";
                label: @tr("Display");
                selected: settings-section == "display";
                clicked => { settings-section = "display"; }
            }
            NavButton {
                icon: "🔒";
                label: @tr("Security");
                selected: settings-section == "security";
                clicked => {
                    settings-section = "security";
                    security-totp-requested();
                    security-passkeys-requested();
                }
            }
            NavButton {
                icon: "🎨";
                label: @tr("Themes");
                selected: settings-section == "themes";
                clicked => { settings-section = "themes"; }
            }
            NavButton {
                icon: "📻";
                label: @tr("Radio");
                selected: settings-section == "radio";
                clicked => { settings-section = "radio"; }
            }
            NavButton {
                icon: "🔔";
                label: @tr("Notifications");
                selected: settings-section == "push";
                clicked => {
                    settings-section = "push";
                    notification-prefs-requested();
                }
            }
            NavButton {
                icon: "👁";
                label: @tr("Watch Lists");
                selected: settings-section == "watchlists";
                clicked => { settings-section = "watchlists"; }
            }
            NavButton {
                icon: "🚫";
                label: @tr("Ignore List");
                selected: settings-section == "ignores";
                clicked => { settings-section = "ignores"; }
            }
            NavButton {
                icon: "↪";
                label: @tr("Aliases");
                selected: settings-section == "aliases";
                clicked => { settings-section = "aliases"; }
            }
            NavButton {
                icon: "▶";
                label: @tr("On-Connect Commands");
                selected: settings-section == "perform";
                clicked => { settings-section = "perform"; }
            }
            NavButton {
                icon: "🌐";
                label: @tr("Source Address");
                selected: settings-section == "vhost";
                clicked => { settings-section = "vhost"; }
            }
            if is-admin : NavButton {
                icon: "🛡";
                label: @tr("Admin");
                selected: settings-section == "admin";
                clicked => { settings-section = "admin"; }
            }
            NavButton {
                icon: "ℹ";
                label: @tr("Credits");
                selected: settings-section == "credits";
                clicked => { settings-section = "credits"; }
            }
            Rectangle { height: 10px; }
            NavButton {
                icon: "←";
                label: @tr("Back");
                clicked => { screen = "connected"; }
            }
        }

        Rectangle {
            width: 1px;
            background: #8080804d;
        }

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            if settings-section == "general" : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;

                SectionCard {
                    icon: "🗣";
                    title: @tr("Language");

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CompactButton {
                            text: "English";
                            clicked => { language-selected("en"); }
                        }
                        CompactButton {
                            text: "Italiano";
                            clicked => { language-selected("it"); }
                        }
                        CompactButton {
                            text: "Français";
                            clicked => { language-selected("fr"); }
                        }
                        CompactButton {
                            text: "Deutsch";
                            clicked => { language-selected("de"); }
                        }
                        CompactButton {
                            text: "Español";
                            clicked => { language-selected("es"); }
                        }
                    }
                }

                SectionCard {
                    icon: "🌓";
                    title: @tr("Theme");

                    CompactButton {
                        text: theme == "light" ? @tr("Switch to dark") : @tr("Switch to light");
                        clicked => { theme-toggle-requested(); }
                    }
                }

                if personal-prefs-loaded : SectionCard {
                    icon: "💤";
                    title: @tr("Away and leave messages");

                    Text {
                        text: @tr("Leave a field empty to use the server's default.");
                        wrap: word-wrap;
                    }
                    LineEdit {
                        placeholder-text: @tr("Quit/part message");
                        accessible-label: @tr("Quit/part message");
                        text <=> edit-leave-message;
                    }
                    LineEdit {
                        placeholder-text: @tr("Auto-away message");
                        accessible-label: @tr("Auto-away message");
                        text <=> edit-away-message;
                    }
                    if away-nick-suffix-supported : LineEdit {
                        placeholder-text: @tr("Nick suffix while auto-away (e.g. |away)");
                        accessible-label: @tr("Nick suffix while auto-away");
                        text <=> edit-away-nick-suffix;
                    }
                    if away-nick-suffix-supported : Text {
                        text: @tr("Only automatic away renames you, never /away. Grappa skips the rename when the nick would be too long for the network and keeps the suffix if your bare nick was taken meanwhile, so the nick shown is always the one the network reports.");
                        wrap: word-wrap;
                        color: palette-muted;
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: @tr("Auto-away after (seconds, 0 = off)");
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            accessible-label: @tr("Auto-away after (seconds, 0 = off)");
                            text <=> edit-away-delay;
                            input-type: number;
                            horizontal-stretch: 0;
                            min-width: 90px;
                        }
                    }
                    CheckBox {
                        text: @tr("Look up other users' profiles (CTCP USERINFO)");
                        checked <=> pref-show-peer-profiles;
                    }
                    CompactButton {
                        text: "💾  " + @tr("Save");
                        a11y-label: @tr("Save");
                        clicked => { personal-prefs-save-requested(); }
                    }
                }

                if upload-prefs-loaded : SectionCard {
                    icon: "📎";
                    title: @tr("Uploads");

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: @tr("Keep uploaded files for");
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        ComboBox {
                            model: [
                                @tr("Server default"),
                                @tr("1 hour"),
                                @tr("12 hours"),
                                @tr("1 day"),
                                @tr("3 days")
                            ];
                            current-index <=> pref-upload-ttl-index;
                            horizontal-stretch: 0;
                            min-width: 140px;
                            selected => { upload-prefs-changed(); }
                        }
                    }
                    CheckBox {
                        text: @tr("Ask before uploading");
                        checked <=> pref-upload-confirm;
                        toggled => { upload-prefs-changed(); }
                    }
                }

                SectionCard {
                    icon: "🔌";
                    title: @tr("Connection");

                    CompactButton {
                        text: "⏏  " + @tr("Disconnect");
                        a11y-label: @tr("Disconnect");
                        clicked => { disconnect-requested(); }
                    }

                    if server-upload-limits-known : Text {
                        text: server-upload-limits.video-seconds == ""
                            ? @tr("Server upload limits ({}): images {}, videos {}, documents {}, audio {}.", server-upload-limits.host, server-upload-limits.image, server-upload-limits.video, server-upload-limits.document, server-upload-limits.audio)
                            : @tr("Server upload limits ({}): images {}, videos {} (up to {} s), documents {}, audio {}.", server-upload-limits.host, server-upload-limits.image, server-upload-limits.video, server-upload-limits.video-seconds, server-upload-limits.document, server-upload-limits.audio);
                        wrap: word-wrap;
                    }
                }

                if known-networks.length > 0 : SectionCard {
                    icon: "🪪";
                    title: @tr("Network identity");

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        for network in known-networks : NavButton {
                            icon: "🌐";
                            label: network;
                            selected: settings-network == network;
                            clicked => {
                                settings-network = network;
                                settings-network-selected(network);
                            }
                        }
                    }
                    LineEdit {
                        placeholder-text: @tr("Nickname");
                        accessible-label: @tr("Nickname");
                        text <=> identity-nick;
                    }
                    LineEdit {
                        placeholder-text: @tr("Ident");
                        accessible-label: @tr("Ident");
                        text <=> identity-ident;
                    }
                    LineEdit {
                        placeholder-text: @tr("Real name");
                        accessible-label: @tr("Real name");
                        text <=> identity-realname;
                    }
                    CheckBox {
                        text: @tr("Accept DCC files from open private conversations automatically");
                        checked <=> pref-dcc-auto-accept;
                        enabled: settings-network != "";
                        toggled => { dcc-auto-accept-toggled(self.checked); }
                    }
                    CompactButton {
                        text: "💾  " + @tr("Save");
                        a11y-label: @tr("Save");
                        enabled: settings-network != "";
                        clicked => { identity-save-requested(); }
                    }
                }

                if known-networks.length > 0 : SectionCard {
                    icon: "👤";
                    title: @tr("Network profile");

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        for network in known-networks : NavButton {
                            icon: "🌐";
                            label: network;
                            selected: settings-network == network;
                            clicked => {
                                settings-network = network;
                                settings-network-selected(network);
                            }
                        }
                    }
                    Text {
                        text: @tr("What other people see when they look you up. Each field holds at most 100 bytes; leave one empty to clear it.");
                        wrap: word-wrap;
                    }
                    LineEdit {
                        placeholder-text: @tr("Age");
                        accessible-label: @tr("Age");
                        text <=> profile-age;
                    }
                    ComboBox {
                        model: [
                            @tr("Gender: not set"),
                            @tr("Male"),
                            @tr("Female"),
                            @tr("Non-binary")
                        ];
                        current-index <=> profile-gender-index;
                        accessible-label: @tr("Gender");
                    }
                    LineEdit {
                        placeholder-text: @tr("Location");
                        accessible-label: @tr("Location");
                        text <=> profile-location;
                    }
                    LineEdit {
                        placeholder-text: @tr("Languages");
                        accessible-label: @tr("Languages");
                        text <=> profile-languages;
                    }
                    LineEdit {
                        placeholder-text: @tr("Custom");
                        accessible-label: @tr("Custom");
                        text <=> profile-custom;
                    }
                    CompactButton {
                        text: "💾  " + @tr("Save profile");
                        a11y-label: @tr("Save profile");
                        enabled: settings-network != "";
                        clicked => { profile-save-requested(); }
                    }
                    Text {
                        text: profile-has-avatar
                            ? @tr("You have an avatar on this network.")
                            : @tr("You have no avatar on this network.");
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        CompactButton {
                            text: "🖼  " + @tr("Choose avatar…");
                            a11y-label: @tr("Choose avatar");
                            enabled: settings-network != "";
                            clicked => { avatar-pick-requested(); }
                        }
                        CompactButton {
                            text: @tr("Remove avatar");
                            enabled: settings-network != "" && profile-has-avatar;
                            clicked => { avatar-remove-requested(); }
                        }
                    }
                }
            }

            if settings-section == "display" : SectionCard {
                icon: "🖥";
                title: display-prefs-loaded ? @tr("Display preferences") : @tr("Loading…");

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Font size: {}%", font-size-percent);
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 50;
                        maximum: 150;
                        step: 5;
                        value: font-size-percent;
                        accessible-label: @tr("Font size");
                        horizontal-stretch: 1;
                        changed(value) => { font-size-percent = Math.round(value); }
                        released(value) => {
                            font-size-percent = Math.round(value);
                            font-size-changed(font-size-percent);
                        }
                    }
                    Button {
                        text: @tr("Reset");
                        clicked => {
                            font-size-percent = 100;
                            font-size-changed(100);
                        }
                    }
                }

                CheckBox {
                    text: @tr("Colored nicklist");
                    checked <=> pref-colored-nicklist;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Bold mentions");
                    checked <=> pref-bold-mentions;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Strip formatting");
                    checked <=> pref-strip-formatting;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Show event badge");
                    checked <=> pref-show-event-badge;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Show bottom bar");
                    checked <=> pref-show-bottom-bar;
                    toggled => { display-prefs-changed(); }
                }
                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("Date format");
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    ComboBox {
                        model: [
                            @tr("Automatic ({})", date-format-examples[0]),
                            @tr("Day/month/year ({})", date-format-examples[1]),
                            @tr("Month/day/year ({})", date-format-examples[2]),
                            @tr("Year-month-day ({})", date-format-examples[3])
                        ];
                        current-index <=> pref-date-format-index;
                        horizontal-stretch: 0;
                        min-width: 220px;
                        selected => {
                            pref-date-format-set = true;
                            display-prefs-changed();
                        }
                    }
                }
                Text {
                    text: @tr("Automatic follows the language of Cordiale.");
                    wrap: word-wrap;
                    color: palette-muted;
                }
            }

            if settings-section == "security" : SectionCard {
                icon: "🔒";
                title: @tr("Security");

                Text {
                    text: @tr("Two-factor authentication (TOTP)");
                    font-weight: 600;
                }
                Text {
                    text: security-totp-state == "enabled" ? @tr("Enabled: signing in with the password also asks for a code from your authenticator app.")
                        : security-totp-state == "disabled" ? @tr("Not enabled.")
                        : security-totp-state == "visitor" ? @tr("Two-factor authentication belongs to Grappa accounts. A guest or visitor session doesn't have one.")
                        : security-totp-state == "client-token" ? @tr("Cordiale is signed in with a per-client token, which Grappa keeps away from second factors. Sign in with your password to manage TOTP here, or use Cicchetto.")
                        : security-totp-state == "unavailable" ? @tr("Couldn't read the two-factor status.")
                        : @tr("Loading…");
                    wrap: word-wrap;
                }

                // Enrolment and disabling both re-authenticate with the
                // account password; either one signs out the account's other
                // browser sessions (per-client tokens survive).
                if (security-totp-state == "disabled" && security-totp-step == "") || security-totp-state == "enabled" : VerticalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Account password");
                        accessible-label: @tr("Account password");
                        text <=> security-password;
                        input-type: InputType.password;
                    }
                    Text {
                        text: @tr("This signs out your other browser sessions; per-client tokens keep working.");
                        wrap: word-wrap;
                        color: palette-muted;
                    }
                    HorizontalLayout {
                        alignment: start;

                        if security-totp-state == "disabled" : Button {
                            text: @tr("Set up two-factor authentication");
                            enabled: !security-totp-busy && security-password != "";
                            clicked => { security-totp-start(security-password); }
                        }
                        if security-totp-state == "enabled" : Button {
                            text: @tr("Turn off two-factor authentication");
                            enabled: !security-totp-busy && security-password != "";
                            clicked => { security-totp-disable(security-password); }
                        }
                    }
                }

                if security-totp-step == "enroll" : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: @tr("Scan the code with your authenticator app, or enter the key by hand, then type the 6-digit code it shows.");
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;

                        Image {
                            source: security-totp-qr;
                            width: 192px;
                            height: 192px;
                            image-rendering: pixelated;
                            accessible-role: AccessibleRole.image;
                            accessible-label: @tr("QR code for your authenticator app");
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: security-totp-secret;
                            font-family: "monospace";
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        CompactButton {
                            text: "📋  " + @tr("Copy key");
                            clicked => { copy-text-requested(security-totp-secret); }
                        }
                        CompactButton {
                            text: "📋  " + @tr("Copy link");
                            clicked => { copy-text-requested(security-totp-uri); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("6-digit code");
                            accessible-label: @tr("6-digit code");
                            text <=> security-totp-code;
                            horizontal-stretch: 1;
                            accepted => { security-totp-confirm(security-totp-code); }
                        }
                        Button {
                            text: @tr("Confirm");
                            enabled: !security-totp-busy && security-totp-code != "";
                            clicked => { security-totp-confirm(security-totp-code); }
                        }
                        Button {
                            text: @tr("Cancel");
                            enabled: !security-totp-busy;
                            clicked => { security-totp-done(); }
                        }
                    }
                }

                if security-totp-step == "codes" : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: @tr("Two-factor authentication is on. Keep these recovery codes somewhere safe: each works once in place of a code, and they won't be shown again.");
                        wrap: word-wrap;
                        font-weight: 600;
                    }
                    for code in security-recovery-codes : Text {
                        text: code;
                        font-family: "monospace";
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CompactButton {
                            text: "📋  " + @tr("Copy codes");
                            clicked => { security-copy-recovery-codes(); }
                        }
                        Button {
                            text: @tr("I've saved them");
                            clicked => { security-totp-done(); }
                        }
                    }
                }

                if security-totp-error != "" : Text {
                    text: security-totp-error == "wrong-password" ? @tr("Wrong password.")
                        : security-totp-error == "invalid-code" ? @tr("That code isn't valid, or the setup expired: check the clock on your device, or start again.")
                        : security-totp-error == "already-enabled" ? @tr("Two-factor authentication is already on.")
                        : security-totp-error == "client-token" ? @tr("A per-client token can't change second factors.")
                        : security-totp-error == "throttled" ? @tr("Too many attempts. Wait a few minutes before trying again.")
                        : @tr("Couldn't update two-factor authentication.");
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }

                Text {
                    text: @tr("Share this session");
                    font-weight: 600;
                }
                Text {
                    text: @tr("Make a single-use link or QR code that signs another device, such as Cicchetto on a phone, into this same account. It expires after ten minutes.");
                    wrap: word-wrap;
                }
                if security-share-link == "" : HorizontalLayout {
                    alignment: start;

                    Button {
                        text: security-share-busy ? @tr("Creating…") : @tr("Create a share link");
                        enabled: !security-share-busy;
                        clicked => { security-share-requested(); }
                    }
                }
                if security-share-link != "" : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: @tr("Open this link, or scan the code, on the other device. Anyone who has it can sign in as you until it is used or expires, so don't post it.");
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;

                        Image {
                            source: security-share-qr;
                            width: 192px;
                            height: 192px;
                            image-rendering: pixelated;
                            accessible-role: AccessibleRole.image;
                            accessible-label: @tr("QR code of the share link");
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            text: security-share-link;
                            read-only: true;
                            accessible-label: @tr("Share link");
                            horizontal-stretch: 1;
                        }
                        CompactButton {
                            text: "📋  " + @tr("Copy link");
                            clicked => { copy-text-requested(security-share-link); }
                        }
                    }
                    Text {
                        text: security-share-expires == "" ? @tr("It works once, within ten minutes.")
                            : @tr("It works once, until {}.", security-share-expires);
                        wrap: word-wrap;
                        color: palette-muted;
                    }
                    HorizontalLayout {
                        alignment: start;

                        Button {
                            text: @tr("Hide link");
                            clicked => { security-share-done(); }
                        }
                    }
                }
                if security-share-error != "" : Text {
                    text: security-share-error == "client-token" ? @tr("A per-client token can't share the session. Sign in with your password to do that here.")
                        : security-share-error == "incognito" ? @tr("An incognito guest session can't be shared.")
                        : security-share-error == "throttled" ? @tr("Too many attempts. Wait a few minutes before trying again.")
                        : @tr("Couldn't create a share link.");
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }

                Text {
                    text: @tr("Passkeys");
                    font-weight: 600;
                }
                Text {
                    text: security-passkey-state == "visitor" ? @tr("Passkeys belong to Grappa accounts. A guest or visitor session doesn't have any.")
                        : security-passkey-state == "client-token" ? @tr("Cordiale is signed in with a per-client token, which Grappa keeps away from passkeys. Sign in with your password to see them here, or use Cicchetto.")
                        : security-passkey-state == "unavailable" ? @tr("Couldn't read the passkeys.")
                        : security-passkey-state != "loaded" ? @tr("Loading…")
                        : security-passkey-mode == "passwordless" ? @tr("Passwordless: this account signs in with a passkey alone, or with a recovery code.")
                        : security-passkey-mode == "second_factor" ? @tr("Second factor: signing in with the password also asks for a passkey.")
                        : @tr("Not used for signing in.");
                    wrap: word-wrap;
                }
                if security-passkey-state == "loaded" && security-passkeys.length == 0 : Text {
                    text: @tr("No passkeys registered.");
                    color: palette-muted;
                }
                for passkey in security-passkeys : HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: passkey.last-used == ""
                            ? @tr("{}: added {}, never used", passkey.name, passkey.added)
                            : @tr("{}: added {}, last used {}", passkey.name, passkey.added, passkey.last-used);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "🗑  " + @tr("Delete");
                        a11y-label: @tr("Delete {}", passkey.name);
                        enabled: !security-passkey-busy && security-passkey-password != "";
                        clicked => { security-passkey-delete(passkey.id, security-passkey-password); }
                    }
                }
                // Every change re-authenticates with the account password.
                if security-passkey-state == "loaded" && (security-passkeys.length > 0 || passkey-available) && security-passwordless-codes.length == 0 : VerticalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Account password");
                        accessible-label: @tr("Account password");
                        text <=> security-passkey-password;
                        input-type: InputType.password;
                    }
                    Text {
                        text: passkey-available
                            ? @tr("Every change here asks for the account password; adding a passkey or changing the mode then asks for a passkey too.")
                            : @tr("Deleting a passkey asks for the account password.");
                        wrap: word-wrap;
                        color: palette-muted;
                    }
                }
                // Adding a passkey and switching the mode (issue #160).
                if passkey-available && security-passkey-state == "loaded" && security-passwordless-codes.length == 0 : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Passkey name");
                        accessible-label: @tr("Passkey name");
                        text <=> security-passkey-name;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Add a passkey");
                        enabled: !security-passkey-busy && security-passkey-password != "" && security-passkey-name != "";
                        clicked => { security-passkey-add(security-passkey-name, security-passkey-password); }
                    }
                }
                if passkey-available && security-passkey-state == "loaded" && security-passkeys.length > 0 && security-passwordless-codes.length == 0 : VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        if security-passkey-mode != "second_factor" : Button {
                            text: @tr("Ask for a passkey after the password");
                            enabled: !security-passkey-busy && security-passkey-password != "";
                            clicked => { security-passkey-mode-change("second_factor", security-passkey-password); }
                        }
                        if security-passkey-mode != "passwordless" : Button {
                            text: @tr("Sign in with a passkey alone…");
                            enabled: !security-passkey-busy && security-passkey-password != "";
                            clicked => { security-passwordless-prepare(security-passkey-password); }
                        }
                        if security-passkey-mode != "disabled" : Button {
                            text: @tr("Turn off passkey sign-in");
                            enabled: !security-passkey-busy && security-passkey-password != "";
                            clicked => { security-passkey-mode-change("disabled", security-passkey-password); }
                        }
                    }
                    if security-passkey-mode != "passwordless" : Text {
                        text: @tr("Signing in with a passkey alone turns off the password and TOTP sign-in. Recovery codes come first, for when the passkey is lost.");
                        wrap: word-wrap;
                        color: palette-muted;
                    }
                }
                // Passwordless, step two: the codes are shown before it's armed.
                if security-passwordless-codes.length > 0 : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: @tr("Save these recovery codes now: they won't be shown again. Once passwordless is on, each one signs you in once without the passkey.");
                        wrap: word-wrap;
                        font-weight: 600;
                    }
                    for code in security-passwordless-codes : Text {
                        text: code;
                        font-family: "monospace";
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CompactButton {
                            text: "📋  " + @tr("Copy codes");
                            clicked => { security-copy-passwordless-codes(); }
                        }
                        Button {
                            text: @tr("I've saved them, turn on passwordless");
                            enabled: !security-passkey-busy;
                            clicked => { security-passwordless-activate(); }
                        }
                        Button {
                            text: @tr("Cancel");
                            enabled: !security-passkey-busy;
                            clicked => { security-passwordless-cancel(); }
                        }
                    }
                }
                if security-passkey-error != "" : Text {
                    text: security-passkey-error == "wrong-password" ? @tr("Wrong password.")
                        : security-passkey-error == "last-passkey" && passkey-available ? @tr("That's the last passkey and the account still signs in with it. Turn passkey sign-in off or add another passkey first.")
                        : security-passkey-error == "last-passkey" ? @tr("That's the last passkey and the account still signs in with it. Turn passkeys off or add another one in Cicchetto first.")
                        : security-passkey-error == "refused" ? @tr("The server refused the passkey. The authenticator may be the wrong one, or the server expects another origin than {}. If it does, enter it under Passkey origin.", passkey-origin-preview(server-url, passkey-origin))
                        : security-passkey-error == "client-token" ? @tr("A per-client token can't change second factors.")
                        : security-passkey-error == "busy" ? @tr("Grappa is busy right now. Try again in a moment.")
                        : security-passkey-error == "throttled" ? @tr("Too many attempts. Wait a few minutes before trying again.")
                        : security-passkey-error == "passkey-cancelled" ? @tr("The passkey request was cancelled, timed out, or found no passkey for this account.")
                        : security-passkey-error == "passkey-failed" ? @tr("The passkey request failed.")
                        : security-passkey-error == "expired" ? @tr("The recovery codes expired before passwordless was turned on. Start again.")
                        : security-passkey-error == "add-failed" ? @tr("Couldn't add the passkey.")
                        : security-passkey-error == "mode-failed" ? @tr("Couldn't change how the account uses passkeys.")
                        : @tr("Couldn't delete the passkey.");
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }

                Text {
                    text: @tr("Passkey origin");
                    font-weight: 600;
                }
                Text {
                    text: @tr("A passkey only answers for one exact origin. For this server Cordiale uses {}. If the server is set up with another one (GRAPPA_PASSKEY_ORIGIN), enter it here; leave the field empty otherwise. It stays on this device.", passkey-origin-preview(server-url, passkey-origin));
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        placeholder-text: @tr("Passkey origin (optional)");
                        accessible-label: @tr("Passkey origin (optional)");
                        text <=> passkey-origin;
                        edited => { passkey-origin-saved = false; }
                        accepted => {
                            if passkey-origin-ok { passkey-origin-save(server-url, passkey-origin); }
                        }
                    }
                    CompactButton {
                        text: "💾  " + @tr("Save");
                        a11y-label: @tr("Save");
                        enabled: passkey-origin-ok;
                        clicked => { passkey-origin-save(server-url, passkey-origin); }
                    }
                }
                if !passkey-origin-ok : Text {
                    text: @tr("That isn't an origin. Use the form https://host or https://host:port, without a path.");
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }
                if cleartext-key("", passkey-origin) != "" : CleartextNotice {
                    dark: theme == "dark";
                    origin-cleartext: true;
                }
                if passkey-origin-saved : Text {
                    text: @tr("Saved.");
                    color: palette-muted;
                    accessible-live-region: AccessibleLiveness.polite;
                }

                Text {
                    text: passkey-available
                        ? @tr("Client tokens and account deletion are managed in Cicchetto.")
                        : @tr("Adding a passkey and changing how the account uses them still happen in Cicchetto: Cordiale can't talk to an authenticator yet. Client tokens and account deletion are managed there too.");
                    wrap: word-wrap;
                    color: palette-muted;
                }
            }

            if settings-section == "push" : SectionCard {
                icon: "🔔";
                title: @tr("Notifications");

                Text {
                    text: @tr("Push notifications Grappa sends to your devices (such as Cicchetto on a phone) while none of them is in use.");
                    wrap: word-wrap;
                }
                if !notify-prefs-loaded : Text {
                    text: @tr("Loading…");
                }
                if notify-prefs-loaded : VerticalLayout {
                    spacing: 6px;

                    CheckBox {
                        text: @tr("Mentions of my nick in channels");
                        checked <=> notify-channel-mentions;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Every channel message");
                        checked <=> notify-channel-all;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Every private message");
                        checked <=> notify-private-all;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Watched nicks coming online");
                        checked <=> notify-presence-online;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Watched nicks going offline");
                        checked <=> notify-presence-offline;
                        toggled => { notification-prefs-changed(); }
                    }

                    Text {
                        text: @tr("With every channel message off, also these channels:");
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    for channel in notify-only-channels : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: channel;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Remove {}", channel);
                            clicked => { notification-list-remove("channel", channel); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: "#channel";
                            accessible-label: @tr("Channel");
                            text <=> notify-new-channel;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            enabled: notify-new-channel != "";
                            clicked => {
                                notification-list-add("channel", notify-new-channel);
                                notify-new-channel = "";
                            }
                        }
                    }

                    Text {
                        text: @tr("With every private message off, also these nicks:");
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    for nick in notify-only-privates : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: nick;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Remove {}", nick);
                            clicked => { notification-list-remove("private", nick); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            accessible-label: @tr("Nickname");
                            text <=> notify-new-private;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            enabled: notify-new-private != "";
                            clicked => {
                                notification-list-add("private", notify-new-private);
                                notify-new-private = "";
                            }
                        }
                    }

                    Text {
                        text: "🔕  " + @tr("Muted conversations");
                        font-weight: 600;
                    }
                    if notify-muted.length == 0 : Text {
                        text: @tr("None. Mute one from the Actions menu.");
                        wrap: word-wrap;
                    }
                    for row in notify-muted : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🔔  " + @tr("Unmute");
                            a11y-label: @tr("Unmute {}", row.label);
                            clicked => { notification-unmute(row.key); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: @tr("Sound on other devices (also /beep)");
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        ComboBox {
                            model: ["none", "tone", "chime", "blip", "pop", "icq", "xp_notify", "xp_ding", "xp_balloon", "xp_exclamation"];
                            current-index <=> notify-sound-index;
                            min-width: 140px;
                            selected => { notification-sound-changed(); }
                        }
                    }
                }
            }

            // Color themes: Grappa's gallery (`GET /themes`, applied through
            // `PUT /me/theme`) or built-in copies of it, plus the classic
            // light/dark switch, same toggle as on General.
            if settings-section == "themes" : SectionCard {
                icon: "🎨";
                title: @tr("Theme");
                fill: true;

                Text {
                    text: @tr("Color themes come from Grappa's gallery (irssi-dark, sux and more) and follow your account; without a connection, built-in copies are offered. The classic look follows the light/dark switch.");
                    wrap: word-wrap;
                }
                if theme-pair-active : Text {
                    text: @tr("Pick a night theme too and Cordiale switches to it while your system is in dark mode, like Cicchetto.");
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    CompactButton {
                        text: theme == "light" ? @tr("Classic: switch to dark") : @tr("Classic: switch to light");
                        clicked => { theme-toggle-requested(); }
                    }
                    if palette-active : CompactButton {
                        text: @tr("Back to classic");
                        clicked => { color-theme-requested(""); }
                    }
                    if theme-editing-available : CompactButton {
                        text: "➕  " + @tr("New theme");
                        clicked => { theme-edit-requested(""); }
                    }
                    if theme-has-night : CompactButton {
                        text: @tr("Same theme day and night");
                        clicked => { night-theme-requested(""); }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    min-height: 160px;

                    for choice in theme-choices : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;
                        height: 34px;

                        HorizontalLayout {
                            spacing: 0px;

                            for swatch in choice.swatches : Rectangle {
                                width: 14px;
                                height: 22px;
                                background: swatch;
                                border-width: 1px;
                                border-color: #80808080;
                            }
                        }
                        Text {
                            text: choice.author == "" ? choice.name : @tr("{} by {}", choice.name, choice.author);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-weight: choice.selected ? 700 : 400;
                            overflow: elide;
                        }
                        CompactButton {
                            text: choice.selected ? (theme-has-night ? "☀  " + @tr("By day") : @tr("In use")) : @tr("Use");
                            enabled: !choice.selected;
                            a11y-label: @tr("Use theme {}", choice.name);
                            clicked => { color-theme-requested(choice.key); }
                        }
                        if theme-pair-active && !choice.selected : CompactButton {
                            text: choice.night ? "🌙  " + @tr("At night") : "🌙  " + @tr("Use at night");
                            enabled: !choice.night;
                            a11y-label: @tr("Use theme {} at night", choice.name);
                            clicked => { night-theme-requested(choice.key); }
                        }
                        if choice.mine : CompactButton {
                            text: "✎";
                            a11y-label: @tr("Edit theme {}", choice.name);
                            clicked => { theme-edit-requested(choice.key); }
                        }
                        if choice.mine : CompactButton {
                            text: choice.published ? @tr("Unpublish") : @tr("Publish");
                            a11y-label: choice.published ? @tr("Unpublish theme {}", choice.name) : @tr("Publish theme {}", choice.name);
                            clicked => { theme-publish-requested(choice.key, !choice.published); }
                        }
                        if choice.mine : CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Delete theme {}", choice.name);
                            clicked => { theme-delete-requested(choice.key, choice.name); }
                        }
                        if choice.server && !choice.mine : CompactButton {
                            text: "⧉";
                            a11y-label: @tr("Copy theme {}", choice.name);
                            clicked => { theme-copy-requested(choice.key); }
                        }
                    }
                }
            }

            if settings-section == "theme-editor" : SectionCard {
                icon: "🖌";
                title: editor-theme-id >= 0 ? @tr("Edit theme") : @tr("New theme");
                fill: true;

                HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Theme name");
                        accessible-label: @tr("Theme name");
                        text <=> editor-name;
                        horizontal-stretch: 1;
                    }
                    ComboBox {
                        model: [@tr("Default monospace"), "JetBrains Mono", "Fira Code", "Iosevka", "Hack", "Cascadia Code", "Source Code Pro", "IBM Plex Mono"];
                        current-index <=> editor-font-index;
                        min-width: 150px;
                        selected => { editor-font-changed(); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: @tr("Wallpaper");
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: editor-background-names;
                        current-index <=> editor-background-index;
                        min-width: 150px;
                    }
                    CompactButton {
                        text: "📁  " + @tr("Upload image…");
                        clicked => { editor-pick-background(); }
                    }
                    CheckBox {
                        text: @tr("Tile");
                        checked <=> editor-tile;
                    }
                    Text {
                        text: @tr("Opacity {}%", editor-opacity);
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 0;
                        maximum: 100;
                        value: editor-opacity;
                        width: 90px;
                        released(value) => { editor-opacity = Math.round(value); }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    min-height: 160px;

                    for row[index] in editor-colors : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            background: row.color;
                            border-width: 1px;
                            border-color: #80808080;
                        }
                        Text {
                            text: editor-color-label(row.key, row.nick-index);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        LineEdit {
                            text: row.value;
                            accessible-label: editor-color-label(row.key, row.nick-index);
                            width: 110px;
                            edited(value) => { editor-color-edited(index, value); }
                        }
                        Text {
                            text: row.valid ? "" : "⚠";
                            vertical-alignment: center;
                            width: 16px;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Button {
                        text: "💾  " + @tr("Save and use");
                        enabled: editor-name != "";
                        clicked => { editor-save(); }
                    }
                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            settings-section = "themes";
                            editor-cancel();
                        }
                    }
                }
            }

            if settings-section == "radio" : SectionCard {
                icon: "📻";
                title: @tr("Radio stations");
                fill: true;

                Text {
                    text: @tr("Add your own MP3, Ogg Vorbis or FLAC stations (a stream or a .pls/.m3u playlist URL). They are kept on this device only, next to Cicchetto's stations on the Radio screen.");
                    wrap: word-wrap;
                }
                for station[index] in radio-custom-stations : HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: station.name + "  (" + station.codec-label + ")\n" + station.url;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "✎";
                        a11y-label: @tr("Edit {}", station.name);
                        clicked => {
                            radio-edit-index = index;
                            radio-form-name = station.name;
                            radio-form-url = station.url;
                            radio-form-codec = station.codec-index;
                        }
                    }
                    CompactButton {
                        text: "🗑";
                        a11y-label: @tr("Delete {}", station.name);
                        clicked => { radio-station-delete(index); }
                    }
                }
                Text {
                    text: radio-edit-index >= 0 ? @tr("Edit station") : @tr("New station");
                    font-weight: 600;
                }
                LineEdit {
                    placeholder-text: @tr("Name");
                    accessible-label: @tr("Name");
                    text <=> radio-form-name;
                }
                LineEdit {
                    placeholder-text: "https://…";
                    accessible-label: @tr("Stream URL");
                    text <=> radio-form-url;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    ComboBox {
                        model: ["MP3", "Ogg Vorbis", "FLAC"];
                        current-index <=> radio-form-codec;
                        min-width: 120px;
                    }
                    CompactButton {
                        text: radio-edit-index >= 0 ? "💾  " + @tr("Save") : "➕  " + @tr("Add");
                        a11y-label: radio-edit-index >= 0 ? @tr("Save") : @tr("Add");
                        enabled: radio-form-name != "" && radio-form-url != "";
                        clicked => { radio-station-save(radio-edit-index, radio-form-name, radio-form-url, radio-form-codec); }
                    }
                    if radio-edit-index >= 0 : CompactButton {
                        text: @tr("Cancel");
                        clicked => {
                            radio-edit-index = -1;
                            radio-form-name = "";
                            radio-form-url = "";
                            radio-form-codec = 0;
                        }
                    }
                }
            }

            if settings-section == "watchlists" : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;

                SectionCard {
                    icon: "👁";
                    title: @tr("Presence (per network)");

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        for network in known-networks : NavButton {
                            icon: "🌐";
                            label: network;
                            selected: settings-network == network;
                            clicked => {
                                settings-network = network;
                                settings-network-selected(network);
                            }
                        }
                    }
                    for row in settings-notify-nicks : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: row.presence == "online"
                                ? @tr("{} (online)", row.nick)
                                : (row.presence == "offline" ? @tr("{} (offline)", row.nick) : row.nick);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { notify-remove-requested(row.nick); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            text <=> new-notify-nick;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            enabled: settings-network != "";
                            clicked => {
                                notify-add-requested(new-notify-nick);
                                new-notify-nick = "";
                            }
                        }
                    }
                }

                SectionCard {
                    icon: "✨";
                    title: @tr("Keyword highlights");

                    for pattern in settings-watch-patterns : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: pattern;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { watch-pattern-remove-requested(pattern); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Pattern");
                            text <=> new-watch-pattern;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            clicked => {
                                watch-pattern-add-requested(new-watch-pattern);
                                new-watch-pattern = "";
                            }
                        }
                    }
                }
            }

            if settings-section == "ignores" : SectionCard {
                icon: "🚫";
                title: @tr("Ignore List");

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for network in known-networks : NavButton {
                        icon: "🌐";
                        label: network;
                        selected: settings-network == network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                for rule in settings-ignores : HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: rule.text-pattern == "" ? rule.mask : @tr("{} matching {}", rule.mask, rule.text-pattern);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "🗑  " + @tr("Delete");
                        a11y-label: rule.text-pattern == ""
                            ? @tr("Delete {}", rule.mask)
                            : @tr("Delete {} matching {}", rule.mask, rule.text-pattern);
                        clicked => { ignore-remove-requested(rule.mask, rule.text-pattern); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Mask (nick!user@host)");
                        text <=> new-ignore-mask;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    LineEdit {
                        placeholder-text: @tr("Text pattern (optional)");
                        text <=> new-ignore-pattern;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Add");
                        a11y-label: @tr("Add");
                        enabled: settings-network != "" && new-ignore-mask != "";
                        clicked => {
                            ignore-add-requested(new-ignore-mask, new-ignore-pattern);
                            new-ignore-mask = "";
                            new-ignore-pattern = "";
                        }
                    }
                }
                Text {
                    text: @tr("A text pattern narrows the rule to messages whose text matches it: * and ? are wildcards, the whole text must match (write *word* for “contains”) and case is ignored. Grappa drops the matching messages.");
                    wrap: word-wrap;
                    color: palette-muted;
                }
                if settings-ignore-error != "" : Text {
                    text: settings-ignore-error == "invalid-text-pattern"
                        ? @tr("The text pattern can't be blank or span more than one line.")
                        : (settings-ignore-error == "invalid-mask"
                            ? @tr("That mask isn't valid.")
                            : @tr("Couldn't update the ignore list."));
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }
            }

            if settings-section == "aliases" : SectionCard {
                icon: "↪";
                title: @tr("Aliases");

                for row in settings-aliases : HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: row.command;
                        vertical-alignment: center;
                        font-weight: 600;
                        min-width: 80px;
                        overflow: elide;
                    }
                    Text {
                        text: row.expansion;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "🗑  " + @tr("Delete");
                        a11y-label: @tr("Delete");
                        clicked => { alias-remove-requested(row.command); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Command");
                        text <=> new-alias-command;
                        horizontal-stretch: 1;
                        min-width: 60px;
                    }
                    LineEdit {
                        placeholder-text: @tr("Expansion");
                        text <=> new-alias-expansion;
                        horizontal-stretch: 2;
                        min-width: 80px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Add");
                        a11y-label: @tr("Add");
                        clicked => {
                            alias-add-requested(new-alias-command, new-alias-expansion);
                            new-alias-command = "";
                            new-alias-expansion = "";
                        }
                    }
                }
            }

            if settings-section == "perform" : SectionCard {
                icon: "▶";
                title: @tr("On-Connect Commands");

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for network in known-networks : NavButton {
                        icon: "🌐";
                        label: network;
                        selected: settings-network == network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                Text {
                    text: @tr("On-connect commands, one IRC command per line");
                    wrap: word-wrap;
                }
                TextEdit {
                    text <=> perform-text;
                    min-height: 120px;
                    wrap: no-wrap;
                    accessible-label: @tr("On-connect commands");
                }
                CompactButton {
                    text: "💾  " + @tr("Save");
                    a11y-label: @tr("Save");
                    enabled: settings-network != "";
                    clicked => { perform-save-requested(perform-text); }
                }
            }

            if settings-section == "vhost" : SectionCard {
                icon: "🌐";
                title: @tr("Source Address");

                for option in settings-vhost-options : CheckBox {
                    text: option.label;
                    checked: option.selected;
                    toggled => { vhost-toggle-requested(option.address); }
                }
            }

            if settings-section == "credits" : SectionCard {
                icon: "ℹ";
                title: @tr("Credits");

                HorizontalLayout {
                    spacing: 16px;

                    // The Rectangle gives the brand image a bounded, shrinkable
                    // column; the image keeps its ratio. 720x405 is the ratio of
                    // the 782x440 image, and the preferred height makes the row
                    // tall enough for it (the row would otherwise take the
                    // text's height and shrink the image).
                    Rectangle {
                        horizontal-stretch: 0;
                        min-width: 96px;
                        preferred-width: 720px;
                        max-width: 720px;
                        preferred-height: 405px;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("../../../resources/branding/cordiale.png");
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Cordiale";
                            font-size: 20px * FontScale.percent / 100;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Sythos";
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("A client for grappa-irc by vjt");
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        StyledText {
                            text: @markdown("[github.com/vjt/grappa-irc](https://github.com/vjt/grappa-irc)");
                            horizontal-alignment: center;
                            default-color: theme == "dark" ? white : black;
                            link-color: theme == "dark" ? #8ab4f8 : #1a5fb4;
                            link-clicked(href) => { credits-link-clicked(href); }
                        }
                        Rectangle { height: 14px; }
                        Text {
                            text: @tr("Report Cordiale issues at:");
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        StyledText {
                            text: @markdown("[github.com/Sythos/Cordiale/issues](https://github.com/Sythos/Cordiale/issues)");
                            horizontal-alignment: center;
                            default-color: theme == "dark" ? white : black;
                            link-color: theme == "dark" ? #8ab4f8 : #1a5fb4;
                            link-clicked(href) => { credits-link-clicked(href); }
                        }
                        Text {
                            text: @tr("Issues with Grappa itself (grappa-irc) go to its own repository:");
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        StyledText {
                            text: @markdown("[github.com/vjt/grappa-irc/issues](https://github.com/vjt/grappa-irc/issues)");
                            horizontal-alignment: center;
                            default-color: theme == "dark" ? white : black;
                            link-color: theme == "dark" ? #8ab4f8 : #1a5fb4;
                            link-clicked(href) => { credits-link-clicked(href); }
                        }
                        Rectangle { height: 14px; }
                        Text {
                            text: credits-copyright-text;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: app-version;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if settings-section == "admin" : SectionCard {
                icon: "🛡";
                title: @tr("Admin");
                fill: true;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    NavButton {
                        icon: "🔌";
                        label: @tr("Sessions");
                        selected: admin-section == "sessions";
                        clicked => { admin-section = "sessions"; }
                    }
                    NavButton {
                        icon: "👤";
                        label: @tr("Users");
                        selected: admin-section == "users";
                        clicked => { admin-section = "users"; }
                    }
                    NavButton {
                        icon: "🌍";
                        label: @tr("Networks");
                        selected: admin-section == "networks";
                        clicked => { admin-section = "networks"; }
                    }
                    NavButton {
                        icon: "🧳";
                        label: @tr("Visitors");
                        selected: admin-section == "visitors";
                        clicked => { admin-section = "visitors"; }
                    }
                    NavButton {
                        icon: "📎";
                        label: @tr("Uploads");
                        selected: admin-section == "uploads";
                        clicked => {
                            admin-section = "uploads";
                            admin-uploads-requested();
                        }
                    }
                    NavButton {
                        icon: "📜";
                        label: @tr("Session Log");
                        selected: admin-section == "session-log";
                        clicked => { admin-section = "session-log"; }
                    }
                    NavButton {
                        icon: "🔑";
                        label: @tr("Credentials");
                        selected: admin-section == "credentials";
                        clicked => { admin-section = "credentials"; }
                    }
                    NavButton {
                        icon: "🖧";
                        label: @tr("Vhosts");
                        selected: admin-section == "vhosts";
                        clicked => { admin-section = "vhosts"; }
                    }
                    NavButton {
                        icon: "📣";
                        label: @tr("Events");
                        selected: admin-section == "events";
                        clicked => { admin-section = "events"; }
                    }
                    NavButton {
                        icon: "🧰";
                        label: @tr("Server");
                        selected: admin-section == "server";
                        clicked => {
                            admin-section = "server";
                            admin-settings-requested();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    CompactButton {
                        text: "⟳  " + @tr("Refresh");
                        a11y-label: @tr("Refresh");
                        clicked => { admin-refresh-requested(); }
                    }
                    CompactButton {
                        text: "🧹  " + @tr("Run reaper sweep");
                        a11y-label: @tr("Run reaper sweep");
                        clicked => { admin-reaper-run(); }
                    }
                }

                Text {
                    text: admin-loading ? @tr("Loading…") : admin-overview-text;
                    wrap: word-wrap;
                }

                if admin-section == "sessions" && admin-session-confirm-id != "" : HorizontalBox {
                    padding: 0px;
                    spacing: 4px;

                    Text {
                        text: @tr("Terminate the session of {}? Its connection is stopped; the account and its network binding stay as they are.", admin-session-confirm-label);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: @tr("Cancel");
                        init => { self.focus(); }
                        clicked => {
                            admin-session-confirm-id = "";
                            admin-session-confirm-label = "";
                        }
                    }
                    Button {
                        text: @tr("Terminate");
                        clicked => {
                            admin-terminate-session(admin-session-confirm-id);
                            admin-session-confirm-id = "";
                            admin-session-confirm-label = "";
                        }
                    }
                }

                if admin-section == "sessions" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-sessions : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: (row.alive ? "🟢  " : "⚪  ") + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "⏏  " + @tr("Disconnect");
                            a11y-label: @tr("Disconnect");
                            enabled: row.alive;
                            clicked => { admin-disconnect-session(row.session-id); }
                        }
                        if row.is-user : CompactButton {
                            text: "⏹  " + @tr("Terminate");
                            a11y-label: @tr("Terminate");
                            enabled: row.alive;
                            clicked => {
                                admin-session-confirm-id = row.session-id;
                                admin-session-confirm-label = row.label;
                            }
                        }
                    }
                }

                if admin-section == "users" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("New user name");
                        accessible-label: @tr("New user name");
                        text <=> admin-new-user-name;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    LineEdit {
                        placeholder-text: @tr("Password");
                        accessible-label: @tr("Password");
                        input-type: InputType.password;
                        text <=> admin-new-user-password;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    CheckBox {
                        text: @tr("Admin");
                        checked <=> admin-new-user-is-admin;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Create user");
                        a11y-label: @tr("Create user");
                        enabled: admin-new-user-name != "" && admin-new-user-password != "";
                        clicked => { admin-user-create(); }
                    }
                }
                if admin-section == "users" : Text {
                    text: @tr("To reset a password, type it above and press 🔑 on the account; its sessions are signed out.");
                    wrap: word-wrap;
                }

                if admin-section == "users" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-users : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: (row.is-admin ? "🛡  " : "👤  ") + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: row.is-admin ? @tr("Revoke admin") : @tr("Make admin");
                            clicked => { admin-user-toggle-admin(row.user-id, !row.is-admin); }
                        }
                        CompactButton {
                            text: "🔑";
                            a11y-label: @tr("Set password");
                            enabled: admin-new-user-password != "";
                            clicked => { admin-user-set-password(row.user-id); }
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { admin-user-delete(row.user-id); }
                        }
                    }
                }

                if admin-section == "networks" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("New network slug");
                        accessible-label: @tr("New network slug");
                        text <=> admin-new-network-slug;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Create network");
                        a11y-label: @tr("Create network");
                        enabled: admin-new-network-slug != "";
                        clicked => { admin-network-create(admin-new-network-slug); }
                    }
                }

                if admin-section == "networks" && admin-network-confirm-id != "" : HorizontalBox {
                    padding: 0px;
                    spacing: 4px;

                    Text {
                        text: admin-network-count-state == "counting"
                            ? @tr("Counting the messages of {}…", admin-network-confirm-slug)
                            : (admin-network-count-state == "known"
                                ? @tr("Delete {} for good? Its whole scrollback goes with it, for every account. Messages deleted: {}", admin-network-confirm-slug, admin-network-count)
                                : @tr("Delete {} for good? Its whole scrollback goes with it, for every account; the server couldn't say how many messages that is.", admin-network-confirm-slug));
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: @tr("Cancel");
                        init => { self.focus(); }
                        clicked => {
                            admin-network-confirm-id = "";
                            admin-network-confirm-slug = "";
                        }
                    }
                    Button {
                        text: @tr("Delete network and scrollback");
                        enabled: admin-network-count-state != "counting";
                        clicked => {
                            admin-network-delete(admin-network-confirm-id);
                            admin-network-confirm-id = "";
                            admin-network-confirm-slug = "";
                        }
                    }
                }

                if admin-section == "networks" && admin-edit-network != "" : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "✏  " + @tr("Settings of {} (empty cap = unlimited)", admin-edit-network);
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Visitor sessions");
                            accessible-label: @tr("Visitor sessions");
                            input-type: number;
                            text <=> admin-edit-visitor-cap;
                            min-width: 60px;
                        }
                        LineEdit {
                            placeholder-text: @tr("User sessions");
                            accessible-label: @tr("User sessions");
                            input-type: number;
                            text <=> admin-edit-user-cap;
                            min-width: 60px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Per IP");
                            accessible-label: @tr("Per IP");
                            input-type: number;
                            text <=> admin-edit-ip-cap;
                            min-width: 60px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CheckBox {
                            text: @tr("Visitors allowed");
                            checked <=> admin-edit-visitor-enabled;
                        }
                        CompactButton {
                            text: "💾  " + @tr("Save");
                            a11y-label: @tr("Save");
                            clicked => { admin-network-save(); }
                        }
                        CompactButton {
                            text: @tr("Cancel");
                            clicked => { admin-edit-network = ""; }
                        }
                    }

                    Text {
                        text: "🖧  " + @tr("IRC servers");
                        font-weight: 600;
                    }
                    for server in admin-servers : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: server.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "✏";
                            a11y-label: @tr("Edit {}", server.label);
                            clicked => {
                                admin-edit-server-id = server.server-id;
                                admin-edit-server-host = server.host;
                                admin-edit-server-port = server.port;
                                admin-edit-server-tls = server.tls;
                                admin-edit-server-enabled = server.enabled;
                            }
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Remove server {}", server.label);
                            clicked => { admin-server-delete(server.server-id); }
                        }
                    }
                    if admin-edit-server-id != "" : HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Host");
                            accessible-label: @tr("Host");
                            text <=> admin-edit-server-host;
                            horizontal-stretch: 1;
                            min-width: 100px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Port");
                            accessible-label: @tr("Port");
                            input-type: number;
                            text <=> admin-edit-server-port;
                            min-width: 60px;
                        }
                        CheckBox {
                            text: "TLS";
                            checked <=> admin-edit-server-tls;
                        }
                        CheckBox {
                            text: @tr("Enabled");
                            checked <=> admin-edit-server-enabled;
                        }
                        CompactButton {
                            text: "💾  " + @tr("Save");
                            a11y-label: @tr("Save");
                            clicked => { admin-server-save(); }
                        }
                        CompactButton {
                            text: @tr("Cancel");
                            clicked => { admin-edit-server-id = ""; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Host");
                            accessible-label: @tr("Host");
                            text <=> admin-new-server-host;
                            horizontal-stretch: 1;
                            min-width: 100px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Port");
                            accessible-label: @tr("Port");
                            input-type: number;
                            text <=> admin-new-server-port;
                            min-width: 60px;
                        }
                        CheckBox {
                            text: "TLS";
                            checked <=> admin-new-server-tls;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add server");
                            a11y-label: @tr("Add server");
                            enabled: admin-new-server-host != "";
                            clicked => { admin-server-add(); }
                        }
                    }

                    Text {
                        text: "⭐  " + @tr("Featured channels");
                        font-weight: 600;
                    }
                    for channel in admin-featured : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: channel.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CheckBox {
                            text: @tr("Enabled");
                            checked: channel.enabled;
                            toggled => { admin-featured-set(channel.featured-id, self.checked); }
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Delete {}", channel.label);
                            clicked => { admin-featured-delete(channel.featured-id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Channel");
                            accessible-label: @tr("Channel");
                            text <=> admin-new-featured-name;
                            min-width: 100px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Description");
                            accessible-label: @tr("Description");
                            text <=> admin-new-featured-description;
                            horizontal-stretch: 1;
                            min-width: 100px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add channel");
                            a11y-label: @tr("Add channel");
                            enabled: admin-new-featured-name != "";
                            clicked => { admin-featured-add(); }
                        }
                    }
                }

                if admin-section == "networks" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-networks : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🌍  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "✏";
                            a11y-label: @tr("Edit network {}", row.slug);
                            clicked => {
                                admin-edit-network = row.slug;
                                admin-edit-network-id = row.network-id;
                                admin-servers-requested(row.network-id);
                                admin-edit-visitor-enabled = row.visitor-enabled;
                                admin-edit-visitor-cap = row.visitor-cap;
                                admin-edit-user-cap = row.user-cap;
                                admin-edit-ip-cap = row.ip-cap;
                            }
                        }
                        CompactButton {
                            text: "⟲  " + @tr("Reset circuit");
                            a11y-label: @tr("Reset circuit");
                            clicked => { admin-network-reset-circuit(row.network-id); }
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Delete network {}", row.slug);
                            clicked => {
                                admin-network-confirm-id = row.network-id;
                                admin-network-confirm-slug = row.slug;
                                admin-network-count-state = "counting";
                                admin-network-count-requested(row.network-id);
                            }
                        }
                    }
                }

                if admin-section == "visitors" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-visitors : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🧳  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { admin-visitor-delete(row.visitor-id); }
                        }
                    }
                }
                if admin-section == "visitors" && admin-visitor-sessions.length > 0 : Text {
                    text: "🔌  " + @tr("Visitor sessions");
                    font-weight: 600;
                }
                if admin-section == "visitors" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-visitor-sessions : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: (row.alive ? "🟢  " : "⚪  ") + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        if row.alive : CompactButton {
                            text: "⏏  " + @tr("Disconnect");
                            a11y-label: @tr("Disconnect");
                            clicked => { admin-disconnect-session(row.session-id); }
                        }
                        if !row.alive : CompactButton {
                            text: "🔌  " + @tr("Reconnect");
                            a11y-label: @tr("Reconnect");
                            clicked => { admin-reconnect-session(row.session-id); }
                        }
                    }
                }

                if admin-section == "uploads" && admin-uploads-error != "" : Text {
                    text: admin-uploads-error == "forbidden"
                        ? @tr("The uploads registry needs an administrator signed in with a full session.")
                        : (admin-uploads-error == "delete-failed"
                            ? @tr("Couldn't delete the upload.")
                            : @tr("Couldn't load the uploads."));
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }
                // The budget shows only once the server has answered: before
                // that "0 B of 0 B" would look like a measurement.
                if admin-section == "uploads" && admin-uploads-loaded : Text {
                    text: admin-uploads-share >= 0
                        ? @tr("Disk budget: {} of {} ({}%)", admin-uploads-used, admin-uploads-cap, admin-uploads-share)
                        : @tr("Disk budget: {} of {}", admin-uploads-used, admin-uploads-cap);
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if admin-section == "uploads" && admin-uploads-loaded : Text {
                    text: @tr("Live bytes against the global upload cap; deleted rows no longer count and stay listed as the audit trail.");
                    wrap: word-wrap;
                    color: palette-muted;
                }
                if admin-section == "uploads" && admin-upload-confirm-id != "" : HorizontalBox {
                    padding: 0px;
                    spacing: 4px;

                    Text {
                        text: @tr("Delete {} before it expires? The file is removed at once; its row stays listed.", admin-upload-confirm-name);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: @tr("Cancel");
                        init => { self.focus(); }
                        clicked => {
                            admin-upload-confirm-id = "";
                            admin-upload-confirm-name = "";
                        }
                    }
                    Button {
                        text: @tr("Delete");
                        clicked => {
                            admin-upload-delete(admin-upload-confirm-id);
                            admin-upload-confirm-id = "";
                            admin-upload-confirm-name = "";
                        }
                    }
                }
                if admin-section == "uploads" && admin-uploads-loaded && admin-uploads.length == 0 : Text {
                    text: @tr("No uploads.");
                    color: palette-muted;
                }
                if admin-section == "uploads" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-uploads : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;

                            Text {
                                text: (row.live ? "📎  " : "🗑  ") + row.name;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            Text {
                                text: row.slug + " · " + row.mime + " · " + row.size + " · " + row.subject
                                    + " · " + (row.expires == "" ? @tr("never expires") : @tr("expires {}", row.expires))
                                    + " · " + (row.live ? @tr("live") : @tr("deleted {}", row.deleted));
                                color: palette-muted;
                                wrap: word-wrap;
                            }
                        }
                        if row.live : CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete {}", row.name);
                            clicked => {
                                admin-upload-confirm-id = row.id;
                                admin-upload-confirm-name = row.name;
                            }
                        }
                    }
                }

                if admin-section == "session-log" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for line in admin-session-log : Text {
                        text: line;
                        wrap: word-wrap;
                    }
                }

                if admin-section == "credentials" : VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;

                        ComboBox {
                            model: admin-user-names;
                            current-index <=> admin-cred-user-index;
                            min-width: 110px;
                        }
                        ComboBox {
                            model: admin-network-names;
                            current-index <=> admin-cred-network-index;
                            min-width: 100px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            accessible-label: @tr("Nickname");
                            text <=> admin-cred-nick;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        ComboBox {
                            model: ["auto", "sasl", "server_pass", "nickserv_identify", "none"];
                            current-index <=> admin-cred-auth-index;
                            min-width: 150px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Password");
                            accessible-label: @tr("Password");
                            input-type: InputType.password;
                            text <=> admin-cred-password;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "🔗  " + @tr("Bind");
                            a11y-label: @tr("Bind");
                            enabled: admin-cred-nick != "" && admin-user-names.length > 0 && admin-network-names.length > 0;
                            clicked => { admin-credential-bind(); }
                        }
                    }
                }
                if admin-section == "credentials" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-credentials : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🔑  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "✏";
                            a11y-label: @tr("Edit {}", row.label);
                            clicked => {
                                admin-edit-cred-user-id = row.user-id;
                                admin-edit-cred-network-id = row.network-id;
                                admin-edit-cred-label = row.label;
                                admin-edit-cred-nick = row.nick;
                                admin-edit-cred-ident = row.ident;
                                admin-edit-cred-realname = row.realname;
                                admin-edit-cred-sasl-user = row.sasl-user;
                                admin-edit-cred-password = "";
                            }
                        }
                        CompactButton {
                            text: "⛓  " + @tr("Unbind");
                            a11y-label: @tr("Unbind");
                            clicked => { admin-credential-unbind(row.user-id, row.network-id); }
                        }
                    }
                }
                if admin-section == "credentials" && admin-edit-cred-user-id != "" : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "✏  " + @tr("Edit {}", admin-edit-cred-label);
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            accessible-label: @tr("Nickname");
                            text <=> admin-edit-cred-nick;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Ident");
                            accessible-label: @tr("Ident");
                            text <=> admin-edit-cred-ident;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Real name");
                            accessible-label: @tr("Real name");
                            text <=> admin-edit-cred-realname;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        LineEdit {
                            placeholder-text: @tr("SASL user");
                            accessible-label: @tr("SASL user");
                            text <=> admin-edit-cred-sasl-user;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("New password (leave empty to keep it)");
                            accessible-label: @tr("New password (leave empty to keep it)");
                            input-type: InputType.password;
                            text <=> admin-edit-cred-password;
                            horizontal-stretch: 1;
                            min-width: 120px;
                        }
                        CompactButton {
                            text: "💾  " + @tr("Save");
                            a11y-label: @tr("Save");
                            enabled: admin-edit-cred-nick != "";
                            clicked => { admin-credential-save(); }
                        }
                        CompactButton {
                            text: @tr("Cancel");
                            clicked => { admin-edit-cred-user-id = ""; }
                        }
                    }
                    Text {
                        text: @tr("A new password ends the account's live session on this network; it has to reconnect.");
                        wrap: word-wrap;
                        color: palette-muted;
                    }
                }

                if admin-section == "vhosts" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Address");
                        accessible-label: @tr("Address");
                        text <=> admin-new-vhost-address;
                        horizontal-stretch: 1;
                        min-width: 100px;
                    }
                    CheckBox {
                        text: @tr("In pool");
                        checked <=> admin-new-vhost-in-pool;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Add vhost");
                        a11y-label: @tr("Add vhost");
                        enabled: admin-new-vhost-address != "";
                        clicked => { admin-vhost-add(); }
                    }
                }
                if admin-section == "vhosts" : ListView {
                    vertical-stretch: 1;
                    min-height: 100px;

                    for row in admin-vhosts : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🖧  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CheckBox {
                            text: @tr("In pool");
                            checked: row.in-pool;
                            toggled => { admin-vhost-set(row.vhost-id, "in_pool", self.checked); }
                        }
                        CheckBox {
                            text: @tr("For everyone");
                            checked: row.generally-available;
                            toggled => { admin-vhost-set(row.vhost-id, "generally_available", self.checked); }
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Delete vhost {}", row.label);
                            clicked => { admin-vhost-delete(row.vhost-id); }
                        }
                    }
                }
                if admin-section == "vhosts" : HorizontalLayout {
                    spacing: 6px;

                    ComboBox {
                        model: admin-vhost-names;
                        current-index <=> admin-grant-vhost-index;
                        min-width: 140px;
                    }
                    ComboBox {
                        model: admin-user-names;
                        current-index <=> admin-grant-user-index;
                        min-width: 110px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Grant");
                        a11y-label: @tr("Grant");
                        enabled: admin-vhost-names.length > 0 && admin-user-names.length > 0;
                        clicked => { admin-grant-add(); }
                    }
                }
                if admin-section == "vhosts" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Find a visitor or account by nick");
                        accessible-label: @tr("Find a visitor or account by nick");
                        text <=> admin-subject-query;
                        horizontal-stretch: 1;
                        accepted => { admin-subject-search(admin-subject-query); }
                    }
                    CompactButton {
                        text: "🔍  " + @tr("Search");
                        a11y-label: @tr("Search");
                        enabled: admin-subject-query != "";
                        clicked => { admin-subject-search(admin-subject-query); }
                    }
                }
                if admin-section == "vhosts" && admin-subject-searched && admin-subject-results.length == 0 : Text {
                    text: @tr("Nobody matches.");
                }
                if admin-section == "vhosts" : VerticalLayout {
                    spacing: 2px;

                    for subject in admin-subject-results : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: subject.kind == "visitor"
                                ? @tr("{} on {} (visitor)", subject.nick, subject.network)
                                : @tr("{} (account)", subject.nick);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Grant the vhost above");
                            a11y-label: @tr("Grant the selected vhost to {}", subject.nick);
                            enabled: admin-vhost-names.length > 0;
                            clicked => { admin-subject-grant(subject.kind, subject.subject-id); }
                        }
                    }
                }
                if admin-section == "vhosts" : ListView {
                    vertical-stretch: 1;
                    min-height: 80px;

                    for row in admin-grants : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Revoke grant {}", row.label);
                            clicked => { admin-grant-revoke(row.grant-id); }
                        }
                    }
                }

                if admin-section == "server" && !admin-settings-loaded : Text {
                    text: @tr("Loading…");
                }
                if admin-section == "server" && admin-settings-loaded : VerticalLayout {
                    vertical-stretch: 0;

                    VerticalLayout {
                        spacing: 6px;
                        padding: 2px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Upload host");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            ComboBox {
                                model: ["embedded", "litterbox"];
                                current-index <=> admin-setting-host-index;
                                min-width: 140px;
                            }
                        }
                        for size[index] in admin-setting-sizes : HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: index == 0 ? @tr("Image, per file (MiB)")
                                    : index == 1 ? @tr("Video, per file (MiB)")
                                    : index == 2 ? @tr("Document, per file (MiB)")
                                    : index == 3 ? @tr("Audio, per file (MiB)")
                                    : index == 4 ? @tr("All uploads (MiB)")
                                    : index == 5 ? @tr("Per user (MiB)")
                                    : index == 6 ? @tr("Per visitor (MiB)")
                                    : index == 7 ? @tr("DCC, per transfer (MiB)")
                                    : @tr("DCC, all transfers (MiB)");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            LineEdit {
                                text: size;
                                input-type: decimal;
                                min-width: 90px;
                                horizontal-stretch: 0;
                                edited(value) => { admin-setting-sizes[index] = value; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Longest video (seconds)");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            LineEdit {
                                text <=> admin-setting-video-seconds;
                                input-type: number;
                                min-width: 90px;
                                horizontal-stretch: 0;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Source address mode");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            ComboBox {
                                model: [@tr("Pool with reservations"), @tr("Static mapping with reservations")];
                                current-index <=> admin-setting-mode-index;
                                min-width: 200px;
                            }
                        }
                        if admin-setting-mode-index == 1 : HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Static mapping prefix length");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            LineEdit {
                                text <=> admin-setting-prefix;
                                min-width: 90px;
                                horizontal-stretch: 0;
                            }
                        }
                        CompactButton {
                            text: "💾  " + @tr("Save");
                            a11y-label: @tr("Save");
                            clicked => { admin-settings-save(); }
                        }
                    }
                }

                if admin-section == "events" && admin-events.length == 0 : Text {
                    text: @tr("No admin events yet. They arrive live while this panel is open.");
                    wrap: word-wrap;
                }
                if admin-section == "events" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for line in admin-events : Text {
                        text: line;
                        wrap: word-wrap;
                    }
                }
            }

            // Keeps short panels at the top; list panels fill instead.
            if settings-section != "themes" && settings-section != "admin" : Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    if screen == "reply" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;

            if reply-avatar-visible : Image {
                source: reply-avatar;
                width: 64px;
                height: 64px;
                image-fit: contain;
                accessible-label: @tr("Avatar of {}", reply-subject);
            }
            Text {
                text: reply-title-text();
                font-size: 18px * FontScale.percent / 100;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.text;
            }
        }

        ListView {
            vertical-stretch: 1;
            for row[row-index] in reply-rows : Rectangle {
                VerticalLayout {
                    Text {
                        text: row.label == ""
                            ? row.value
                            : (row.value == "" ? reply-label(row.label) : @tr("{}: {}", reply-label(row.label), row.value));
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                }

                if row.jump : TouchArea {
                    mouse-cursor: pointer;
                    clicked => { mention-open-requested(row-index); }
                }
            }
        }

        Button {
            text: @tr("Back");
            clicked => { screen = "connected"; }
        }
    }

    if screen == "umodes" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("User modes on {}", umode-network);
            font-size: 18px * FontScale.percent / 100;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        ListView {
            vertical-stretch: 1;

            for row in umode-toggles : HorizontalLayout {
                spacing: 8px;
                padding-bottom: 6px;

                CheckBox {
                    text: "+" + row.letter;
                    checked: row.active;
                    enabled: row.settable;
                    accessible-label: @tr("{} (+{})", umode-label(row.letter), row.letter);
                    toggled => {
                        // The box follows Grappa's push, not the click.
                        self.checked = row.active;
                        umode-toggle-requested(row.letter);
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: row.settable ? umode-label(row.letter) : @tr("{} (set by the server)", umode-label(row.letter));
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: umode-description(row.letter);
                        wrap: word-wrap;
                    }
                }
            }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                umode-view-closed();
            }
        }
    }

    if screen == "radio" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "📻  " + @tr("Radio");
            font-size: 18px * FontScale.percent / 100;
            accessible-role: AccessibleRole.text;
        }

        ListView {
            vertical-stretch: 1;

            for station in radio-stations : HorizontalLayout {
                spacing: 8px;
                padding-bottom: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: station.title;
                        font-weight: station.key == radio-tuned-key ? 700 : 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: station.detail;
                        wrap: word-wrap;
                        opacity: 0.75;
                    }
                    Text {
                        text: station.description;
                        wrap: word-wrap;
                    }
                }
                CompactButton {
                    text: station.key == radio-tuned-key ? "⏹  " + @tr("Stop") : "▶  " + @tr("Play");
                    a11y-label: station.key == radio-tuned-key ? @tr("Stop {}", station.title) : @tr("Play {}", station.title);
                    clicked => {
                        if station.key == radio-tuned-key {
                            radio-stop();
                        } else {
                            radio-tune(station.key);
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Button {
                text: @tr("Back");
                clicked => { screen = "connected"; }
            }
            Button {
                text: "⚙  " + @tr("Custom stations");
                clicked => {
                    screen = "settings";
                    settings-section = "radio";
                }
            }
        }
    }

    if screen == "debug" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "🐞  " + @tr("Debug");
            font-size: 18px * FontScale.percent / 100;
            accessible-role: AccessibleRole.text;
        }

        Text {
            text: @tr("Details about this device and this copy of Cordiale. They are shown only here and never sent anywhere.");
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            CompactButton {
                text: "📋  " + @tr("Copy");
                clicked => {
                    debug-text-view.select-all();
                    debug-text-view.copy();
                }
            }
            CompactButton {
                text: "🔄  " + @tr("Refresh");
                clicked => { debug-requested(); }
            }
            CompactButton {
                text: "📂  " + @tr("Open data folder");
                clicked => { debug-open-data-folder(); }
            }
        }

        debug-text-view := TextEdit {
            text: debug-report;
            read-only: true;
            wrap: word-wrap;
            vertical-stretch: 1;
            accessible-label: @tr("Debug");
        }

        Text {
            text: @tr("Please include these details when you open an issue:");
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;

            LineEdit {
                text: "https://github.com/Sythos/Cordiale/issues";
                read-only: true;
                accessible-label: @tr("Report Cordiale issues at:");
            }
            CompactButton {
                text: "🌐  " + @tr("Open in browser");
                clicked => { credits-link-clicked("https://github.com/Sythos/Cordiale/issues"); }
            }
        }

        HorizontalLayout {
            alignment: start;

            Button {
                text: @tr("Back");
                clicked => { screen = "connected"; }
            }
        }
    }

    if screen == "media" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: media-title;
                font-size: 16px * FontScale.percent / 100;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if media-kind == "image" : CompactButton {
                text: media-zoom ? @tr("Fit") : "1:1";
                a11y-label: media-zoom ? @tr("Fit to the window") : @tr("Actual size");
                clicked => { media-zoom = !media-zoom; }
            }
            if media-kind != "gone" : CompactButton {
                text: "🌐  " + @tr("Open in browser");
                clicked => { media-open-in-browser(); }
            }
            CompactButton {
                text: "✕  " + @tr("Close");
                clicked => { screen = "connected"; }
            }
        }

        if media-kind == "loading" : Text {
            text: @tr("Loading…");
        }
        if media-kind == "gone" : Text {
            text: @tr("This file is no longer on the server.");
            wrap: word-wrap;
        }
        if media-kind == "failed" : Text {
            text: @tr("The file couldn't be shown ({}).", media-error);
            wrap: word-wrap;
        }
        if media-kind == "image" && !media-zoom : Image {
            source: media-image;
            image-fit: contain;
            vertical-stretch: 1;
            accessible-role: AccessibleRole.image;
            accessible-label: media-title;
        }
        if media-kind == "image" && media-zoom : Flickable {
            vertical-stretch: 1;
            viewport-width: media-image.width * 1px;
            viewport-height: media-image.height * 1px;

            Image {
                source: media-image;
                width: media-image.width * 1px;
                height: media-image.height * 1px;
            }
        }
        if media-kind == "text" : VerticalLayout {
            spacing: 6px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                CompactButton {
                    text: "📋  " + @tr("Copy");
                    clicked => {
                        media-text-view.select-all();
                        media-text-view.copy();
                    }
                }
                if media-truncated : Text {
                    text: @tr("Only the first megabyte is shown.");
                    vertical-alignment: center;
                }
            }
            media-text-view := TextEdit {
                text: media-text;
                read-only: true;
                wrap: no-wrap;
                vertical-stretch: 1;
            }
        }
    }

    if screen == "archive" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("Archive on {}", archive-network);
            font-size: 18px * FontScale.percent / 100;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        Text {
            text: !archive-loaded
                ? @tr("Loading…")
                : (archive-rows.length == 0
                    ? @tr("No archived windows.")
                    : @tr("Windows you left that still have history on the bouncer."));
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if archive-error != "" : Text {
            text: archive-error-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if archive-confirm-target != "" : HorizontalBox {
            padding: 0px;
            spacing: 4px;

            Text {
                text: @tr("Delete all history of {} on {}? Only the bouncer's copy is removed.", archive-confirm-target, archive-network);
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.text;
            }

            Button {
                text: @tr("Delete");
                clicked => {
                    archive-delete-requested(archive-confirm-target);
                    archive-confirm-target = "";
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => { archive-confirm-target = ""; }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in archive-rows : HorizontalBox {
                padding: 0px;
                spacing: 4px;

                Text {
                    text: row.kind == "query"
                        ? @tr("{} (private, last active {})", row.target, row.last-activity)
                        : @tr("{} (last active {})", row.target, row.last-activity);
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    accessible-role: AccessibleRole.text;
                }

                Button {
                    text: @tr("Delete history");
                    accessible-label: @tr("Delete history of {}", row.target);
                    clicked => { archive-confirm-target = row.target; }
                }
            }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                archive-closed();
            }
        }
    }

    if screen == "links" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: links-network-label;
            font-size: 18px * FontScale.percent / 100;
        }

        for row in links-rows : Text {
            text: row.display;
            wrap: word-wrap;
        }

        Button {
            text: @tr("Show graph");
            clicked => { links-graph-requested(); }
        }

        Button {
            text: @tr("Back");
            clicked => { screen = "connected"; }
        }
    }

    // A release check is independent of login, so the prompt can appear on
    // any screen after the splash. The backdrop absorbs clicks on the view
    // beneath it; both actions leave the decision with the user.
    if available-update-version != "" && screen != "splash" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000099;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: min(460px, parent.width - 32px);
            height: 190px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-radius: 8px;
            border-color: #8080806a;
            background: theme == "dark" ? #242424 : white;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: @tr("Cordiale update available");
                    font-size: 18px * FontScale.percent / 100;
                    font-weight: 600;
                }
                Text {
                    text: @tr("Version {} is available; you're using {}.", available-update-version, app-version);
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: @tr("Later");
                        clicked => { available-update-version = ""; }
                    }
                    Button {
                        text: @tr("Open latest release in browser");
                        clicked => {
                            update-release-open();
                            available-update-version = "";
                        }
                    }
                }
            }
        }
    }
    // The security key prompt (see `key-prompt-step`). Its buttons answer
    // the ceremony directly, so they don't depend on `connecting`; there is
    // no cancel while the key waits for a touch, which can't be stopped.
    if key-prompt-step != "" : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000099;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: min(460px, parent.width - 32px);
            height: min(300px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-radius: 8px;
            border-color: #8080806a;
            background: theme == "dark" ? #242424 : white;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: @tr("Security key");
                    font-size: 18px * FontScale.percent / 100;
                    font-weight: 600;
                }
                Text {
                    text: key-prompt-step == "touch" ? @tr("Touch your security key when it blinks.")
                        : key-prompt-step == "pin" ? @tr("Enter the PIN of your security key.")
                        : key-prompt-text(key-prompt-error);
                    wrap: word-wrap;
                }
                if key-prompt-step == "pin" : LineEdit {
                    placeholder-text: @tr("Security key PIN");
                    accessible-label: @tr("Security key PIN");
                    text <=> key-prompt-pin;
                    input-type: InputType.password;
                    init => { self.focus(); }
                    accepted => {
                        if key-prompt-pin != "" { key-prompt-submit(key-prompt-pin); }
                    }
                }
                if key-prompt-step == "pin" && key-prompt-error != "" : Text {
                    text: key-prompt-text(key-prompt-error);
                    wrap: word-wrap;
                    color: theme == "dark" ? #e57373 : #c0392b;
                    accessible-live-region: AccessibleLiveness.polite;
                }
                if key-prompt-step != "touch" : HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: @tr("Cancel");
                        clicked => { key-prompt-cancel(); }
                    }
                    if key-prompt-step == "error" : Button {
                        text: @tr("Try again");
                        clicked => { key-prompt-retry(); }
                    }
                    if key-prompt-step == "pin" : Button {
                        text: @tr("Continue");
                        enabled: key-prompt-pin != "";
                        clicked => { key-prompt-submit(key-prompt-pin); }
                    }
                }
            }
        }
    }
}

export component LinksGraphWindow inherits Window {
    title: @tr("Cordiale — Network Links");
    width: 800px;
    height: 640px;

    in property <string> network-label: "";
    in property <string> edges-commands: "";
    in property <[LinksGraphNode]> nodes: [];
    // Side of the square canvas the node coordinates and edges live in.
    in property <int> canvas-size: 760;
    in-out property <float> zoom: 1.0;

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: network-label;
                font-size: 18px * FontScale.percent / 100;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            CompactButton {
                text: "−";
                a11y-label: @tr("Zoom out");
                enabled: zoom > 0.3;
                clicked => { zoom = max(0.25, zoom / 1.25); }
            }
            Text {
                text: round(zoom * 100) + "%";
                vertical-alignment: center;
                min-width: 44px;
                horizontal-alignment: center;
            }
            CompactButton {
                text: "+";
                a11y-label: @tr("Zoom in");
                enabled: zoom < 4;
                clicked => { zoom = min(4, zoom * 1.25); }
            }
            CompactButton {
                text: @tr("Reset");
                a11y-label: @tr("Reset zoom");
                clicked => { zoom = 1; }
            }
        }

        // Drag or scroll to pan; the buttons above zoom.
        Flickable {
            vertical-stretch: 1;
            min-height: 300px;
            viewport-width: canvas-size * 1px * zoom;
            viewport-height: canvas-size * 1px * zoom;

            Rectangle {
                width: canvas-size * 1px * zoom;
                height: canvas-size * 1px * zoom;
                background: #1e1e1e;

                // The viewbox pins the edges to the same coordinate space
                // as the nodes, instead of fitting their bounding box.
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: canvas-size;
                    viewbox-height: canvas-size;
                    commands: edges-commands;
                    stroke: #888888;
                    stroke-width: 1.5px;
                }

                for node in nodes : Rectangle {
                    x: node.x * 1px * zoom - 5px;
                    y: node.y * 1px * zoom - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: #4a9eff;
                }

                for node in nodes : Text {
                    x: node.x * 1px * zoom + 8px;
                    y: node.y * 1px * zoom - 7px;
                    text: node.server;
                    color: white;
                    font-size: 12px * FontScale.percent / 100;
                }
            }
        }
    }
}
