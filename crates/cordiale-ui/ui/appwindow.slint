    function umode-label(letter: string) -> string {
        if letter == "i" {
            return @tr("invisible");
        } else if letter == "w" {
            return @tr("wallops");
        } else if letter == "s" {
            return @tr("server notices");
        } else if letter == "x" {
            return @tr("masked host");
        } else if letter == "R" {
            return @tr("registered only");
        } else if letter == "b" {
            return @tr("chatops");
        } else if letter == "c" {
            return @tr("client notices");
        } else if letter == "d" {
            return @tr("debug notices");
        } else if letter == "e" {
            return @tr("invalid DCC");
        } else if letter == "f" {
            return @tr("flood notices");
        } else if letter == "g" {
            return @tr("globops");
        } else if letter == "k" {
            return @tr("kill notices");
        } else if letter == "K" {
            return @tr("U:Line kills");
        } else if letter == "m" {
            return @tr("spam notices");
        } else if letter == "n" {
            return @tr("routing notices");
        } else if letter == "y" {
            return @tr("command notices");
        } else if letter == "F" {
            return @tr("flood immune");
        } else if letter == "I" {
            return @tr("hide idle");
        } else if letter == "j" {
            return @tr("Java user");
        } else if letter == "S" {
            return @tr("SSL");
        } else if letter == "o" {
            return @tr("operator");
        } else if letter == "O" {
            return @tr("local operator");
        } else if letter == "r" {
            return @tr("registered");
        } else if letter == "a" {
            return @tr("services admin");
        } else if letter == "A" {
            return @tr("server admin");
        } else if letter == "h" {
            return @tr("help operator");
        } else if letter == "z" {
            return @tr("services agent");
        }
        return @tr("mode +{}", letter);
    }

    function umode-description(letter: string) -> string {
        if letter == "i" {
            return @tr("hidden from WHO and global nick lists");
        } else if letter == "w" {
            return @tr("receive network WALLOPS broadcasts");
        } else if letter == "s" {
            return @tr("receive server notice broadcasts");
        } else if letter == "x" {
            return @tr("cloak your hostname from other users");
        } else if letter == "R" {
            return @tr("only registered nicks may message you");
        } else if letter == "b" {
            return @tr("IRC operators: receive CHATOPS messages");
        } else if letter == "c" {
            return @tr("IRC operators: client connect and disconnect notices");
        } else if letter == "d" {
            return @tr("IRC operators: receive DEBUG messages");
        } else if letter == "e" {
            return @tr("IRC operators: receive invalid DCC notices");
        } else if letter == "f" {
            return @tr("IRC operators: receive FLOOD messages");
        } else if letter == "g" {
            return @tr("IRC operators: receive GLOBOPS messages");
        } else if letter == "k" {
            return @tr("IRC operators: receive KILL notices");
        } else if letter == "K" {
            return @tr("IRC operators: receive KILL notices from U:Lines");
        } else if letter == "m" {
            return @tr("IRC operators: receive SPAM messages");
        } else if letter == "n" {
            return @tr("IRC operators: receive ROUTING messages");
        } else if letter == "y" {
            return @tr("IRC operators: notified of /ADMIN, /LINKS, /WHOIS and similar");
        } else if letter == "F" {
            return @tr("IRC operators: immune from flood limits");
        } else if letter == "I" {
            return @tr("IRC operators: idle time hidden in WHOIS");
        } else if letter == "j" {
            return @tr("chatting from the web via Java");
        } else if letter == "S" {
            return @tr("connected to the server via SSL");
        } else if letter == "o" {
            return @tr("IRC operator, granted by the server");
        } else if letter == "O" {
            return @tr("local IRC operator, granted by the server");
        } else if letter == "r" {
            return @tr("identified to NickServ, set by services");
        } else if letter == "a" {
            return @tr("services administrator, set by services");
        } else if letter == "A" {
            return @tr("server administrator, set by the server");
        } else if letter == "h" {
            return @tr("services help operator");
        } else if letter == "z" {
            return @tr("services agent");
        }
        return @tr("user mode, no description available");
    }
