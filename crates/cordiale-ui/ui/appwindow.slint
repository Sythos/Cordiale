    function editor-color-label(key: string, nick-index: int) -> string {
        if key == "bg" {
            return @tr("Background");
        } else if key == "bg_alt" {
            return @tr("Alternate background");
        } else if key == "fg" {
            return @tr("Text");
        } else if key == "accent" {
            return @tr("Accent");
        } else if key == "muted" {
            return @tr("Muted text");
        } else if key == "border" {
            return @tr("Borders");
        } else if key == "mention" {
            return @tr("Mentions");
        } else if key == "mode_op" {
            return @tr("Operators");
        } else if key == "mode_halfop" {
            return @tr("Half-operators");
        } else if key == "mode_voiced" {
            return @tr("Voiced");
        } else if key == "mode_plain" {
            return @tr("Plain members");
        }
        return @tr("Nick color {}", nick-index + 1);
    }
    in property <bool> theme-has-night: false;
