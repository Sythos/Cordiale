export component AppWindow inherits Window {
    in property <string> app_title: "Cordiale";

    width: 900px;
    height: 600px;

    VerticalLayout {
        padding: 32px;
        spacing: 16px;

        Text {
            text: app_title;
            font-size: 28px;
            horizontal-alignment: center;
        }

        Text {
            text: "Grappa desktop client scaffold";
            horizontal-alignment: center;
        }
    }
}
