    // Maps a machine-readable `status-kind` (set from Rust, never
    // English text directly) to a translated template — the only way to
    // get Rust-originated dynamic status text through Slint's `@tr()`
    // translation system, since `@tr()` only works on string literals
    // that live in a `.slint` file.
    // Sidebar connection labels arrive from Rust as English keys
    // ("connecting", "reconnecting", "paused", "connection failed").
    function connection-label-text(label: string) -> string {
        if label == "connecting" {
            return @tr("connecting");
        } else if label == "reconnecting" {
            return @tr("reconnecting");
        } else if label == "paused" {
            return @tr("paused");
        } else if label == "connection failed" {
            return @tr("connection failed");
        } else {
            return label;
        }
    }

    function reply-title-text() -> string {
        if reply-kind == "who_reply" {
            return @tr("WHO {} on {}", reply-subject, reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "motd" {
            return @tr("Message of the day on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "info" {
            return @tr("Server information on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "version" {
            return @tr("Server version on {}", reply-network);
        } else if reply-kind == "server_reply" && reply-subject == "admin" {
            return @tr("Server administrator on {}", reply-network);
        } else if reply-kind == "whois_bundle" {
            return @tr("WHOIS {} on {}", reply-subject, reply-network);
        } else if reply-kind == "whowas_bundle" {
            return @tr("WHOWAS {} on {}", reply-subject, reply-network);
        } else if reply-kind == "banlist_bundle" {
            return @tr("Mode list {} on {}", reply-subject, reply-network);
        } else if reply-kind == "mentions_bundle" {
            return @tr("Mentions while you were away on {}", reply-network);
        } else if reply-kind == "lusers_bundle" {
            return @tr("Network statistics for {}", reply-network);
        } else {
            return reply-network;
        }
    }

    function reply-label(key: string) -> string {
        if key == "who-empty" {
            return @tr("No users matched.");
        } else if key == "reply-empty" {
            return @tr("The server sent no lines.");
        } else if key == "whois-userhost" {
            return @tr("Address");
        } else if key == "whois-realname" {
            return @tr("Real name");
        } else if key == "whois-server" {
            return @tr("Server");
        } else if key == "whois-account" {
            return @tr("Account");
        } else if key == "whois-channels" {
            return @tr("Channels");
        } else if key == "whois-idle" {
            return @tr("Idle");
        } else if key == "whois-signon" {
            return @tr("Signed on");
        } else if key == "whois-away" {
            return @tr("Away");
        } else if key == "whois-operator" {
            return @tr("IRC operator");
        } else if key == "whois-umodes" {
            return @tr("User modes");
        } else if key == "whois-secure" {
            return @tr("Secure connection");
        } else if key == "whois-certfp" {
            return @tr("Certificate fingerprint");
        } else if key == "whois-actually" {
            return @tr("Actual host");
        } else if key == "whois-registered" {
            return @tr("Registered nick");
        } else if key == "whois-admin" {
            return @tr("Server administrator");
        } else if key == "whois-services-admin" {
            return @tr("Services administrator");
        } else if key == "whois-helper" {
            return @tr("Helper");
        } else if key == "whois-chanop" {
            return @tr("Channel operator");
        } else if key == "whois-agent" {
            return @tr("Agent");
        } else if key == "whois-java" {
            return @tr("Java client");
        } else if key == "whois-avatar" {
            return @tr("Avatar available on the server");
        } else if key == "whowas-logoff" {
            return @tr("Last seen");
        } else if key == "whowas-not-found" {
            return @tr("The server has no history for this nick.");
        } else if key == "banlist-empty" {
            return @tr("The list is empty.");
        } else if key == "mentions-away-period" {
            return @tr("Away");
        } else if key == "mentions-away-reason" {
            return @tr("Away message");
        } else if key == "mentions-empty" {
            return @tr("Nobody mentioned you.");
        } else if key == "lusers-total-users" {
            return @tr("Users");
        } else if key == "lusers-invisible" {
            return @tr("Invisible");
        } else if key == "lusers-servers" {
            return @tr("Servers");
        } else if key == "lusers-operators" {
            return @tr("Operators online");
        } else if key == "lusers-unknown-connections" {
            return @tr("Unknown connections");
        } else if key == "lusers-channels-formed" {
            return @tr("Channels formed");
        } else if key == "lusers-local-clients" {
            return @tr("Clients on this server");
        } else if key == "lusers-local-servers" {
            return @tr("Servers linked to this server");
        } else if key == "lusers-current-local" {
            return @tr("Current local users");
        } else if key == "lusers-max-local" {
            return @tr("Max local users");
        } else if key == "lusers-current-global" {
            return @tr("Current global users");
        } else if key == "lusers-max-global" {
            return @tr("Max global users");
        } else {
            return key;
        }
    }

    function recover-step-label(step: string) -> string {
        if step == "identify" {
            return @tr("Identify with services");
        } else if step == "register" {
            return @tr("Confirm registration");
        } else if step == "nick" {
            return @tr("Switch nick");
        } else if step == "recover" {
            return @tr("Recover the nick");
        } else if step == "release" {
            return @tr("Release the nick");
        } else {
            return step;
        }
    }

    function recover-status-label(status: string) -> string {
        if status == "running" {
            return @tr("in progress");
        } else if status == "ok" {
            return @tr("done");
        } else if status == "failed" {
            return @tr("failed");
        } else {
            return status;
        }
    }

    // Grappa's four known reasons are localized; any additive future reason
    // is shown verbatim rather than dropped.
    function recover-reason-label(reason: string) -> string {
        if reason == "wrong_password" {
            return @tr("wrong password");
        } else if reason == "nick_unavailable" {
            return @tr("nick unavailable");
        } else if reason == "services_declined" {
            return @tr("services declined");
        } else if reason == "identify_unconfirmed" {
            return @tr("identification not confirmed");
        } else {
            return reason;
        }
    }

    function directory-status-text() -> string {
        if directory-status == "fresh" || directory-status == "stale" {
            return directory-status == "fresh"
                ? @tr("{} channels, listed {}.", directory-total, directory-captured-at)
                : @tr("{} channels, listed {} (may be out of date).", directory-total, directory-captured-at);
        } else if directory-status == "no_results" {
            return @tr("The server listed no channels.");
        } else if directory-status == "loading" {
            return @tr("Listing channels…");
        } else if directory-status == "unknown" {
            return @tr("No channel list yet.");
        } else {
            return "";
        }
    }

    function archive-error-text() -> string {
        if archive-error == "archive-rate-limited" {
            return @tr("Too many archive requests. Wait a moment and try again.");
        } else if archive-error == "archive-fetch-failed" {
            return @tr("Couldn't load the archive.");
        } else if archive-error == "archive-delete-failed" {
            return @tr("Couldn't delete that history.");
        } else {
            return archive-error;
        }
    }

    function directory-error-text() -> string {
        if directory-error == "directory-fetch-failed" {
            return @tr("Couldn't load the channel list.");
        } else if directory-error == "directory-refresh-failed" {
            return @tr("Couldn't refresh the channel list. Is the network connected?");
        } else {
            return directory-error;
        }
    }

    function status-text() -> string {
        if status-kind == "signed-in" {
            return @tr("Signed in. {} network(s), {} channel(s).", status-network-count, status-channel-count);
        } else if status-kind == "wrong-credentials" {
            return @tr("Wrong username or password/token.");
        } else if status-kind == "reauthentication-required" {
            return @tr("Saved sign-in is unavailable. Enter your password or client token to sign in again.");
        } else if status-kind == "away-delay-invalid" {
            return @tr("The auto-away delay must be a whole number of seconds.");
        } else if status-kind == "personal-prefs-saved" {
            return @tr("Settings saved.");
        } else if status-kind == "personal-prefs-failed" {
            return @tr("Couldn't save those settings.");
        } else if status-kind == "command-refused" {
            return @tr("The server refused that command ({}).", status-command-hint);
        } else if status-kind == "alias-too-deep" {
            return @tr("That alias expands into too many others: {}", status-command-hint);
        } else if status-kind == "kickban-host-unknown" {
            return @tr("{}'s host isn't known yet, so they were only kicked; /whois them first to ban too.", status-command-hint);
        } else if status-kind == "command-topic" {
            return @tr("Topic of {}", status-command-hint);
        } else if status-kind == "command-no-topic" {
            return @tr("{} has no topic.", status-command-hint);
        } else if status-kind == "command-modes" {
            return @tr("Modes of {}", status-command-hint);
        } else if status-kind == "command-no-modes" {
            return @tr("No modes known for {} yet.", status-command-hint);
        } else if status-kind == "conversation-muted" {
            return @tr("Conversation muted: other devices won't be notified about it.");
        } else if status-kind == "beep-current" {
            return @tr("Notification sound: {}", status-command-hint);
        } else if status-kind == "beep-set" {
            return @tr("Notification sound set to {}.", status-command-hint);
        } else if status-kind == "beep-unknown" {
            return @tr("Unknown sound. Available: {}", status-command-hint);
        } else if status-kind == "np-idle" {
            return @tr("/np: nothing is playing. Tune a station from the radio first.");
        } else if status-kind == "np-unsupported" {
            return @tr("/np: {} publishes no track information.", status-command-hint);
        } else if status-kind == "np-unanswered" {
            return @tr("/np: no track from {} yet; its feed hasn't answered.", status-command-hint);
        } else if status-kind == "np-stale" {
            return @tr("/np: the last track from {} is over 3 minutes old, so it wasn't sent.", status-command-hint);
        } else if status-kind == "radio-station-invalid" {
            return @tr("A station needs a name and an http:// or https:// stream URL.");
        } else if status-kind == "command-usage-hint" {
            return @tr("Usage: {}", status-command-hint);
        } else if status-kind == "command-unknown" {
            return @tr("Unknown command: {}", status-command-hint);
        } else if status-kind == "command-needs-channel" {
            return @tr("{} only works in a channel window.", status-command-hint);
        } else if status-kind == "command-failed" {
            return @tr("{} failed.", status-command-hint);
        } else if status-kind == "command-usage" {
            return @tr("That command is missing an argument, for example: /whowas <nick>.");
        } else if status-kind == "session-severed-flood" {
            return @tr("You were signed out because this client sent too many requests. Your IRC session is still running; sign in again to continue.");
        } else if status-kind == "two-factor-required" {
            return @tr("This account has two-factor authentication enabled. Sign in from a browser instead.");
        } else if status-kind == "too-many-attempts" {
            return @tr("Too many attempts. Wait a bit before trying again.");
        } else if status-kind == "login-failed" {
            return @tr("Login failed.");
        } else if status-kind == "boot-me-failed" {
            return @tr("Signed in, but couldn't load account data.");
        } else if status-kind == "unreachable" {
            return @tr("Couldn't reach the server. Check the URL and try again.");
        } else if status-kind == "protocol-too-old" {
            return @tr("This server's protocol version ({}) is too old for Cordiale.", status-protocol-version);
        } else if status-kind == "notify-prefs-invalid" {
            return @tr("Keep at least one message notification on.");
        } else if status-kind == "notify-prefs-failed" {
            return @tr("Couldn't save the notification settings.");
        } else if status-kind == "admin-action-done" {
            return @tr("Done.");
        } else if status-kind == "admin-action-failed" {
            return @tr("The server refused that admin action ({}).", status-command-hint);
        } else if status-kind == "admin-credential-invalid" {
            return @tr("A credential needs an account, a network and a nickname.");
        } else if status-kind == "admin-server-invalid" {
            return @tr("A server needs a host and a port between 1 and 65535.");
        } else if status-kind == "admin-setting-invalid" {
            return @tr("Sizes and the video length must be positive numbers.");
        } else if status-kind == "admin-cap-invalid" {
            return @tr("Caps must be whole numbers, or empty for unlimited.");
        } else if status-kind == "send-failed" {
            return @tr("Couldn't send that message.");
        } else if status-kind == "part-failed" {
            return @tr("Couldn't leave the channel. Please try again.");
        } else if status-kind == "disconnected" {
            return status-message == "" ? @tr("Disconnected. Reconnecting…") : @tr("Disconnected. Reconnecting… ({})", status-message);
        } else if status-kind == "reconnecting" {
            return status-message == "" ? @tr("Reconnecting…") : @tr("Reconnecting… ({})", status-message);
        } else if status-kind == "presence-online" {
            return @tr("{} is now online on {}.", status-presence-nick, status-presence-network);
        } else if status-kind == "presence-offline" {
            return @tr("{} went offline on {}.", status-presence-nick, status-presence-network);
        } else if status-kind == "presence-list-full" {
            return @tr("The watch list on {} is full; not watched: {}.", status-presence-network, status-presence-nick);
        } else if status-kind == "presence-rejected" {
            return @tr("The server on {} refused to watch: {}.", status-presence-network, status-presence-nick);
        } else if status-kind == "dcc-accepted" {
            return @tr("Accepted {} from {}; the transfer runs on the server.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-refused" {
            return @tr("Refused {} from {}.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-expired" {
            return @tr("The offer of {} from {} expired.", status-dcc-filename, status-dcc-from);
        } else if status-kind == "dcc-offer-gone" {
            return @tr("That file offer is no longer available.");
        } else if status-kind == "dcc-rate-limited" {
            return @tr("Daily file transfer limit reached. Try again later.");
        } else if status-kind == "dcc-not-connected" {
            return @tr("That network isn't connected, so the file offer can't be answered.");
        } else if status-kind == "dcc-no-space" {
            return @tr("The server has no room left for this file.");
        } else if status-kind == "dcc-action-failed" {
            return @tr("Couldn't answer the file offer.");
        } else if status-kind == "no-mentions" {
            return @tr("No away summary for this network yet.");
        } else if status-kind == "invite-sent" {
            return @tr("Invited {} to {} on {}.", status-invite-peer, status-invite-channel, status-invite-network);
        } else if status-kind == "attach-uploading" {
            return @tr("Uploading {}…", status-attach-name);
        } else if status-kind == "attach-sent" {
            return @tr("Uploaded {}; its link was posted.", status-attach-name);
        } else if status-kind == "attach-unsupported-type" {
            return @tr("The server doesn't accept this type of file: {}", status-attach-name);
        } else if status-kind == "attach-too-large" {
            return @tr("{} is larger than the server allows for this type of file.", status-attach-name);
        } else if status-kind == "attach-no-space" {
            return @tr("The server has no room left for {}.", status-attach-name);
        } else if status-kind == "attach-read-failed" {
            return @tr("Couldn't read {}.", status-attach-name);
        } else if status-kind == "attach-no-window" {
            return @tr("Open a channel or private conversation before attaching a file.");
        } else if status-kind == "attach-failed" {
            return @tr("Couldn't upload {}.", status-attach-name);
        } else if status-kind == "theme-change-failed" {
            return @tr("Couldn't change the theme on the server.");
        } else {
            return status-message;
        }
    }

    // Invisible measuring probes for the side columns' minimum widths.
    sidebar-label-probe := Button {
        text: sidebar-widest-label;
        visible: false;
        enabled: false;
    }
    members-nick-probe := Text {
        text: members-average-nick;
        visible: false;
    }
    actions-probe := Button {
        text: "☰ " + @tr("Actions") + " ▾";
        visible: false;
        enabled: false;
    }

    if screen == "splash" : VerticalBox {
        padding: 32px;
        spacing: 24px;
        alignment: center;

        property <float> splash-progress: 0;
        animate splash-progress {
            duration: 1800ms;
            easing: ease-out;
        }

        init => {
            splash-progress = 1.0;
        }

        Timer {
            interval: 1900ms;
            running: true;
            triggered => {
                screen = next-screen;
            }
        }

        Image {
            source: @image-url("../../../resources/branding/cordiale.png");
            image-fit: contain;
            height: 220px;
        }

        ProgressIndicator {
            progress: splash-progress;
        }
    }

    if screen == "language" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: @tr("Choose your language");
            font-size: 22px;
            horizontal-alignment: center;
        }

        // Language names are shown in their own language regardless of
        // the current UI language (so a French speaker can still find
        // "Français" even if the UI is currently in English) — never
        // wrapped in @tr().
        Button {
            text: "English";
            clicked => { language-selected("en"); }
        }
        Button {
            text: "Italiano";
            clicked => { language-selected("it"); }
        }
        Button {
            text: "Français";
            clicked => { language-selected("fr"); }
        }
        Button {
            text: "Deutsch";
            clicked => { language-selected("de"); }
        }
        Button {
            text: "Español";
            clicked => { language-selected("es"); }
        }
    }

    if screen == "connect" : VerticalBox {
        padding: 32px;
        spacing: 16px;

        Text {
            text: "Cordiale";
            font-size: 28px;
            horizontal-alignment: center;
        }

        LineEdit {
            placeholder-text: @tr("Server URL");
            accessible-label: @tr("Server URL");
            text <=> server-url;
        }

        LineEdit {
            placeholder-text: @tr("Username");
            accessible-label: @tr("Username");
            text <=> identifier;
        }

        LineEdit {
            placeholder-text: @tr("Password or client token");
            accessible-label: @tr("Password or client token");
            text <=> password;
            // Qualified as `InputType.password`, not bare `password`: this
            // component also has a property named `password` (the text
            // itself), which would otherwise shadow the enum variant.
            input-type: InputType.password;
        }

        Button {
            text: connecting ? @tr("Connecting…") : @tr("Connect");
            enabled: !connecting;
            clicked => { connect-requested(server-url, identifier, password); }
        }

        if saved-profile-identifier != "" && saved-profile-identifier == identifier && saved-profile-server-url == server-url : Button {
            text: @tr("Sign in with saved profile");
            enabled: !connecting;
            clicked => { saved-profile-connect-requested(server-url, identifier); }
        }

        Button {
            text: @tr("Change language");
            clicked => { screen = "language"; }
        }

        Text {
            text: status-text();
            color: #cc3333;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if known-servers.length > 0 : VerticalBox {
            padding-top: 8px;
            spacing: 4px;

            Text {
                text: @tr("Previously used servers");
                font-size: 14px;
            }

            for known in known-servers : Button {
                text: known;
                accessible-label: @tr("Switch to server {}", known);
                clicked => { server-selected(known); }
            }
        }
    }

    if screen == "connected" : HorizontalBox {
        padding: 16px;
        spacing: 8px;

        VerticalBox {
            width: max(sidebar-width, sidebar-min-width);
            spacing: 8px;

            HorizontalLayout {
                alignment: start;
                spacing: 4px;

                Button {
                    text: "🏠";
                    accessible-label: @tr("Home");
                    width: 32px;
                    height: 32px;
                    clicked => { home-requested(); }
                }

                if is-admin : Button {
                    text: "🛡";
                    accessible-label: @tr("Admin");
                    width: 32px;
                    height: 32px;
                    clicked => {
                        screen = "settings";
                        settings-section = "admin";
                    }
                }

                Button {
                    text: "⚙";
                    accessible-label: @tr("Settings");
                    width: 32px;
                    height: 32px;
                    clicked => { screen = "settings"; }
                }

                // Signing out is how the user switches accounts: it also
                // turns off the automatic sign-in at the next launch.
                Button {
                    text: "⏏";
                    accessible-label: @tr("Disconnect");
                    width: 32px;
                    height: 32px;
                    clicked => { disconnect-requested(); }
                }
            }

            // Once actually signed in, this row of icons is the whole
            // story — the connecting/error/reconnecting text below only
            // shows while there's something to report, so a healthy
            // session doesn't sit under a permanent status paragraph.
            if status-kind != "signed-in" : Text {
                text: @tr("Connected to {}", server-url);
                wrap: word-wrap;
            }

            if status-kind != "signed-in" : Text {
                text: status-text();
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
                accessible-live-region: AccessibleLiveness.polite;
            }

            if window-invite-banner != "" : Rectangle {
                background: theme == "dark" ? #3a321f : #fff2bf;
                border-width: 1px;
                border-color: theme == "dark" ? #c99b2e : #b58a00;
                padding: 6px;
                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: window-invite-banner;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Join");
                        accessible-label: @tr("Join invited channel");
                        clicked => {
                            window-invite-join-requested(window-invite-network, window-invite-channel);
                        }
                    }
                }
            }

            if recover-visible : Rectangle {
                background: theme == "dark" ? #1f2d3a : #e3f0ff;
                border-width: 1px;
                border-color: theme == "dark" ? #4a7fb0 : #3d7cc9;
                padding: 6px;
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: @tr("Identity recovery on {}", recover-network);
                        wrap: word-wrap;
                        font-weight: 700;
                        accessible-role: AccessibleRole.text;
                    }
                    for row in recover-steps : Text {
                        text: row.reason == ""
                            ? @tr("{}: {}", recover-step-label(row.step), recover-status-label(row.status))
                            : @tr("{}: {} ({})", recover-step-label(row.step), recover-status-label(row.status), recover-reason-label(row.reason));
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    if recover-outcome != "" : Text {
                        text: recover-outcome == "succeeded"
                            ? @tr("Identity recovered.")
                            : (recover-outcome-reason == ""
                                ? @tr("Recovery failed.")
                                : @tr("Recovery failed ({}).", recover-reason-label(recover-outcome-reason)));
                        wrap: word-wrap;
                        font-weight: 700;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Dismiss");
                        accessible-label: @tr("Dismiss identity recovery");
                        clicked => { recover-dismiss-requested(); }
                    }
                }
            }

            for offer in dcc-offers : Rectangle {
                background: theme == "dark" ? #2a2438 : #f0eaff;
                border-width: 1px;
                border-color: theme == "dark" ? #8a74c9 : #6b4fc0;
                padding: 6px;
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: @tr("{} offers {} ({}) on {}", offer.from, offer.filename, offer.size, offer.network);
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    HorizontalBox {
                        spacing: 4px;
                        padding: 0px;
                        Button {
                            text: @tr("Accept");
                            accessible-label: @tr("Accept {} from {}", offer.filename, offer.from);
                            clicked => { dcc-offer-accept-requested(offer.network, offer.offer-id); }
                        }
                        Button {
                            text: @tr("Refuse");
                            accessible-label: @tr("Refuse {} from {}", offer.filename, offer.from);
                            clicked => { dcc-offer-refuse-requested(offer.network, offer.offer-id); }
                        }
                    }
                }
            }

            ListView {
                vertical-stretch: 1;

                for group in network-groups : VerticalLayout {
                    alignment: start;
                    spacing: 0px;
                    padding-top: group.separator-before ? 8px : 0px;

                    if group.separator-before : Rectangle {
                        height: 1px;
                        horizontal-stretch: 1;
                        background: #808080;
                    }

                    if !group.parked : Button {
                        text: (group.expanded ? "▾ 🔌 " : "▸ 🔌 ") + group.network
                            + (group.connection-label == "" ? "" : " · " + connection-label-text(group.connection-label));
                        accessible-label: group.network
                            + (group.connection-label == "" ? "" : " — " + connection-label-text(group.connection-label));
                        clicked => { network-toggle-requested(group.network); }
                    }
                    if group.parked : HorizontalLayout {
                        spacing: 4px;
                        Button {
                            text: group.expanded ? "▾" : "▸";
                            width: 28px;
                            accessible-label: @tr("Expand or collapse parked network {}", group.network);
                            clicked => { network-toggle-requested(group.network); }
                        }
                        Text {
                            text: @tr("{} [PARKED]", group.network);
                            font-italic: true;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                        }
                    }

                    // Channel and query rows sit directly under their
                    // network row, with no gap between them.
                    if group.expanded : VerticalLayout {
                        alignment: start;
                        padding-left: 16px;
                        spacing: 0px;

                        for entry in group.channels : HorizontalLayout {
                            spacing: 4px;

                            Button {
                                horizontal-stretch: 1;
                                text: (entry.invited ? "🔔 " : "") + entry.label + entry.mention-badge;
                                accessible-label: entry.label + entry.mentions-description
                                    + (entry.invited
                                        ? " — invited"
                                        : (entry.kicked
                                            ? " — kicked"
                                            : (entry.failed ? " — join failed" : "")));
                                // Cicchetto keeps failed and kicked channels as
                                // muted, selectable pseudo-windows; details
                                // remain in session state, not in the row.
                                opacity: (entry.failed || entry.kicked) ? 0.55 : 1.0;
                                clicked => { channel-selected(entry.network, entry.channel); }
                            }

                            if entry.unread-description != "" : Text {
                                text: entry.unread-count;
                                accessible-label: entry.unread-description;
                                accessible-role: AccessibleRole.text;
                                horizontal-alignment: right;
                                min-width: 28px;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            if entry.kicked : Button {
                                text: "×";
                                accessible-label: @tr("Dismiss kicked channel {}", entry.label);
                                width: 28px;
                                clicked => {
                                    kicked-channel-dismiss-requested(entry.network, entry.channel);
                                }
                            }
                            if entry.joined : Button {
                                text: "×";
                                accessible-label: @tr("Leave channel {} on {}", entry.channel, entry.network);
                                width: 28px;
                                clicked => { channel-part-requested(entry.network, entry.channel); }
                            }
                        }

                        for query in group.queries : Button {
                            horizontal-stretch: 1;
                            text: "↳ " + query.label + query.mention-badge;
                            accessible-label: @tr("Private conversation with {} on {}", query.nick, query.network)
                                + query.mentions-description;
                            clicked => { query-selected(query.network, query.nick); }
                        }
                    }
                }
            }
        }

        ResizeHandle {
            target-width <=> sidebar-width;
            target-min-width: sidebar-min-width;
            target-max-width: max(360px, sidebar-min-width);
        }

        VerticalBox {
            spacing: 8px;

            Text {
                text: current-channel-label;
                font-size: 14px;
                font-weight: 700;
                color: palette-active ? palette-accent : Palette.foreground;
            }
            if has-selected-channel && !current-query : Rectangle {
                height: 60px;
                background: palette-active ? palette-bg-alt : (theme == "dark" ? #242424 : #f5f5f5);
                border-width: 1px;
                border-color: palette-active ? palette-border : (theme == "dark" ? #5c5c5c : #d0d0d0);
                padding: 3px;
                Text {
                    text: current-topic == "" ? @tr("No topic set") : current-topic;
                    font-size: 14px;
                    wrap: word-wrap;
                    max-height: 54px;
                    vertical-alignment: top;
                }
            }
            if current-channel-modes != "" : Text {
                text: current-channel-modes;
                font-size: 12px;
            }
            if !current-query && window-note-kind != "" : Rectangle {
                background: theme == "dark" ? #3a2424 : #fde2e2;
                border-width: 1px;
                border-color: theme == "dark" ? #b04a4a : #c0392b;

                HorizontalBox {
                    Text {
                        text: window-note-kind == "kicked"
                            ? (window-note-actor == ""
                                ? (window-note-reason == ""
                                    ? @tr("You were kicked from this channel.")
                                    : @tr("You were kicked from this channel: {}", window-note-reason))
                                : (window-note-reason == ""
                                    ? @tr("{} kicked you from this channel.", window-note-actor)
                                    : @tr("{} kicked you from this channel: {}", window-note-actor, window-note-reason)))
                            : (window-note-reason == ""
                                ? @tr("Joining this channel failed.")
                                : @tr("Joining this channel failed: {}", window-note-reason));
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                }
            }

            if current-query && peer-away-visible : Rectangle {
                background: theme == "dark" ? #3a321f : #fff2bf;
                border-width: 1px;
                border-color: theme == "dark" ? #c99b2e : #b58a00;
                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: peer-away-message == ""
                            ? @tr("{} is away.", peer-away-peer)
                            : @tr("{} is away: {}", peer-away-peer, peer-away-message);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-live-region: AccessibleLiveness.polite;
                    }
                    Button {
                        text: @tr("Dismiss");
                        accessible-label: @tr("Dismiss away message");
                        clicked => { peer-away-dismiss-requested(); }
                    }
                }
            }

            if chat-lines.length > 0 && !history-start-reached : HorizontalLayout {
                alignment: center;

                CompactButton {
                    text: history-loading ? @tr("Loading…") : "⤒  " + @tr("Load older messages");
                    a11y-label: @tr("Load older messages");
                    enabled: !history-loading;
                    clicked => { older-history-requested(); }
                }
            }

            ListView {
                vertical-stretch: 1;

                for line in chat-lines : HorizontalLayout {
                    alignment: start;
                    spacing: 0px;

                    Text {
                        text: "[" + line.timestamp + "] ";
                        color: line.timestamp-color;
                        font-italic: line.italic;
                    }

                    if line.nick != "" : MemberContextMenu {
                        target-nick: line.nick;
                        can-moderate: can-moderate-members;
                        display-text: "<" + line.nick-prefix + line.nick + "> ";
                        text-color: line.nick-color;
                        text-bold: true;
                        text-italic: line.italic;
                        mode-action(verb, nick) => { member-mode-action-requested(verb, nick); }
                        kick(nick) => { member-kick-requested(nick); }
                        ban(nick) => { member-ban-requested(nick); }
                        whois(nick) => { member-whois-requested(nick); }
                        ctcp(nick, verb) => { member-ctcp-requested(nick, verb); }
                        query(nick) => { member-query-requested(nick); }
                    }

                    StyledText {
                        text: line.body;
                        default-color: theme == "dark" ? white : black;
                        horizontal-stretch: 1;
                    }
                }
            }

            // The radio on air, docked above the compose bar like
            // Cicchetto's mini-player.
            if radio-status != "" : HorizontalLayout {
                spacing: 8px;
                padding-left: 6px;
                padding-right: 6px;

                Text {
                    text: radio-status == "connecting"
                        ? "📻  " + @tr("{}: connecting…", radio-station)
                        : radio-status == "failed"
                        ? "📻  " + @tr("{}: the stream failed ({})", radio-station, radio-error)
                        : radio-status == "ended"
                        ? "📻  " + @tr("{}: the station ended the stream", radio-station)
                        : radio-track == ""
                        ? "📻  " + radio-station
                        : "📻  " + radio-station + " — " + radio-track;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Slider {
                    minimum: 0;
                    maximum: 100;
                    value: radio-volume;
                    width: 100px;
                    released(value) => {
                        radio-volume = Math.round(value);
                        radio-volume-changed(radio-volume);
                    }
                }
                CompactButton {
                    text: "⏹";
                    a11y-label: @tr("Stop the radio");
                    clicked => { radio-stop(); }
                }
            }

            // Small compose bar, never more than one line tall: paperclip
            // to attach a file (left, like Cicchetto), text field, send
            // icon (right).
            HorizontalBox {
                height: 40px;
                spacing: 6px;

                Button {
                    text: "📎";
                    accessible-label: @tr("Attach file");
                    width: 36px;
                    enabled: !current-query || current-query-ready;
                    clicked => { attach-file-requested(); }
                }

                LineEdit {
                    placeholder-text: @tr("Message");
                    accessible-label: @tr("Message");
                    text <=> compose-text;
                    enabled: !current-query || current-query-ready;
                    accepted => { send-chat-message(compose-text); }
                    edited(new-text) => { compose-text-changed(new-text); }
                }

                Button {
                    text: "➤";
                    accessible-label: @tr("Send");
                    width: 36px;
                    enabled: current-query ? current-query-ready : has-selected-channel;
                    clicked => { send-chat-message(compose-text); }
                }
            }
        }

        // Always present on the "connected" screen, not just once a
        // channel is open: the "actions" row at its bottom (global nav,
        // not per-member) doesn't depend on a channel selection at all,
        // and hiding the whole column also hid it.
        ResizeHandle {
            target-width <=> members-width;
            target-min-width: members-min-width;
            target-max-width: max(320px, members-min-width);
        }

        VerticalBox {
            width: max(members-width, members-min-width);
            spacing: 4px;

            if current-window-is-joined && !current-query : Text {
                text: @tr("Members ({})", channel-members.length);
                font-size: 14px;
            }

            if current-window-is-joined && !current-query : ListView {
                vertical-stretch: 1;

                for member in channel-members : MemberContextMenu {
                    target-nick: member.name;
                    can-moderate: can-moderate-members;
                    display-text: member.prefix == "" ? member.name : "[" + member.prefix + "] " + member.name;
                    text-color: member.color;
                    mode-action(verb, nick) => { member-mode-action-requested(verb, nick); }
                    kick(nick) => { member-kick-requested(nick); }
                    ban(nick) => { member-ban-requested(nick); }
                    whois(nick) => { member-whois-requested(nick); }
                    ctcp(nick, verb) => { member-ctcp-requested(nick, verb); }
                    query(nick) => { member-query-requested(nick); }
                }
            }

            // Keep the global Actions row anchored at the bottom even when
            // the selected window isn't joined and the roster is hidden.
            if !current-window-is-joined || current-query : Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            // Cicchetto's own bottom-of-members-column "actions" row (a
            // plain click, not a right-click, unlike `MemberContextMenu`)
            // — confirmed against its real source and the user's own
            // screenshot: a global nav/utility menu, not a per-member one.
            // Only lists what Cordiale actually has; Cicchetto's version
            // also has the radio.
            HorizontalLayout {
                alignment: start;

                Button {
                    text: "☰ " + @tr("Actions") + " ▾";
                    clicked => { actions-menu-area.show({ x: 0px, y: 0px }); }
                }

                actions-menu-area := ContextMenuArea {
                    Menu {
                        MenuItem { title: "🏠  " + @tr("Home"); activated => { home-requested(); } }
                        MenuItem { title: "🚪  " + @tr("Rooms"); activated => { menu-command("/list"); } }
                        MenuItem { title: "📂  " + @tr("Archive"); activated => { menu-command("/archive"); } }
                        MenuItem { title: "👤  " + @tr("User modes"); activated => { menu-command("/umode"); } }
                        MenuItem { title: "⚙  " + @tr("Settings"); activated => { screen = "settings"; } }
                        MenuItem {
                            title: "🎨  " + @tr("Themes");
                            activated => {
                                screen = "settings";
                                settings-section = "themes";
                            }
                        }
                        MenuItem { title: "📻  " + @tr("Radio"); activated => { screen = "radio"; } }
                        if is-admin : MenuItem {
                            title: "🛡  " + @tr("Admin");
                            activated => {
                                screen = "settings";
                                settings-section = "admin";
                            }
                        }
                        Menu {
                            title: "🔕  " + @tr("Mute this conversation");
                            MenuItem { title: @tr("For 1 hour"); activated => { mute-current-requested(3600); } }
                            MenuItem { title: @tr("For 8 hours"); activated => { mute-current-requested(28800); } }
                            MenuItem { title: @tr("Until I unmute it"); activated => { mute-current-requested(0); } }
                        }
                        MenuItem { title: "🔁  " + @tr("Switch account"); activated => { disconnect-requested(); } }
                    }
                }
            }
        }
    }

    if screen == "settings" : HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // Section navigation, in Cicchetto's Settings drawer order. Each
        // entry carries an icon matching what the section is for.
        VerticalLayout {
            width: 210px;
            spacing: 2px;
            alignment: start;

            Text {
                text: @tr("Settings");
                font-size: 18px;
                font-weight: 600;
            }
            Rectangle { height: 6px; }

            NavButton {
                icon: "⚙";
                label: @tr("General");
                selected: settings-section == "general";
                clicked => { settings-section = "general"; }
            }
            NavButton {
                icon: "🖥";
                label: @tr("Display");
                selected: settings-section == "display";
                clicked => { settings-section = "display"; }
            }
            NavButton {
                icon: "🔒";
                label: @tr("Security");
                selected: settings-section == "security";
                clicked => { settings-section = "security"; }
            }
            NavButton {
                icon: "🎨";
                label: @tr("Themes");
                selected: settings-section == "themes";
                clicked => { settings-section = "themes"; }
            }
            NavButton {
                icon: "📻";
                label: @tr("Radio");
                selected: settings-section == "radio";
                clicked => { settings-section = "radio"; }
            }
            NavButton {
                icon: "🔔";
                label: @tr("Notifications");
                selected: settings-section == "push";
                clicked => {
                    settings-section = "push";
                    notification-prefs-requested();
                }
            }
            NavButton {
                icon: "👁";
                label: @tr("Watch Lists");
                selected: settings-section == "watchlists";
                clicked => { settings-section = "watchlists"; }
            }
            NavButton {
                icon: "🚫";
                label: @tr("Ignore List");
                selected: settings-section == "ignores";
                clicked => { settings-section = "ignores"; }
            }
            NavButton {
                icon: "↪";
                label: @tr("Aliases");
                selected: settings-section == "aliases";
                clicked => { settings-section = "aliases"; }
            }
            NavButton {
                icon: "▶";
                label: @tr("On-Connect Commands");
                selected: settings-section == "perform";
                clicked => { settings-section = "perform"; }
            }
            NavButton {
                icon: "🌐";
                label: @tr("Source Address");
                selected: settings-section == "vhost";
                clicked => { settings-section = "vhost"; }
            }
            if is-admin : NavButton {
                icon: "🛡";
                label: @tr("Admin");
                selected: settings-section == "admin";
                clicked => { settings-section = "admin"; }
            }
            NavButton {
                icon: "ℹ";
                label: @tr("Credits");
                selected: settings-section == "credits";
                clicked => { settings-section = "credits"; }
            }
            Rectangle { height: 10px; }
            NavButton {
                icon: "←";
                label: @tr("Back");
                clicked => { screen = "connected"; }
            }
        }

        Rectangle {
            width: 1px;
            background: #8080804d;
        }

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            if settings-section == "general" : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;

                SectionCard {
                    icon: "🗣";
                    title: @tr("Language");

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CompactButton {
                            text: "English";
                            clicked => { language-selected("en"); }
                        }
                        CompactButton {
                            text: "Italiano";
                            clicked => { language-selected("it"); }
                        }
                        CompactButton {
                            text: "Français";
                            clicked => { language-selected("fr"); }
                        }
                        CompactButton {
                            text: "Deutsch";
                            clicked => { language-selected("de"); }
                        }
                        CompactButton {
                            text: "Español";
                            clicked => { language-selected("es"); }
                        }
                    }
                }

                SectionCard {
                    icon: "🌓";
                    title: @tr("Theme");

                    CompactButton {
                        text: theme == "light" ? @tr("Switch to dark") : @tr("Switch to light");
                        clicked => { theme-toggle-requested(); }
                    }
                }

                if personal-prefs-loaded : SectionCard {
                    icon: "💤";
                    title: @tr("Away and leave messages");

                    Text {
                        text: @tr("Leave a field empty to use the server's default.");
                        wrap: word-wrap;
                    }
                    LineEdit {
                        placeholder-text: @tr("Quit/part message");
                        accessible-label: @tr("Quit/part message");
                        text <=> edit-leave-message;
                    }
                    LineEdit {
                        placeholder-text: @tr("Auto-away message");
                        accessible-label: @tr("Auto-away message");
                        text <=> edit-away-message;
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: @tr("Auto-away after (seconds, 0 = off)");
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            accessible-label: @tr("Auto-away after (seconds, 0 = off)");
                            text <=> edit-away-delay;
                            input-type: number;
                            horizontal-stretch: 0;
                            min-width: 90px;
                        }
                    }
                    CheckBox {
                        text: @tr("Look up other users' profiles (CTCP USERINFO)");
                        checked <=> pref-show-peer-profiles;
                    }
                    CompactButton {
                        text: "💾  " + @tr("Save");
                        a11y-label: @tr("Save");
                        clicked => { personal-prefs-save-requested(); }
                    }
                }

                if upload-prefs-loaded : SectionCard {
                    icon: "📎";
                    title: @tr("Uploads");

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: @tr("Keep uploaded files for");
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        ComboBox {
                            model: [
                                @tr("Server default"),
                                @tr("1 hour"),
                                @tr("12 hours"),
                                @tr("1 day"),
                                @tr("3 days")
                            ];
                            current-index <=> pref-upload-ttl-index;
                            horizontal-stretch: 0;
                            min-width: 140px;
                            selected => { upload-prefs-changed(); }
                        }
                    }
                    CheckBox {
                        text: @tr("Ask before uploading");
                        checked <=> pref-upload-confirm;
                        toggled => { upload-prefs-changed(); }
                    }
                }

                SectionCard {
                    icon: "🔌";
                    title: @tr("Connection");

                    CompactButton {
                        text: "⏏  " + @tr("Disconnect");
                        a11y-label: @tr("Disconnect");
                        clicked => { disconnect-requested(); }
                    }

                    if server-upload-limits-known : Text {
                        text: server-upload-limits.video-seconds == ""
                            ? @tr("Server upload limits ({}): images {}, videos {}, documents {}, audio {}.", server-upload-limits.host, server-upload-limits.image, server-upload-limits.video, server-upload-limits.document, server-upload-limits.audio)
                            : @tr("Server upload limits ({}): images {}, videos {} (up to {} s), documents {}, audio {}.", server-upload-limits.host, server-upload-limits.image, server-upload-limits.video, server-upload-limits.video-seconds, server-upload-limits.document, server-upload-limits.audio);
                        wrap: word-wrap;
                    }
                }

                if known-networks.length > 0 : SectionCard {
                    icon: "🪪";
                    title: @tr("Network identity");

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        for network in known-networks : NavButton {
                            icon: "🌐";
                            label: network;
                            selected: settings-network == network;
                            clicked => {
                                settings-network = network;
                                settings-network-selected(network);
                            }
                        }
                    }
                    LineEdit {
                        placeholder-text: @tr("Nickname");
                        accessible-label: @tr("Nickname");
                        text <=> identity-nick;
                    }
                    LineEdit {
                        placeholder-text: @tr("Ident");
                        accessible-label: @tr("Ident");
                        text <=> identity-ident;
                    }
                    LineEdit {
                        placeholder-text: @tr("Real name");
                        accessible-label: @tr("Real name");
                        text <=> identity-realname;
                    }
                    CheckBox {
                        text: @tr("Accept DCC files from open private conversations automatically");
                        checked <=> pref-dcc-auto-accept;
                        enabled: settings-network != "";
                        toggled => { dcc-auto-accept-toggled(self.checked); }
                    }
                    CompactButton {
                        text: "💾  " + @tr("Save");
                        a11y-label: @tr("Save");
                        enabled: settings-network != "";
                        clicked => { identity-save-requested(); }
                    }
                }
            }

            if settings-section == "display" : SectionCard {
                icon: "🖥";
                title: display-prefs-loaded ? @tr("Display preferences") : @tr("Loading…");

                CheckBox {
                    text: @tr("Colored nicklist");
                    checked <=> pref-colored-nicklist;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Bold mentions");
                    checked <=> pref-bold-mentions;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Strip formatting");
                    checked <=> pref-strip-formatting;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Show event badge");
                    checked <=> pref-show-event-badge;
                    toggled => { display-prefs-changed(); }
                }
                CheckBox {
                    text: @tr("Show bottom bar");
                    checked <=> pref-show-bottom-bar;
                    toggled => { display-prefs-changed(); }
                }
            }

            if settings-section == "security" : SectionCard {
                icon: "🔒";
                title: @tr("Security");

                Text {
                    text: @tr("Two-factor authentication, passkeys, client tokens and account deletion are managed in Cicchetto: Grappa keeps them out of reach of a client token like the one Cordiale signs in with.");
                    wrap: word-wrap;
                }
            }

            if settings-section == "push" : SectionCard {
                icon: "🔔";
                title: @tr("Notifications");

                Text {
                    text: @tr("Push notifications Grappa sends to your devices (such as Cicchetto on a phone) while none of them is in use.");
                    wrap: word-wrap;
                }
                if !notify-prefs-loaded : Text {
                    text: @tr("Loading…");
                }
                if notify-prefs-loaded : VerticalLayout {
                    spacing: 6px;

                    CheckBox {
                        text: @tr("Mentions of my nick in channels");
                        checked <=> notify-channel-mentions;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Every channel message");
                        checked <=> notify-channel-all;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Every private message");
                        checked <=> notify-private-all;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Watched nicks coming online");
                        checked <=> notify-presence-online;
                        toggled => { notification-prefs-changed(); }
                    }
                    CheckBox {
                        text: @tr("Watched nicks going offline");
                        checked <=> notify-presence-offline;
                        toggled => { notification-prefs-changed(); }
                    }

                    Text {
                        text: @tr("With every channel message off, also these channels:");
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    for channel in notify-only-channels : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: channel;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Remove {}", channel);
                            clicked => { notification-list-remove("channel", channel); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: "#channel";
                            accessible-label: @tr("Channel");
                            text <=> notify-new-channel;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            enabled: notify-new-channel != "";
                            clicked => {
                                notification-list-add("channel", notify-new-channel);
                                notify-new-channel = "";
                            }
                        }
                    }

                    Text {
                        text: @tr("With every private message off, also these nicks:");
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    for nick in notify-only-privates : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: nick;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Remove {}", nick);
                            clicked => { notification-list-remove("private", nick); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            accessible-label: @tr("Nickname");
                            text <=> notify-new-private;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            enabled: notify-new-private != "";
                            clicked => {
                                notification-list-add("private", notify-new-private);
                                notify-new-private = "";
                            }
                        }
                    }

                    Text {
                        text: "🔕  " + @tr("Muted conversations");
                        font-weight: 600;
                    }
                    if notify-muted.length == 0 : Text {
                        text: @tr("None. Mute one from the Actions menu.");
                        wrap: word-wrap;
                    }
                    for row in notify-muted : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🔔  " + @tr("Unmute");
                            a11y-label: @tr("Unmute {}", row.label);
                            clicked => { notification-unmute(row.key); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: @tr("Sound on other devices (also /beep)");
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        ComboBox {
                            model: ["none", "tone", "chime", "blip", "pop", "icq", "xp_notify", "xp_ding", "xp_balloon", "xp_exclamation"];
                            current-index <=> notify-sound-index;
                            min-width: 140px;
                            selected => { notification-sound-changed(); }
                        }
                    }
                }
            }

            // Color themes: Grappa's gallery (`GET /themes`, applied through
            // `PUT /me/theme`) or built-in copies of it, plus the classic
            // light/dark switch, same toggle as on General.
            if settings-section == "themes" : SectionCard {
                icon: "🎨";
                title: @tr("Theme");
                fill: true;

                Text {
                    text: @tr("Color themes come from Grappa's gallery (irssi-dark, sux and more) and follow your account; without a connection, built-in copies are offered. The classic look follows the light/dark switch.");
                    wrap: word-wrap;
                }
                if theme-pair-active : Text {
                    text: @tr("Pick a night theme too and Cordiale switches to it while your system is in dark mode, like Cicchetto.");
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    CompactButton {
                        text: theme == "light" ? @tr("Classic: switch to dark") : @tr("Classic: switch to light");
                        clicked => { theme-toggle-requested(); }
                    }
                    if palette-active : CompactButton {
                        text: @tr("Back to classic");
                        clicked => { color-theme-requested(""); }
                    }
                    if theme-has-night : CompactButton {
                        text: @tr("Same theme day and night");
                        clicked => { night-theme-requested(""); }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    min-height: 160px;

                    for choice in theme-choices : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;
                        height: 34px;

                        HorizontalLayout {
                            spacing: 0px;

                            for swatch in choice.swatches : Rectangle {
                                width: 14px;
                                height: 22px;
                                background: swatch;
                                border-width: 1px;
                                border-color: #80808080;
                            }
                        }
                        Text {
                            text: choice.author == "" ? choice.name : @tr("{} by {}", choice.name, choice.author);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-weight: choice.selected ? 700 : 400;
                            overflow: elide;
                        }
                        CompactButton {
                            text: choice.selected ? (theme-has-night ? "☀  " + @tr("By day") : @tr("In use")) : @tr("Use");
                            enabled: !choice.selected;
                            a11y-label: @tr("Use theme {}", choice.name);
                            clicked => { color-theme-requested(choice.key); }
                        }
                        if theme-pair-active && !choice.selected : CompactButton {
                            text: choice.night ? "🌙  " + @tr("At night") : "🌙  " + @tr("Use at night");
                            enabled: !choice.night;
                            a11y-label: @tr("Use theme {} at night", choice.name);
                            clicked => { night-theme-requested(choice.key); }
                        }
                    }
                }
            }

            if settings-section == "radio" : SectionCard {
                icon: "📻";
                title: @tr("Radio stations");
                fill: true;

                Text {
                    text: @tr("Add your own MP3, Ogg Vorbis or FLAC stations (a stream or a .pls/.m3u playlist URL). They are kept on this device only, next to Cicchetto's stations on the Radio screen.");
                    wrap: word-wrap;
                }
                for station[index] in radio-custom-stations : HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: station.name + "  (" + station.codec-label + ")\n" + station.url;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "✎";
                        a11y-label: @tr("Edit {}", station.name);
                        clicked => {
                            radio-edit-index = index;
                            radio-form-name = station.name;
                            radio-form-url = station.url;
                            radio-form-codec = station.codec-index;
                        }
                    }
                    CompactButton {
                        text: "🗑";
                        a11y-label: @tr("Delete {}", station.name);
                        clicked => { radio-station-delete(index); }
                    }
                }
                Text {
                    text: radio-edit-index >= 0 ? @tr("Edit station") : @tr("New station");
                    font-weight: 600;
                }
                LineEdit {
                    placeholder-text: @tr("Name");
                    accessible-label: @tr("Name");
                    text <=> radio-form-name;
                }
                LineEdit {
                    placeholder-text: "https://…";
                    accessible-label: @tr("Stream URL");
                    text <=> radio-form-url;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    ComboBox {
                        model: ["MP3", "Ogg Vorbis", "FLAC"];
                        current-index <=> radio-form-codec;
                        min-width: 120px;
                    }
                    CompactButton {
                        text: radio-edit-index >= 0 ? "💾  " + @tr("Save") : "➕  " + @tr("Add");
                        a11y-label: radio-edit-index >= 0 ? @tr("Save") : @tr("Add");
                        enabled: radio-form-name != "" && radio-form-url != "";
                        clicked => { radio-station-save(radio-edit-index, radio-form-name, radio-form-url, radio-form-codec); }
                    }
                    if radio-edit-index >= 0 : CompactButton {
                        text: @tr("Cancel");
                        clicked => {
                            radio-edit-index = -1;
                            radio-form-name = "";
                            radio-form-url = "";
                            radio-form-codec = 0;
                        }
                    }
                }
            }

            if settings-section == "watchlists" : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;

                SectionCard {
                    icon: "👁";
                    title: @tr("Presence (per network)");

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        for network in known-networks : NavButton {
                            icon: "🌐";
                            label: network;
                            selected: settings-network == network;
                            clicked => {
                                settings-network = network;
                                settings-network-selected(network);
                            }
                        }
                    }
                    for row in settings-notify-nicks : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: row.presence == "online"
                                ? @tr("{} (online)", row.nick)
                                : (row.presence == "offline" ? @tr("{} (offline)", row.nick) : row.nick);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { notify-remove-requested(row.nick); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            text <=> new-notify-nick;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            enabled: settings-network != "";
                            clicked => {
                                notify-add-requested(new-notify-nick);
                                new-notify-nick = "";
                            }
                        }
                    }
                }

                SectionCard {
                    icon: "✨";
                    title: @tr("Keyword highlights");

                    for pattern in settings-watch-patterns : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: pattern;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { watch-pattern-remove-requested(pattern); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Pattern");
                            text <=> new-watch-pattern;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add");
                            a11y-label: @tr("Add");
                            clicked => {
                                watch-pattern-add-requested(new-watch-pattern);
                                new-watch-pattern = "";
                            }
                        }
                    }
                }
            }

            if settings-section == "ignores" : SectionCard {
                icon: "🚫";
                title: @tr("Ignore List");

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for network in known-networks : NavButton {
                        icon: "🌐";
                        label: network;
                        selected: settings-network == network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                for mask in settings-ignores : HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: mask;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "🗑  " + @tr("Delete");
                        a11y-label: @tr("Delete");
                        clicked => { ignore-remove-requested(mask); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Mask (nick!user@host)");
                        text <=> new-ignore-mask;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Add");
                        a11y-label: @tr("Add");
                        enabled: settings-network != "";
                        clicked => {
                            ignore-add-requested(new-ignore-mask);
                            new-ignore-mask = "";
                        }
                    }
                }
            }

            if settings-section == "aliases" : SectionCard {
                icon: "↪";
                title: @tr("Aliases");

                for row in settings-aliases : HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: row.command;
                        vertical-alignment: center;
                        font-weight: 600;
                        min-width: 80px;
                        overflow: elide;
                    }
                    Text {
                        text: row.expansion;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    CompactButton {
                        text: "🗑  " + @tr("Delete");
                        a11y-label: @tr("Delete");
                        clicked => { alias-remove-requested(row.command); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Command");
                        text <=> new-alias-command;
                        horizontal-stretch: 1;
                        min-width: 60px;
                    }
                    LineEdit {
                        placeholder-text: @tr("Expansion");
                        text <=> new-alias-expansion;
                        horizontal-stretch: 2;
                        min-width: 80px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Add");
                        a11y-label: @tr("Add");
                        clicked => {
                            alias-add-requested(new-alias-command, new-alias-expansion);
                            new-alias-command = "";
                            new-alias-expansion = "";
                        }
                    }
                }
            }

            if settings-section == "perform" : SectionCard {
                icon: "▶";
                title: @tr("On-Connect Commands");

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for network in known-networks : NavButton {
                        icon: "🌐";
                        label: network;
                        selected: settings-network == network;
                        clicked => {
                            settings-network = network;
                            settings-network-selected(network);
                        }
                    }
                }
                Text {
                    text: @tr("On-connect commands, one IRC command per line");
                    wrap: word-wrap;
                }
                TextEdit {
                    text <=> perform-text;
                    min-height: 120px;
                    wrap: no-wrap;
                    accessible-label: @tr("On-connect commands");
                }
                CompactButton {
                    text: "💾  " + @tr("Save");
                    a11y-label: @tr("Save");
                    enabled: settings-network != "";
                    clicked => { perform-save-requested(perform-text); }
                }
            }

            if settings-section == "vhost" : SectionCard {
                icon: "🌐";
                title: @tr("Source Address");

                for option in settings-vhost-options : CheckBox {
                    text: option.label;
                    checked: option.selected;
                    toggled => { vhost-toggle-requested(option.address); }
                }
            }

            if settings-section == "credits" : SectionCard {
                icon: "ℹ";
                title: @tr("Credits");

                Image {
                    source: @image-url("../../../resources/branding/cordiale_icona_256.png");
                    image-fit: contain;
                    height: 96px;
                }
                Text {
                    text: "Cordiale";
                    font-size: 20px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Sythos";
                    horizontal-alignment: center;
                }
                Text {
                    text: credits-copyright-text;
                    horizontal-alignment: center;
                }
                Text {
                    text: app-version;
                    horizontal-alignment: center;
                }
            }

            if settings-section == "admin" : SectionCard {
                icon: "🛡";
                title: @tr("Admin");
                fill: true;

                Text {
                    text: @tr("Vhosts, credentials, server-wide settings write, and the live admin event stream aren't built yet.");
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    NavButton {
                        icon: "🔌";
                        label: @tr("Sessions");
                        selected: admin-section == "sessions";
                        clicked => { admin-section = "sessions"; }
                    }
                    NavButton {
                        icon: "👤";
                        label: @tr("Users");
                        selected: admin-section == "users";
                        clicked => { admin-section = "users"; }
                    }
                    NavButton {
                        icon: "🌍";
                        label: @tr("Networks");
                        selected: admin-section == "networks";
                        clicked => { admin-section = "networks"; }
                    }
                    NavButton {
                        icon: "🧳";
                        label: @tr("Visitors");
                        selected: admin-section == "visitors";
                        clicked => { admin-section = "visitors"; }
                    }
                    NavButton {
                        icon: "📜";
                        label: @tr("Session Log");
                        selected: admin-section == "session-log";
                        clicked => { admin-section = "session-log"; }
                    }
                    NavButton {
                        icon: "🔑";
                        label: @tr("Credentials");
                        selected: admin-section == "credentials";
                        clicked => { admin-section = "credentials"; }
                    }
                    NavButton {
                        icon: "🖧";
                        label: @tr("Vhosts");
                        selected: admin-section == "vhosts";
                        clicked => { admin-section = "vhosts"; }
                    }
                    NavButton {
                        icon: "📣";
                        label: @tr("Events");
                        selected: admin-section == "events";
                        clicked => { admin-section = "events"; }
                    }
                    NavButton {
                        icon: "🧰";
                        label: @tr("Server");
                        selected: admin-section == "server";
                        clicked => {
                            admin-section = "server";
                            admin-settings-requested();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    CompactButton {
                        text: "⟳  " + @tr("Refresh");
                        a11y-label: @tr("Refresh");
                        clicked => { admin-refresh-requested(); }
                    }
                    CompactButton {
                        text: "🧹  " + @tr("Run reaper sweep");
                        a11y-label: @tr("Run reaper sweep");
                        clicked => { admin-reaper-run(); }
                    }
                }

                Text {
                    text: admin-loading ? @tr("Loading…") : admin-overview-text;
                    wrap: word-wrap;
                }

                if admin-section == "sessions" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-sessions : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: (row.alive ? "🟢  " : "⚪  ") + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "⏏  " + @tr("Disconnect");
                            a11y-label: @tr("Disconnect");
                            enabled: row.alive;
                            clicked => { admin-disconnect-session(row.session-id); }
                        }
                    }
                }

                if admin-section == "users" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("New user name");
                        accessible-label: @tr("New user name");
                        text <=> admin-new-user-name;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    LineEdit {
                        placeholder-text: @tr("Password");
                        accessible-label: @tr("Password");
                        input-type: InputType.password;
                        text <=> admin-new-user-password;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    CheckBox {
                        text: @tr("Admin");
                        checked <=> admin-new-user-is-admin;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Create user");
                        a11y-label: @tr("Create user");
                        enabled: admin-new-user-name != "" && admin-new-user-password != "";
                        clicked => { admin-user-create(); }
                    }
                }
                if admin-section == "users" : Text {
                    text: @tr("To reset a password, type it above and press 🔑 on the account; its sessions are signed out.");
                    wrap: word-wrap;
                }

                if admin-section == "users" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-users : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: (row.is-admin ? "🛡  " : "👤  ") + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: row.is-admin ? @tr("Revoke admin") : @tr("Make admin");
                            clicked => { admin-user-toggle-admin(row.user-id, !row.is-admin); }
                        }
                        CompactButton {
                            text: "🔑";
                            a11y-label: @tr("Set password");
                            enabled: admin-new-user-password != "";
                            clicked => { admin-user-set-password(row.user-id); }
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { admin-user-delete(row.user-id); }
                        }
                    }
                }

                if admin-section == "networks" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("New network slug");
                        accessible-label: @tr("New network slug");
                        text <=> admin-new-network-slug;
                        horizontal-stretch: 1;
                        min-width: 80px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Create network");
                        a11y-label: @tr("Create network");
                        enabled: admin-new-network-slug != "";
                        clicked => { admin-network-create(admin-new-network-slug); }
                    }
                }

                if admin-section == "networks" && admin-edit-network != "" : VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "✏  " + @tr("Settings of {} (empty cap = unlimited)", admin-edit-network);
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Visitor sessions");
                            accessible-label: @tr("Visitor sessions");
                            input-type: number;
                            text <=> admin-edit-visitor-cap;
                            min-width: 60px;
                        }
                        LineEdit {
                            placeholder-text: @tr("User sessions");
                            accessible-label: @tr("User sessions");
                            input-type: number;
                            text <=> admin-edit-user-cap;
                            min-width: 60px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Per IP");
                            accessible-label: @tr("Per IP");
                            input-type: number;
                            text <=> admin-edit-ip-cap;
                            min-width: 60px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CheckBox {
                            text: @tr("Visitors allowed");
                            checked <=> admin-edit-visitor-enabled;
                        }
                        CompactButton {
                            text: "💾  " + @tr("Save");
                            a11y-label: @tr("Save");
                            clicked => { admin-network-save(); }
                        }
                        CompactButton {
                            text: @tr("Cancel");
                            clicked => { admin-edit-network = ""; }
                        }
                    }

                    Text {
                        text: "🖧  " + @tr("IRC servers");
                        font-weight: 600;
                    }
                    for server in admin-servers : HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: server.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Remove server {}", server.label);
                            clicked => { admin-server-delete(server.server-id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            placeholder-text: @tr("Host");
                            accessible-label: @tr("Host");
                            text <=> admin-new-server-host;
                            horizontal-stretch: 1;
                            min-width: 100px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Port");
                            accessible-label: @tr("Port");
                            input-type: number;
                            text <=> admin-new-server-port;
                            min-width: 60px;
                        }
                        CheckBox {
                            text: "TLS";
                            checked <=> admin-new-server-tls;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Add server");
                            a11y-label: @tr("Add server");
                            enabled: admin-new-server-host != "";
                            clicked => { admin-server-add(); }
                        }
                    }
                }

                if admin-section == "networks" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-networks : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🌍  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "✏";
                            a11y-label: @tr("Edit network {}", row.slug);
                            clicked => {
                                admin-edit-network = row.slug;
                                admin-edit-network-id = row.network-id;
                                admin-servers-requested(row.network-id);
                                admin-edit-visitor-enabled = row.visitor-enabled;
                                admin-edit-visitor-cap = row.visitor-cap;
                                admin-edit-user-cap = row.user-cap;
                                admin-edit-ip-cap = row.ip-cap;
                            }
                        }
                        CompactButton {
                            text: "⟲  " + @tr("Reset circuit");
                            a11y-label: @tr("Reset circuit");
                            clicked => { admin-network-reset-circuit(row.network-id); }
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Delete network {}", row.slug);
                            clicked => { admin-network-delete(row.network-id); }
                        }
                    }
                }

                if admin-section == "visitors" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-visitors : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🧳  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑  " + @tr("Delete");
                            a11y-label: @tr("Delete");
                            clicked => { admin-visitor-delete(row.visitor-id); }
                        }
                    }
                }

                if admin-section == "session-log" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for line in admin-session-log : Text {
                        text: line;
                        wrap: word-wrap;
                    }
                }

                if admin-section == "credentials" : VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;

                        ComboBox {
                            model: admin-user-names;
                            current-index <=> admin-cred-user-index;
                            min-width: 110px;
                        }
                        ComboBox {
                            model: admin-network-names;
                            current-index <=> admin-cred-network-index;
                            min-width: 100px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Nickname");
                            accessible-label: @tr("Nickname");
                            text <=> admin-cred-nick;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;

                        ComboBox {
                            model: ["auto", "sasl", "server_pass", "nickserv_identify", "none"];
                            current-index <=> admin-cred-auth-index;
                            min-width: 150px;
                        }
                        LineEdit {
                            placeholder-text: @tr("Password");
                            accessible-label: @tr("Password");
                            input-type: InputType.password;
                            text <=> admin-cred-password;
                            horizontal-stretch: 1;
                            min-width: 80px;
                        }
                        CompactButton {
                            text: "🔗  " + @tr("Bind");
                            a11y-label: @tr("Bind");
                            enabled: admin-cred-nick != "" && admin-user-names.length > 0 && admin-network-names.length > 0;
                            clicked => { admin-credential-bind(); }
                        }
                    }
                }
                if admin-section == "credentials" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for row in admin-credentials : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🔑  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "⛓  " + @tr("Unbind");
                            a11y-label: @tr("Unbind");
                            clicked => { admin-credential-unbind(row.user-id, row.network-id); }
                        }
                    }
                }

                if admin-section == "vhosts" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Address");
                        accessible-label: @tr("Address");
                        text <=> admin-new-vhost-address;
                        horizontal-stretch: 1;
                        min-width: 100px;
                    }
                    CheckBox {
                        text: @tr("In pool");
                        checked <=> admin-new-vhost-in-pool;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Add vhost");
                        a11y-label: @tr("Add vhost");
                        enabled: admin-new-vhost-address != "";
                        clicked => { admin-vhost-add(); }
                    }
                }
                if admin-section == "vhosts" : ListView {
                    vertical-stretch: 1;
                    min-height: 100px;

                    for row in admin-vhosts : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: "🖧  " + row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CheckBox {
                            text: @tr("In pool");
                            checked: row.in-pool;
                            toggled => { admin-vhost-set(row.vhost-id, "in_pool", self.checked); }
                        }
                        CheckBox {
                            text: @tr("For everyone");
                            checked: row.generally-available;
                            toggled => { admin-vhost-set(row.vhost-id, "generally_available", self.checked); }
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Delete vhost {}", row.label);
                            clicked => { admin-vhost-delete(row.vhost-id); }
                        }
                    }
                }
                if admin-section == "vhosts" : HorizontalLayout {
                    spacing: 6px;

                    ComboBox {
                        model: admin-vhost-names;
                        current-index <=> admin-grant-vhost-index;
                        min-width: 140px;
                    }
                    ComboBox {
                        model: admin-user-names;
                        current-index <=> admin-grant-user-index;
                        min-width: 110px;
                    }
                    CompactButton {
                        text: "➕  " + @tr("Grant");
                        a11y-label: @tr("Grant");
                        enabled: admin-vhost-names.length > 0 && admin-user-names.length > 0;
                        clicked => { admin-grant-add(); }
                    }
                }
                if admin-section == "vhosts" : HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        placeholder-text: @tr("Find a visitor or account by nick");
                        accessible-label: @tr("Find a visitor or account by nick");
                        text <=> admin-subject-query;
                        horizontal-stretch: 1;
                        accepted => { admin-subject-search(admin-subject-query); }
                    }
                    CompactButton {
                        text: "🔍  " + @tr("Search");
                        a11y-label: @tr("Search");
                        enabled: admin-subject-query != "";
                        clicked => { admin-subject-search(admin-subject-query); }
                    }
                }
                if admin-section == "vhosts" && admin-subject-searched && admin-subject-results.length == 0 : Text {
                    text: @tr("Nobody matches.");
                }
                if admin-section == "vhosts" : VerticalLayout {
                    spacing: 2px;

                    for subject in admin-subject-results : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: subject.kind == "visitor"
                                ? @tr("{} on {} (visitor)", subject.nick, subject.network)
                                : @tr("{} (account)", subject.nick);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "➕  " + @tr("Grant the vhost above");
                            a11y-label: @tr("Grant the selected vhost to {}", subject.nick);
                            enabled: admin-vhost-names.length > 0;
                            clicked => { admin-subject-grant(subject.kind, subject.subject-id); }
                        }
                    }
                }
                if admin-section == "vhosts" : ListView {
                    vertical-stretch: 1;
                    min-height: 80px;

                    for row in admin-grants : HorizontalLayout {
                        spacing: 8px;
                        padding: 2px;

                        Text {
                            text: row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        CompactButton {
                            text: "🗑";
                            a11y-label: @tr("Revoke grant {}", row.label);
                            clicked => { admin-grant-revoke(row.grant-id); }
                        }
                    }
                }

                if admin-section == "server" && !admin-settings-loaded : Text {
                    text: @tr("Loading…");
                }
                if admin-section == "server" && admin-settings-loaded : VerticalLayout {
                    vertical-stretch: 0;

                    VerticalLayout {
                        spacing: 6px;
                        padding: 2px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Upload host");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            ComboBox {
                                model: ["embedded", "litterbox"];
                                current-index <=> admin-setting-host-index;
                                min-width: 140px;
                            }
                        }
                        for size[index] in admin-setting-sizes : HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: index == 0 ? @tr("Image, per file (MiB)")
                                    : index == 1 ? @tr("Video, per file (MiB)")
                                    : index == 2 ? @tr("Document, per file (MiB)")
                                    : index == 3 ? @tr("Audio, per file (MiB)")
                                    : index == 4 ? @tr("All uploads (MiB)")
                                    : index == 5 ? @tr("Per user (MiB)")
                                    : index == 6 ? @tr("Per visitor (MiB)")
                                    : index == 7 ? @tr("DCC, per transfer (MiB)")
                                    : @tr("DCC, all transfers (MiB)");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            LineEdit {
                                text: size;
                                input-type: decimal;
                                min-width: 90px;
                                horizontal-stretch: 0;
                                edited(value) => { admin-setting-sizes[index] = value; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Longest video (seconds)");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            LineEdit {
                                text <=> admin-setting-video-seconds;
                                input-type: number;
                                min-width: 90px;
                                horizontal-stretch: 0;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Source address mode");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            ComboBox {
                                model: [@tr("Pool with reservations"), @tr("Static mapping with reservations")];
                                current-index <=> admin-setting-mode-index;
                                min-width: 200px;
                            }
                        }
                        if admin-setting-mode-index == 1 : HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Static mapping prefix length");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            LineEdit {
                                text <=> admin-setting-prefix;
                                min-width: 90px;
                                horizontal-stretch: 0;
                            }
                        }
                        CompactButton {
                            text: "💾  " + @tr("Save");
                            a11y-label: @tr("Save");
                            clicked => { admin-settings-save(); }
                        }
                    }
                }

                if admin-section == "events" && admin-events.length == 0 : Text {
                    text: @tr("No admin events yet. They arrive live while this panel is open.");
                    wrap: word-wrap;
                }
                if admin-section == "events" : ListView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    for line in admin-events : Text {
                        text: line;
                        wrap: word-wrap;
                    }
                }
            }

            // Keeps short panels at the top; list panels fill instead.
            if settings-section != "themes" && settings-section != "admin" : Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    if screen == "reply" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;

            if reply-avatar-visible : Image {
                source: reply-avatar;
                width: 64px;
                height: 64px;
                image-fit: contain;
                accessible-label: @tr("Avatar of {}", reply-subject);
            }
            Text {
                text: reply-title-text();
                font-size: 18px;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.text;
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in reply-rows : Text {
                text: row.label == ""
                    ? row.value
                    : (row.value == "" ? reply-label(row.label) : @tr("{}: {}", reply-label(row.label), row.value));
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }

        Button {
            text: @tr("Back");
            clicked => { screen = "connected"; }
        }
    }

    if screen == "umodes" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("User modes on {}", umode-network);
            font-size: 18px;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        ListView {
            vertical-stretch: 1;

            for row in umode-toggles : HorizontalLayout {
                spacing: 8px;
                padding-bottom: 6px;

                CheckBox {
                    text: "+" + row.letter;
                    checked: row.active;
                    enabled: row.settable;
                    accessible-label: @tr("{} (+{})", umode-label(row.letter), row.letter);
                    toggled => {
                        // The box follows Grappa's push, not the click.
                        self.checked = row.active;
                        umode-toggle-requested(row.letter);
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: row.settable ? umode-label(row.letter) : @tr("{} (set by the server)", umode-label(row.letter));
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: umode-description(row.letter);
                        wrap: word-wrap;
                    }
                }
            }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                umode-view-closed();
            }
        }
    }

    if screen == "radio" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "📻  " + @tr("Radio");
            font-size: 18px;
            accessible-role: AccessibleRole.text;
        }

        ListView {
            vertical-stretch: 1;

            for station in radio-stations : HorizontalLayout {
                spacing: 8px;
                padding-bottom: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: station.title;
                        font-weight: station.key == radio-tuned-key ? 700 : 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: station.detail;
                        wrap: word-wrap;
                        opacity: 0.75;
                    }
                    Text {
                        text: station.description;
                        wrap: word-wrap;
                    }
                }
                CompactButton {
                    text: station.key == radio-tuned-key ? "⏹  " + @tr("Stop") : "▶  " + @tr("Play");
                    a11y-label: station.key == radio-tuned-key ? @tr("Stop {}", station.title) : @tr("Play {}", station.title);
                    clicked => {
                        if station.key == radio-tuned-key {
                            radio-stop();
                        } else {
                            radio-tune(station.key);
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Button {
                text: @tr("Back");
                clicked => { screen = "connected"; }
            }
            Button {
                text: "⚙  " + @tr("Custom stations");
                clicked => {
                    screen = "settings";
                    settings-section = "radio";
                }
            }
        }
    }

    if screen == "archive" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("Archive on {}", archive-network);
            font-size: 18px;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        Text {
            text: !archive-loaded
                ? @tr("Loading…")
                : (archive-rows.length == 0
                    ? @tr("No archived windows.")
                    : @tr("Windows you left that still have history on the bouncer."));
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if archive-error != "" : Text {
            text: archive-error-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if archive-confirm-target != "" : HorizontalBox {
            padding: 0px;
            spacing: 4px;

            Text {
                text: @tr("Delete all history of {} on {}? Only the bouncer's copy is removed.", archive-confirm-target, archive-network);
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.text;
            }

            Button {
                text: @tr("Delete");
                clicked => {
                    archive-delete-requested(archive-confirm-target);
                    archive-confirm-target = "";
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => { archive-confirm-target = ""; }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in archive-rows : HorizontalBox {
                padding: 0px;
                spacing: 4px;

                Text {
                    text: row.kind == "query"
                        ? @tr("{} (private, last active {})", row.target, row.last-activity)
                        : @tr("{} (last active {})", row.target, row.last-activity);
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    accessible-role: AccessibleRole.text;
                }

                Button {
                    text: @tr("Delete history");
                    accessible-label: @tr("Delete history of {}", row.target);
                    clicked => { archive-confirm-target = row.target; }
                }
            }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                archive-closed();
            }
        }
    }

    if screen == "directory" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: @tr("Channels on {}", directory-network);
            font-size: 18px;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        Text {
            text: directory-status-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if directory-failed-reason != "" : Text {
            text: @tr("The last channel listing failed ({}); showing the previous list.", directory-failed-reason);
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        if directory-error != "" : Text {
            text: directory-error-text();
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        HorizontalBox {
            padding: 0px;

            LineEdit {
                placeholder-text: @tr("Search channels");
                accessible-label: @tr("Search channels");
                text <=> directory-query;
                accepted => { directory-search-requested(directory-query); }
            }

            Button {
                text: directory-sort == "name" ? @tr("Sort by users") : @tr("Sort by name");
                clicked => { directory-sort-requested(directory-sort == "name" ? "users" : "name"); }
            }

            Button {
                text: directory-refresh-pending ? @tr("Refreshing…") : @tr("Refresh");
                enabled: !directory-refresh-pending;
                clicked => { directory-refresh-requested(); }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in directory-rows : Text {
                text: row.topic == ""
                    ? @tr("{} ({} users)", row.name, row.users)
                    : @tr("{} ({} users) — {}", row.name, row.users, row.topic);
                font-weight: row.featured ? 700 : 400;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }
        }

        if directory-has-more : Button {
            text: @tr("Load more");
            clicked => { directory-load-more-requested(); }
        }

        Button {
            text: @tr("Back");
            clicked => {
                screen = "connected";
                directory-closed();
            }
        }
    }

    if screen == "links" : VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: links-network-label;
            font-size: 18px;
        }

        for row in links-rows : Text {
            text: row.display;
            wrap: word-wrap;
        }

        Button {
            text: @tr("Show graph");
            clicked => { links-graph-requested(); }
        }

        Button {
            text: @tr("Back");
            clicked => { screen = "connected"; }
        }
    }
}

export component LinksGraphWindow inherits Window {
    title: @tr("Cordiale — Network Links");
    width: 800px;
    height: 640px;

    in property <string> network-label: "";
    in property <string> edges-commands: "";
    in property <[LinksGraphNode]> nodes: [];
    // Side of the square canvas the node coordinates and edges live in.
    in property <int> canvas-size: 760;
    in-out property <float> zoom: 1.0;

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: network-label;
                font-size: 18px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            CompactButton {
                text: "−";
                a11y-label: @tr("Zoom out");
                enabled: zoom > 0.3;
                clicked => { zoom = max(0.25, zoom / 1.25); }
            }
            Text {
                text: round(zoom * 100) + "%";
                vertical-alignment: center;
                min-width: 44px;
                horizontal-alignment: center;
            }
            CompactButton {
                text: "+";
                a11y-label: @tr("Zoom in");
                enabled: zoom < 4;
                clicked => { zoom = min(4, zoom * 1.25); }
            }
            CompactButton {
                text: @tr("Reset");
                a11y-label: @tr("Reset zoom");
                clicked => { zoom = 1; }
            }
        }

        // Drag or scroll to pan; the buttons above zoom.
        Flickable {
            vertical-stretch: 1;
            min-height: 300px;
            viewport-width: canvas-size * 1px * zoom;
            viewport-height: canvas-size * 1px * zoom;

            Rectangle {
                width: canvas-size * 1px * zoom;
                height: canvas-size * 1px * zoom;
                background: #1e1e1e;

                // The viewbox pins the edges to the same coordinate space
                // as the nodes, instead of fitting their bounding box.
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: canvas-size;
                    viewbox-height: canvas-size;
                    commands: edges-commands;
                    stroke: #888888;
                    stroke-width: 1.5px;
                }

                for node in nodes : Rectangle {
                    x: node.x * 1px * zoom - 5px;
                    y: node.y * 1px * zoom - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: #4a9eff;
                }

                for node in nodes : Text {
                    x: node.x * 1px * zoom + 8px;
                    y: node.y * 1px * zoom - 7px;
                    text: node.server;
                    color: white;
                    font-size: 12px;
                }
            }
        }
    }
}
