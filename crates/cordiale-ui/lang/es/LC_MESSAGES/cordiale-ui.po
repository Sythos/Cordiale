msgstr "Predeterminado del servidor"

msgctxt "AppWindow"
msgid "1 hour"
msgstr "1 hora"

msgctxt "AppWindow"
msgid "12 hours"
msgstr "12 horas"

msgctxt "AppWindow"
msgid "1 day"
msgstr "1 día"

msgctxt "AppWindow"
msgid "3 days"
msgstr "3 días"

msgctxt "AppWindow"
msgid "Ask before uploading"
msgstr "Preguntar antes de subir"

msgctxt "AppWindow"
msgid "Load older messages"
msgstr "Cargar mensajes anteriores"

msgctxt "AppWindow"
msgid "Keep at least one message notification on."
msgstr "Deja activada al menos una notificación de mensajes."

msgctxt "AppWindow"
msgid "Couldn't save the notification settings."
msgstr "No se pudieron guardar los ajustes de notificaciones."

msgctxt "AppWindow"
msgid "Two-factor authentication, passkeys, client tokens and account deletion are managed in Cicchetto: Grappa keeps them out of reach of a client token like the one Cordiale signs in with."
msgstr "La verificación en dos pasos, las passkeys, los tokens de cliente y la eliminación de la cuenta se gestionan en Cicchetto: Grappa los mantiene fuera del alcance de un token de cliente como el que usa Cordiale."

msgctxt "AppWindow"
msgid "Push notifications Grappa sends to your devices (such as Cicchetto on a phone) while none of them is in use."
msgstr "Notificaciones push que Grappa envía a tus dispositivos (como Cicchetto en un teléfono) cuando ninguno está en uso."

msgctxt "AppWindow"
msgid "Mentions of my nick in channels"
msgstr "Menciones de mi nick en los canales"

msgctxt "AppWindow"
msgid "Every channel message"
msgstr "Cada mensaje de los canales"

msgctxt "AppWindow"
msgid "Every private message"
msgstr "Cada mensaje privado"

msgctxt "AppWindow"
msgid "Watched nicks coming online"
msgstr "Nicks vigilados que se conectan"

msgctxt "AppWindow"
msgid "Watched nicks going offline"
msgstr "Nicks vigilados que se desconectan"

msgctxt "AppWindow"
msgid "The auto-away delay must be a whole number of seconds."
msgstr "El retraso de ausencia automática debe ser un número entero de segundos."

msgctxt "AppWindow"
msgid "Settings saved."
msgstr "Ajustes guardados."

msgctxt "AppWindow"
msgid "Couldn't save those settings."
msgstr "No se pudieron guardar esos ajustes."

msgctxt "AppWindow"
msgid "Away and leave messages"
msgstr "Mensajes de ausencia y de salida"

msgctxt "AppWindow"
msgid "Leave a field empty to use the server's default."
msgstr "Deja un campo vacío para usar el valor predeterminado del servidor."

msgctxt "AppWindow"
msgid "Quit/part message"
msgstr "Mensaje de quit/part"

msgctxt "AppWindow"
msgid "Auto-away message"
msgstr "Mensaje de ausencia automática"

msgctxt "AppWindow"
msgid "Auto-away after (seconds, 0 = off)"
msgstr "Ausencia automática tras (segundos, 0 = desactivada)"

msgctxt "AppWindow"
msgid "Look up other users' profiles (CTCP USERINFO)"
msgstr "Consultar los perfiles de otros usuarios (CTCP USERINFO)"

msgctxt "AppWindow"
msgid "Accept DCC files from open private conversations automatically"
msgstr "Aceptar automáticamente archivos DCC de las conversaciones privadas abiertas"

msgctxt "AppWindow"
msgid "You were kicked from this channel."
msgstr "Te han expulsado de este canal."

msgctxt "AppWindow"
msgid "You were kicked from this channel: {}"
msgstr "Te han expulsado de este canal: {}"

msgctxt "AppWindow"
msgid "{} kicked you from this channel."
msgstr "{} te ha expulsado de este canal."

msgctxt "AppWindow"
msgid "{} kicked you from this channel: {}"
msgstr "{} te ha expulsado de este canal: {}"

msgctxt "AppWindow"
msgid "Joining this channel failed."
msgstr "No se pudo entrar en este canal."

msgctxt "AppWindow"
msgid "Joining this channel failed: {}"
msgstr "No se pudo entrar en este canal: {}"

msgctxt "AppWindow"
msgid "That alias expands into too many others: {}"
msgstr "Este alias se expande en demasiados otros: {}"

msgctxt "AppWindow"
msgid "The server refused that command ({})."
msgstr "El servidor rechazó ese comando ({})."
