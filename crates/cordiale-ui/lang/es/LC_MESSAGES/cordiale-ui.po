msgctxt "AppWindow"
msgid "Details about this device and this copy of Cordiale. They are shown only here and never sent anywhere."
msgstr "Detalles sobre este dispositivo y esta copia de Cordiale. Solo se muestran aquí y nunca se envían a ninguna parte."

msgctxt "AppWindow"
msgid "Open data folder"
msgstr "Abrir carpeta de datos"

msgctxt "AppWindow"
msgid "Please include these details when you open an issue:"
msgstr "Incluye estos detalles cuando informes de un problema:"

msgctxt "AppWindow"
msgid "That isn't a share token or link Grappa accepts. Copy it again from the other device."
msgstr "Eso no es un token ni un enlace para compartir que Grappa acepte. Vuelve a copiarlo desde el otro dispositivo."

msgctxt "AppWindow"
msgid "This share link has expired. Create a new one on the other device."
msgstr "Este enlace para compartir ha caducado. Crea uno nuevo en el otro dispositivo."

msgctxt "AppWindow"
msgid "This share link has already been used. Create a new one on the other device."
msgstr "Este enlace para compartir ya se ha usado. Crea uno nuevo en el otro dispositivo."

msgctxt "AppWindow"
msgid "The account this link was made for no longer exists."
msgstr "La cuenta para la que se creó este enlace ya no existe."

msgctxt "AppWindow"
msgid "Couldn't sign in with that share token. Try again."
msgstr "No se pudo iniciar sesión con ese token para compartir. Inténtalo de nuevo."

msgctxt "AppWindow"
msgid "Sign in with a share token"
msgstr "Iniciar sesión con un token para compartir"

msgctxt "AppWindow"
msgid "Paste the share link or token made on another device, in Settings > Security here or \"open on another device\" in Cicchetto. It works once and expires after ten minutes."
msgstr "Pega el enlace o el token para compartir creado en otro dispositivo, en Ajustes > Seguridad aquí o con «abrir en otro dispositivo» en Cicchetto. Funciona una sola vez y caduca a los diez minutos."

msgctxt "AppWindow"
msgid "Share link or token"
msgstr "Enlace o token para compartir"

msgctxt "AppWindow"
msgid "Sign in"
msgstr "Iniciar sesión"

msgctxt "AppWindow"
msgid "Sign in with a share token…"
msgstr "Iniciar sesión con un token para compartir…"

msgctxt "AppWindow"
msgid "Share this session"
msgstr "Compartir esta sesión"

msgctxt "AppWindow"
msgid "Make a single-use link or QR code that signs another device, such as Cicchetto on a phone, into this same account. It expires after ten minutes."
msgstr "Crea un enlace o un código QR de un solo uso que inicia sesión en esta misma cuenta desde otro dispositivo, como Cicchetto en un teléfono. Caduca a los diez minutos."

msgctxt "AppWindow"
msgid "Creating…"
msgstr "Creando…"

msgctxt "AppWindow"
msgid "Create a share link"
msgstr "Crear un enlace para compartir"

msgctxt "AppWindow"
msgid "Open this link, or scan the code, on the other device. Anyone who has it can sign in as you until it is used or expires, so don't post it."
msgstr "Abre este enlace, o escanea el código, en el otro dispositivo. Quien lo tenga puede iniciar sesión como tú hasta que se use o caduque, así que no lo publiques."

msgctxt "AppWindow"
msgid "QR code of the share link"
msgstr "Código QR del enlace para compartir"

msgctxt "AppWindow"
msgid "Share link"
msgstr "Enlace para compartir"

msgctxt "AppWindow"
msgid "It works once, within ten minutes."
msgstr "Funciona una sola vez, en un plazo de diez minutos."

msgctxt "AppWindow"
msgid "It works once, until {}."
msgstr "Funciona una sola vez, hasta las {}."

msgctxt "AppWindow"
msgid "Hide link"
msgstr "Ocultar enlace"

msgctxt "AppWindow"
msgid "A per-client token can't share the session. Sign in with your password to do that here."
msgstr "Un token por cliente no puede compartir la sesión. Inicia sesión con tu contraseña para hacerlo aquí."

msgctxt "AppWindow"
msgid "An incognito guest session can't be shared."
msgstr "Una sesión de invitado de incógnito no se puede compartir."

msgctxt "AppWindow"
msgid "Couldn't create a share link."
msgstr "No se pudo crear un enlace para compartir."

msgctxt "AppWindow"
msgid "Profile saved."
msgstr "Perfil guardado."

msgctxt "AppWindow"
msgid "Profile fields must be one line and at most 100 bytes each."
msgstr "Los campos del perfil deben ocupar una línea y tener como máximo 100 bytes cada uno."

msgctxt "AppWindow"
msgid "Couldn't save the profile."
msgstr "No se pudo guardar el perfil."

msgctxt "AppWindow"
msgid "Avatar updated."
msgstr "Avatar actualizado."

msgctxt "AppWindow"
msgid "Avatar removed."
msgstr "Avatar eliminado."

msgctxt "AppWindow"
msgid "Couldn't remove the avatar."
msgstr "No se pudo quitar el avatar."

msgctxt "AppWindow"
msgid "Network profile"
msgstr "Perfil de la red"

msgctxt "AppWindow"
msgid "What other people see when they look you up. Each field holds at most 100 bytes; leave one empty to clear it."
msgstr "Lo que ven los demás cuando te consultan. Cada campo admite como máximo 100 bytes; déjalo vacío para borrarlo."

msgctxt "AppWindow"
msgid "Age"
msgstr "Edad"

msgctxt "AppWindow"
msgid "Gender: not set"
msgstr "Género: sin indicar"

msgctxt "AppWindow"
msgid "Male"
msgstr "Masculino"

msgctxt "AppWindow"
msgid "Female"
msgstr "Femenino"

msgctxt "AppWindow"
msgid "Non-binary"
msgstr "No binario"

msgctxt "AppWindow"
msgid "Gender"
msgstr "Género"

msgctxt "AppWindow"
msgid "Location"
msgstr "Ubicación"

msgctxt "AppWindow"
msgid "Languages"
msgstr "Idiomas"

msgctxt "AppWindow"
msgid "Custom"
msgstr "Personalizado"

msgctxt "AppWindow"
msgid "Save profile"
msgstr "Guardar perfil"

msgctxt "AppWindow"
msgid "You have an avatar on this network."
msgstr "Tienes un avatar en esta red."

msgctxt "AppWindow"
msgid "You have no avatar on this network."
msgstr "No tienes un avatar en esta red."

msgctxt "AppWindow"
msgid "Choose avatar…"
msgstr "Elegir avatar…"

msgctxt "AppWindow"
msgid "Choose avatar"
msgstr "Elegir avatar"

msgctxt "AppWindow"
msgid "Remove avatar"
msgstr "Quitar avatar"

msgctxt "AppWindow"
msgid "This account's second factor is a passkey, which Cordiale can't use yet. Enter one of your recovery codes instead: each works only once. The request expires after five minutes."
msgstr "El segundo factor de esta cuenta es una passkey, que Cordiale todavía no puede usar. Introduce en su lugar uno de tus códigos de recuperación: cada uno sirve una sola vez. La solicitud caduca a los cinco minutos."

msgctxt "AppWindow"
msgid "Passkeys"
msgstr "Passkeys"

msgctxt "AppWindow"
msgid "Cordiale is signed in with a per-client token, which Grappa keeps away from passkeys. Sign in with your password to see them here, or use Cicchetto."
msgstr "Cordiale ha iniciado sesión con un token por cliente, que Grappa mantiene alejado de las passkeys. Inicia sesión con tu contraseña para verlas aquí, o usa Cicchetto."

msgctxt "AppWindow"
msgid "Couldn't read the passkeys."
msgstr "No se pudieron leer las passkeys."

msgctxt "AppWindow"
msgid "Passwordless: this account signs in with a passkey alone, or with a recovery code."
msgstr "Sin contraseña: esta cuenta inicia sesión solo con una passkey, o con un código de recuperación."

msgctxt "AppWindow"
msgid "Second factor: signing in with the password also asks for a passkey."
msgstr "Segundo factor: iniciar sesión con la contraseña también pide una passkey."

msgctxt "AppWindow"
msgid "Not used for signing in."
msgstr "No se usan para iniciar sesión."

msgctxt "AppWindow"
msgid "No passkeys registered."
msgstr "No hay passkeys registradas."

msgctxt "AppWindow"
msgid "{}: added {}, never used"
msgstr "{}: añadida el {}, nunca usada"

msgctxt "AppWindow"
msgid "{}: added {}, last used {}"
msgstr "{}: añadida el {}, último uso {}"

msgctxt "AppWindow"
msgid "Deleting a passkey asks for the account password."
msgstr "Eliminar una passkey pide la contraseña de la cuenta."

msgctxt "AppWindow"
msgid "That's the last passkey and the account still signs in with it. Turn passkeys off or add another one in Cicchetto first."
msgstr "Es la última passkey y la cuenta todavía inicia sesión con ella. Desactiva primero las passkeys o añade otra en Cicchetto."

msgctxt "AppWindow"
msgid "Grappa is busy right now. Try again in a moment."
msgstr "Grappa está ocupado ahora mismo. Inténtalo de nuevo en un momento."

msgctxt "AppWindow"
msgid "Couldn't delete the passkey."
msgstr "No se pudo eliminar la passkey."

msgctxt "AppWindow"
msgid "Adding a passkey and changing how the account uses them still happen in Cicchetto: Cordiale can't talk to an authenticator yet. Client tokens and account deletion are managed there too."
msgstr "Añadir una passkey y cambiar cómo las usa la cuenta se sigue haciendo en Cicchetto: Cordiale todavía no puede hablar con un autenticador. Los tokens de cliente y la eliminación de la cuenta también se gestionan allí."

msgctxt "AppWindow"
msgid "That recovery code didn't work. It may be wrong or already used: each code works only once."
msgstr "Ese código de recuperación no ha funcionado. Puede ser incorrecto o ya usado: cada código vale una sola vez."

msgctxt "AppWindow"
msgid "Couldn't sign in with that recovery code. Try again."
msgstr "No se ha podido iniciar sesión con ese código de recuperación. Inténtalo de nuevo."

msgctxt "AppWindow"
msgid "Sign in with a recovery code"
msgstr "Iniciar sesión con un código de recuperación"

msgctxt "AppWindow"
msgid "For an account that signs in with a passkey and has no password. Enter your username and one of the recovery codes Grappa showed you when you turned passwordless sign-in on. Each code works only once."
msgstr "Para una cuenta que inicia sesión con una passkey y no tiene contraseña. Introduce tu nombre de usuario y uno de los códigos de recuperación que Grappa te mostró al activar el inicio de sesión sin contraseña. Cada código vale una sola vez."

msgctxt "AppWindow"
msgid "Recovery code"
msgstr "Código de recuperación"

msgctxt "AppWindow"
msgid "Passwordless account? Sign in with a recovery code…"
msgstr "¿Cuenta sin contraseña? Iniciar sesión con un código de recuperación…"

msgctxt "AppWindow"
msgid "Two-factor authentication belongs to Grappa accounts. A guest or visitor session doesn't have one."
msgstr "La autenticación de dos factores es propia de las cuentas de Grappa. Una sesión de invitado o visitante no la tiene."

msgctxt "AppWindow"
msgid "Passkeys belong to Grappa accounts. A guest or visitor session doesn't have any."
msgstr "Las passkeys son propias de las cuentas de Grappa. Una sesión de invitado o visitante no tiene ninguna."

msgctxt "AppWindow"
msgid "The server refused the passkey. The authenticator may be the wrong one, or the server expects another origin than {}. If it does, enter it under Passkey origin."
msgstr "El servidor rechazó la passkey. Puede que el autenticador no sea el correcto, o que el servidor espere otro origen distinto de {}. Si es así, introdúcelo en Origen de las passkeys."

msgctxt "AppWindow"
msgid "Passkey origin (optional)"
msgstr "Origen de la passkey (opcional)"

msgctxt "AppWindow"
msgid "That isn't an origin. Use the form https://host or https://host:port, without a path."
msgstr "Eso no es un origen. Usa la forma https://host o https://host:puerto, sin ruta."

msgctxt "AppWindow"
msgid "Passkey origin"
msgstr "Origen de las passkeys"

msgctxt "AppWindow"
msgid "A passkey only answers for one exact origin. For this server Cordiale uses {}. If the server is set up with another one (GRAPPA_PASSKEY_ORIGIN), enter it here; leave the field empty otherwise. It stays on this device."
msgstr "Una passkey solo responde para un origen exacto. Para este servidor Cordiale usa {}. Si el servidor está configurado con otro (GRAPPA_PASSKEY_ORIGIN), introdúcelo aquí; si no, deja el campo vacío. Se queda en este dispositivo."

msgctxt "AppWindow"
msgid "Saved."
msgstr "Guardado."

msgctxt "AppWindow"
msgid "The passkey request was cancelled, timed out, or found no passkey for this account."
msgstr "La solicitud de passkey se canceló, caducó o no encontró ninguna passkey para esta cuenta."

msgctxt "AppWindow"
msgid "That account doesn't sign in with a passkey alone. Use its password instead."
msgstr "Esa cuenta no inicia sesión solo con una passkey. Usa su contraseña."

msgctxt "AppWindow"
msgid "The passkey request failed."
msgstr "La solicitud de passkey ha fallado."

msgctxt "AppWindow"
msgid "This account's second factor is a passkey. Use it to finish signing in. The request expires after five minutes."
msgstr "El segundo factor de esta cuenta es una passkey. Úsala para terminar de iniciar sesión. La solicitud caduca a los cinco minutos."

msgctxt "AppWindow"
msgid "This account's second factor is a passkey. If you can't use it, enter one of your recovery codes instead: each works only once. The request expires after five minutes."
msgstr "El segundo factor de esta cuenta es una passkey. Si no puedes usarla, introduce uno de tus códigos de recuperación: cada uno funciona una sola vez. La solicitud caduca a los cinco minutos."

msgctxt "AppWindow"
msgid "Waiting for the passkey…"
msgstr "Esperando la passkey…"

msgctxt "AppWindow"
msgid "Use a passkey"
msgstr "Usar una passkey"

msgctxt "AppWindow"
msgid "Sign in with a passkey"
msgstr "Iniciar sesión con una passkey"

msgctxt "AppWindow"
msgid "Every change here asks for the account password; adding a passkey or changing the mode then asks for a passkey too."
msgstr "Cada cambio aquí pide la contraseña de la cuenta; añadir una passkey o cambiar el modo pide además una passkey."

msgctxt "AppWindow"
msgid "Passkey name"
msgstr "Nombre de la passkey"

msgctxt "AppWindow"
msgid "Add a passkey"
msgstr "Añadir una passkey"

msgctxt "AppWindow"
msgid "Ask for a passkey after the password"
msgstr "Pedir una passkey después de la contraseña"

msgctxt "AppWindow"
msgid "Sign in with a passkey alone…"
msgstr "Iniciar sesión solo con una passkey…"

msgctxt "AppWindow"
msgid "Turn off passkey sign-in"
msgstr "Desactivar el inicio de sesión con passkey"

msgctxt "AppWindow"
msgid "Signing in with a passkey alone turns off the password and TOTP sign-in. Recovery codes come first, for when the passkey is lost."
msgstr "Iniciar sesión solo con una passkey desactiva el inicio de sesión con contraseña y TOTP. Primero recibes códigos de recuperación, por si pierdes la passkey."

msgctxt "AppWindow"
msgid "Save these recovery codes now: they won't be shown again. Once passwordless is on, each one signs you in once without the passkey."
msgstr "Guarda ahora estos códigos de recuperación: no se volverán a mostrar. Cuando el modo sin contraseña esté activo, cada uno te permite iniciar sesión una vez sin la passkey."

msgctxt "AppWindow"
msgid "I've saved them, turn on passwordless"
msgstr "Ya los guardé, activar el modo sin contraseña"

msgctxt "AppWindow"
msgid "That's the last passkey and the account still signs in with it. Turn passkey sign-in off or add another passkey first."
msgstr "Es la última passkey y la cuenta todavía inicia sesión con ella. Primero desactiva el inicio de sesión con passkey o añade otra passkey."

msgctxt "AppWindow"
msgid "The recovery codes expired before passwordless was turned on. Start again."
msgstr "Los códigos de recuperación caducaron antes de activar el modo sin contraseña. Empieza de nuevo."

msgctxt "AppWindow"
msgid "Couldn't add the passkey."
msgstr "No se pudo añadir la passkey."

msgctxt "AppWindow"
msgid "Couldn't change how the account uses passkeys."
msgstr "No se pudo cambiar cómo usa la cuenta las passkeys."

msgctxt "AppWindow"
msgid "Client tokens and account deletion are managed in Cicchetto."
msgstr "Los tokens de cliente y la eliminación de la cuenta se gestionan en Cicchetto."

msgctxt "AppWindow"
msgid "No security key found. Plug it in and try again."
msgstr "No se encontró ninguna llave de seguridad. Conéctala e inténtalo de nuevo."

msgctxt "AppWindow"
msgid "More than one security key is plugged in. Leave just one and try again."
msgstr "Hay más de una llave de seguridad conectada. Deja solo una e inténtalo de nuevo."

msgctxt "AppWindow"
msgid "Wrong PIN."
msgstr "PIN incorrecto."

msgctxt "AppWindow"
msgid "Wrong PIN. Attempts left before the key locks: {}."
msgstr "PIN incorrecto. Intentos restantes antes de que la llave se bloquee: {}."

msgctxt "AppWindow"
msgid "Too many wrong PINs in a row. Unplug the key, plug it back in and try again."
msgstr "Demasiados PIN incorrectos seguidos. Desconecta la llave, vuelve a conectarla e inténtalo de nuevo."

msgctxt "AppWindow"
msgid "The key's PIN is blocked. Only resetting the key, which erases its passkeys, unblocks it."
msgstr "El PIN de la llave está bloqueado. Solo restablecer la llave, lo que borra sus passkeys, lo desbloquea."

msgctxt "AppWindow"
msgid "A security key PIN has 4 to 63 characters."
msgstr "El PIN de una llave de seguridad tiene de 4 a 63 caracteres."

msgctxt "AppWindow"
msgid "This key has no PIN, and Grappa requires one. Set a PIN on the key first, for example in a browser's security key settings."
msgstr "Esta llave no tiene PIN, y Grappa exige uno. Configura primero un PIN en la llave, por ejemplo en los ajustes de llaves de seguridad de un navegador."

msgctxt "AppWindow"
msgid "This key can't confirm it's you with a PIN or a fingerprint, which Grappa requires."
msgstr "Esta llave no puede confirmar que eres tú con un PIN o una huella, como exige Grappa."

msgctxt "AppWindow"
msgid "This security key doesn't hold a passkey for this account."
msgstr "Esta llave de seguridad no contiene una passkey para esta cuenta."

msgctxt "AppWindow"
msgid "The key wasn't touched in time, or the request was refused on the key."
msgstr "La llave no se tocó a tiempo, o la solicitud se rechazó en la llave."

msgctxt "AppWindow"
msgid "The security key has no room left for another passkey."
msgstr "La llave de seguridad no tiene espacio para otra passkey."

msgctxt "AppWindow"
msgid "Grappa asked for a kind of passkey this security key can't create."
msgstr "Grappa pidió un tipo de passkey que esta llave de seguridad no puede crear."

msgctxt "AppWindow"
msgid "The security key didn't answer as expected. Try again."
msgstr "La llave de seguridad no respondió como se esperaba. Inténtalo de nuevo."

msgctxt "AppWindow"
msgid "Security key"
msgstr "Llave de seguridad"

msgctxt "AppWindow"
msgid "Touch your security key when it blinks."
msgstr "Toca tu llave de seguridad cuando parpadee."

msgctxt "AppWindow"
msgid "Enter the PIN of your security key."
msgstr "Introduce el PIN de tu llave de seguridad."

msgctxt "AppWindow"
msgid "Security key PIN"
msgstr "PIN de la llave de seguridad"

msgctxt "AppWindow"
msgid "Try again"
msgstr "Reintentar"

msgctxt "AppWindow"
msgid "Continue"
msgstr "Continuar"

msgctxt "AppWindow"
msgid "Denoise"
msgstr "Ocultar el ruido"

msgctxt "AppWindow"
msgid "This computer doesn't trust the server's certificate ({}). Add the server's certificate authority to the system trust store, then sign in again."
msgstr "Este equipo no confía en el certificado del servidor ({}). Añade la autoridad de certificación del servidor al almacén de confianza del sistema y vuelve a iniciar sesión."

msgctxt "AppWindow"
msgid "{} h {} min"
msgstr "{} h {} min"

msgctxt "AppWindow"
msgid "{} h"
msgstr "{} h"

msgctxt "AppWindow"
msgid "{} min"
msgstr "{} min"

msgctxt "AppWindow"
msgid "Channel muted"
msgstr "Canal silenciado"

msgctxt "AppWindow"
msgid "Channel muted at {}"
msgstr "Canal silenciado a las {}"

msgctxt "AppWindow"
msgid "Channel muted - expires in {}"
msgstr "Canal silenciado - caduca en {}"

msgctxt "AppWindow"
msgid "Channel muted at {} - expires in {}"
msgstr "Canal silenciado a las {} - caduca en {}"

msgctxt "AppWindow"
msgid "Unmute now"
msgstr "Reactivar ahora"

msgctxt "CleartextNotice"
msgid "This server address uses plain http://, so your password and session token cross the network unencrypted and anyone on the way can read them. Use https:// unless you trust the whole network between you and the server."
msgstr "Esta dirección del servidor usa http:// sin cifrar, así que tu contraseña y el token de sesión cruzan la red sin cifrado y cualquiera en el camino puede leerlos. Usa https:// a menos que confíes en toda la red entre tú y el servidor."

msgctxt "CleartextNotice"
msgid "This passkey origin uses plain http:// on a host that isn't this device. Use it only if your server is really set up with it."
msgstr "Este origen de passkey usa http:// sin cifrar en un host que no es este dispositivo. Úsalo solo si tu servidor está realmente configurado así."

msgctxt "CleartextNotice"
msgid "Send it unencrypted anyway"
msgstr "Enviar sin cifrar de todos modos"

msgctxt "AppWindow"
msgid "Too many requests. Try again in about {} s."
msgstr "Demasiadas solicitudes. Inténtalo de nuevo en unos {} s."

msgctxt "AppWindow"
msgid "Disconnected. Reconnecting in {} s… ({})"
msgstr "Desconectado. Reconectando en {} s… ({})"

msgctxt "AppWindow"
msgid "Reconnecting in {} s… ({})"
msgstr "Reconectando en {} s… ({})"

msgctxt "AppWindow"
msgid "Shrink videos before sending"
msgstr "Reducir los vídeos antes de enviarlos"

msgctxt "AppWindow"
msgid "Not available in this build."
msgstr "No disponible en esta versión."

msgctxt "AppWindow"
msgid "Shrinking {}…"
msgstr "Reduciendo {}…"

msgctxt "AppWindow"
msgid "Video shrinking isn't available in this build, so {} was not sent."
msgstr "La reducción de vídeos no está disponible en esta versión; {} no se envió."

msgctxt "AppWindow"
msgid "Couldn't shrink {}, so it was not sent."
msgstr "No se pudo reducir {}; no se envió."

msgctxt "AppWindow"
msgid "Shrinking didn't make {} smaller, so it was not sent."
msgstr "Reducir {} no lo hizo más pequeño; no se envió."

msgctxt "AppWindow"
msgid "{} is still larger than the server allows after shrinking, so it was not sent."
msgstr "Aun reducido, {} supera el límite del servidor; no se envió."
