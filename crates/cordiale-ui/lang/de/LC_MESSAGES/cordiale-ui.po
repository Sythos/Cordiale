msgctxt "AppWindow"
msgid "Not available yet — this section needs Grappa REST/WS endpoints Cordiale doesn't implement yet."
msgstr "Noch nicht verfügbar: Dieser Bereich benötigt REST-/WS-Endpunkte von Grappa, die Cordiale noch nicht implementiert."

msgctxt "AppWindow"
msgid "Admin tools aren't built yet. Cordiale only knows you're an admin (via the account's subject data); it doesn't yet expose any of the admin-only surfaces."
msgstr "Die Admin-Tools sind noch nicht fertig. Cordiale weiß nur, dass du Admin bist (anhand der Account-Daten), zeigt aber noch keine der Admin-Funktionen an."

msgctxt "AppWindow"
msgid "Signed in. {} network(s), {} channel(s)."
msgstr "Angemeldet. {} Netzwerk(e), {} Kanal/Kanäle."

msgctxt "AppWindow"
msgid "Wrong username or password/token."
msgstr "Benutzername oder Passwort/Token falsch."

msgctxt "AppWindow"
msgid "This account has two-factor authentication enabled. Sign in from a browser instead."
msgstr "Für diesen Account ist die Zwei-Faktor-Authentifizierung aktiviert. Melde dich stattdessen über den Browser an."

msgctxt "AppWindow"
msgid "Too many attempts. Wait a bit before trying again."
msgstr "Zu viele Versuche. Warte kurz, bevor du es erneut versuchst."

msgctxt "AppWindow"
msgid "Login failed."
msgstr "Anmeldung fehlgeschlagen."

msgctxt "AppWindow"
msgid "Signed in, but couldn't load account data."
msgstr "Anmeldung erfolgreich, aber die Kontodaten konnten nicht geladen werden."

msgctxt "AppWindow"
msgid "Couldn't reach the server. Check the URL and try again."
msgstr "Der Server konnte nicht erreicht werden. Überprüfe die URL und versuch es erneut."

msgctxt "AppWindow"
msgid "This server's protocol version ({}) is too old for Cordiale."
msgstr "Die Protokollversion dieses Servers ({}) ist zu alt für Cordiale."

msgctxt "AppWindow"
msgid "Couldn't send that message."
msgstr "Nachricht konnte nicht gesendet werden."

msgctxt "AppWindow"
msgid "Disconnected. Reconnecting…"
msgstr "Verbindung getrennt. Verbinde erneut…"

msgctxt "AppWindow"
msgid "Reconnecting…"
msgstr "Verbinde erneut…"
